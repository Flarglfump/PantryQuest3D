# Hardtack Caverns - an area of Pantry Quest 3D.
# Made by tools/areas/hardcaves.py: change that and run tools/make_all.py.
bronto_scene 1

entity
  Name
    text = "Game"
  Transform
    position = 0 0
  Script
    file = "scripts/game.bs"
    vars = "area = \"hardcaves\", area_name = \"Hardtack Caverns\", music = \"music/caverns.wav\", dungeon = \"hardcaves\", kill_y = -20"

