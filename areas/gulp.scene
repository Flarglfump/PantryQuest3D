# Inside Lord Gulp - an area of Pantry Quest 3D.
# Made by tools/areas/gulp.py: change that and run tools/make_all.py.
bronto_scene 1

entity
  Name
    text = "Game"
  Transform
    position = 0 0
  Script
    file = "scripts/game.bs"
    vars = "area = \"gulp\", area_name = \"Inside Lord Gulp\", music = \"music/gulp.wav\", dungeon = \"gulp\", kill_y = -20"

entity
  Name
    text = "Story"
  Transform
    position = 0 0
