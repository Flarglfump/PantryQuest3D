entity
  Name
    text = "Raider"
  Transform3D
    position = -12 0 -18
    rotation = 0 -90 0
    scale = 1 1 1
  Mesh
    shape = model
    file = "models/raider.glb"
    color = #ffffffff
    uv_scale = 1 1
    shadow = true
  Animator
    clip = "walk"
    speed = 1
    loop = true
    playing = true
    blend = 0.2
  Collider3D
    shape = capsule
    size = 1 1.5 1
    radius = 0.35
    friction = 0.8
    offset = 0 0.75 0
  Tags
    list = "npc"
  Script
    file = "scripts/guard.bs"
    vars = "path = [vec3(-12, 0, -18), vec3(12, 0, -18)], speed = 1.8, wait = 1.4, say = \"raider_caught\""

