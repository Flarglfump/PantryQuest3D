# Fizzwater Fountain - an area of Pantry Quest 3D.
# Made by tools/areas/fountain.py: change that and run tools/make_all.py.
bronto_scene 1

entity
  Name
    text = "Game"
  Transform
    position = 0 0
  Script
    file = "scripts/game.bs"
    vars = "area = \"fountain\", area_name = \"Fizzwater Fountain\", music = \"music/fizz.wav\", dungeon = \"\", kill_y = -20"

entity
