# Peppermill Village - an area of Pantry Quest 3D.
# Made by tools/areas/peppermill.py: change that and run tools/make_all.py.
bronto_scene 1

entity
  Name
    text = "Game"
  Transform
    position = 0 0
  Script
    file = "scripts/game.bs"
    vars = "area = \"peppermill\", area_name = \"Peppermill Village\", music = \"music/peppermill.wav\", dungeon = \"\", kill_y = -20"

entity
  Name
    text = "Story"
