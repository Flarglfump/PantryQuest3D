# Breadbasket Fields - an area of Pantry Quest 3D.
# Made by tools/areas/fields.py: change that and run tools/make_all.py.
bronto_scene 1

entity
  Name
    text = "Game"
  Transform
    position = 0 0
  Script
    file = "scripts/game.bs"
    vars = "area = \"fields\", area_name = \"Breadbasket Fields\", music = \"music/fields.wav\", dungeon = \"\", kill_y = -20"

entity
  Name
    text = "Story"
