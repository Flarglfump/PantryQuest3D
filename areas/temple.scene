# Temple of the First Hearth - an area of Pantry Quest 3D.
# Made by tools/areas/temple.py: change that and run tools/make_all.py.
bronto_scene 1

entity
  Name
    text = "Game"
  Transform
    position = 0 0
  Script
    file = "scripts/game.bs"
    vars = "area = \"temple\", area_name = \"Temple of the First Hearth\", music = \"\", dungeon = \"\", kill_y = -20"

entity
  Name
    text = "Story"
  Transform
    position = 0 0
  Script
    file = "scripts/story.bs"

entity
  Name
    text = "Sun"
  Transform3D
    position = 0 30 0
    rotation = -75 20 0
    scale = 1 1 1
  Light
    kind = directional
    color = #ffe0a0ff
    intensity = 0.5
    shadows = false
    shadow_range = 14

entity
  Name
    text = "Sky Light"
  Transform3D
    position = 0 30 0
    rotation = 0 0 0
    scale = 1 1 1
  Light
    kind = ambient
    color = #c0a880ff
    intensity = 0.6

entity
  Name
    text = "Camera"
  Transform3D
    position = 0 3 6
    rotation = 0 0 0
    scale = 1 1 1
  Camera3D
    fov = 62
    near_clip = 0.15
    far_clip = 66
    clear_color = #100c08ff
    fog = true
    fog_color = #1a140cff
    fog_start = 26
    fog_end = 64
  Script
    file = "scripts/camera.bs"

entity
  Name
    text = "Sprig"
  Transform3D
    position = 0 0.1 0
    rotation = 0 0 0
    scale = 1 1 1
  Collider3D
    shape = capsule
    size = 1 1.1 1
    radius = 0.28
    friction = 0
    offset = 0 0.55 0
  RigidBody3D
    type = kinematic
  Tags
    list = "player"
  Script
    file = "scripts/sprig.bs"

entity
  Name
    text = "Flicker"
  Transform3D
    position = 0 1.5 0
    rotation = 0 0 0
    scale = 0.16 0.16 0.16
  Mesh
    shape = sphere
    color = #9ad8ffff
    uv_scale = 1 1
    lit = false
    cast_shadow = false
  Particles
    rate = 14
    max = 30
    lifetime = 0.5
    lifetime_random = 0.3
    speed = 0.4
    spread = 180
    size_start = 0.09
    size_end = 0
    color_start = #d0f0ffff
    color_end = #60a0ff00
