# Castle Ruins - an area of Pantry Quest 3D.
# Made by tools/areas/ruins.py: change that and run tools/make_all.py.
bronto_scene 1

entity
  Name
    text = "Game"
  Transform
    position = 0 0
  Script
    file = "scripts/game.bs"
    vars = "area = \"ruins\", area_name = \"Castle Ruins\", music = \"music/boss.wav\", dungeon = \"\", kill_y = -20"

entity
  Name
    text = "Story"
  Transform
    position = 0 0
  Script
    file = "scripts/story.bs"

entity
  Name
    text = "Sun"
  Transform3D
    position = 0 30 0
    rotation = -55 -35 0
    scale = 1 1 1
  Light
    kind = directional
    color = #ffa080ff
    intensity = 0.4
    shadows = false
    shadow_range = 14

entity
  Name
    text = "Sky Light"
  Transform3D
    position = 0 30 0
    rotation = 0 0 0
    scale = 1 1 1
  Light
    kind = ambient
    color = #a07070ff
    intensity = 0.6

entity
  Name
    text = "Camera"
  Transform3D
    position = 0 3 6
    rotation = 0 0 0
    scale = 1 1 1
  Camera3D
    fov = 62
    near_clip = 0.15
    far_clip = 97
    clear_color = #100808ff
    fog = true
    fog_color = #201010ff
    fog_start = 40
    fog_end = 95
  Script
    file = "scripts/camera.bs"

entity
  Name
    text = "Sprig"
  Transform3D
    position = 0 0.1 0
    rotation = 0 0 0
    scale = 1 1 1
  Collider3D
    shape = capsule
    size = 1 1.1 1
    radius = 0.28
    friction = 0
    offset = 0 0.55 0
  RigidBody3D
    type = kinematic
  Tags
    list = "player"
  Script
    file = "scripts/sprig.bs"

entity
  Name
    text = "Flicker"
  Transform3D
    position = 0 1.5 0
    rotation = 0 0 0
    scale = 0.16 0.16 0.16
  Mesh
    shape = sphere
    color = #9ad8ffff
    uv_scale = 1 1
    lit = false
    cast_shadow = false
  Particles
    rate = 14
    max = 30
    lifetime = 0.5
    lifetime_random = 0.3
    speed = 0.4
    spread = 180
    size_start = 0.09
    size_end = 0
    color_start = #d0f0ffff
    color_end = #60a0ff00
    blend = add
  Script
    file = "scripts/flicker.bs"

entity
  Name
    text = "HUD"
  Transform
    position = 0 0
  Script
    file = "scripts/hud.bs"

entity
  Name
    text = "Embers"
  Transform3D
    position = 0 2 0
    rotation = 0 0 0
    scale = 1 1 1
  Particles
    rate = 10
    max = 60
    lifetime = 3
    speed = 1
    spread = 90
    area = 36 36
    gravity = -0.3
    size_start = 0.12
    size_end = 0
    color_start = #ff8040ff
    color_end = #ff200000
    blend = add

entity
  Name
    text = "spawn_start"
  Transform3D
    position = 0 0.1 15
    rotation = 0 0 0
    scale = 1 1 1

entity
  Name
    text = "Gorgemold"
  Transform3D
    position = 0 0 -4
    rotation = 0 0 0
    scale = 3.2 3.2 3.2
  Mesh
    shape = model
    file = "models/mildew.glb"
    color = #506040ff
    uv_scale = 1 1
    shadow = true
  Animator
    clip = "idle"
    speed = 1
    loop = true
    playing = true
    blend = 0.2
  Collider3D
    shape = capsule
    size = 1 2 1
    radius = 0.5
    friction = 0.8
    offset = 0 1 0
  RigidBody3D
    type = kinematic
  Tags
    list = "enemy, focusable, boss"
  Script
    file = "scripts/gorgemold.bs"

entity
  Name
    text = "Saffron"
  Transform3D
    position = -10 -0.2248 10
    rotation = 0 -130 0
    scale = 1.3 1.3 1.3
  Mesh
    shape = model
    file = "models/saffron.glb"
    color = #ffffffff
    uv_scale = 1 1
  Animator
    clip = "idle"
    speed = 1
    loop = true
    playing = true
    blend = 0.2

