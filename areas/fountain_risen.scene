# Fizzwater Fountain - an area of Pantry Quest 3D.
# Made by tools/areas/fountain.py: change that and run tools/make_all.py.
bronto_scene 1

entity
  Name
    text = "Game"
  Transform
    position = 0 0
  Script
    file = "scripts/game.bs"
    vars = "area = \"fountain\", area_name = \"Fizzwater Fountain\", music = \"music/castle.wav\", dungeon = \"\", kill_y = -20"

entity
  Name
    text = "Story"
  Transform
    position = 0 0
  Script
    file = "scripts/story.bs"

entity
  Name
    text = "Sun"
  Transform3D
    position = 0 30 0
    rotation = -55 -35 0
    scale = 1 1 1
  Light
    kind = directional
    color = #fff2dcff
    intensity = 0.95
    shadows = false
    shadow_range = 14

entity
  Name
    text = "Sky Light"
  Transform3D
    position = 0 30 0
    rotation = 0 0 0
    scale = 1 1 1
  Light
    kind = ambient
    color = #c0d0e0ff
    intensity = 0.7

entity
  Name
    text = "Camera"
  Transform3D
    position = 0 3 6
    rotation = 0 0 0
    scale = 1 1 1
