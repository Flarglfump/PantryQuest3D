bronto_scene 1

entity
  Name
    text = "Boomerang"
  Transform3D
    position = 0 0 0
    rotation = 0 0 0
    scale = 1 1 1
  Mesh
    shape = model
    file = "models/spatula.obj"
    color = #d0c0a0ff
    uv_scale = 1 1
    cull = false
    cast_shadow = false
  Script
    file = "scripts/boomerang.bs"
