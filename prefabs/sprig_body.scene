# Sprig's body: the skinned model (sprig.bs turns, rolls and spins it).
# Made by tools/make_prefabs.py.
bronto_scene 1

entity
  Name
    text = "SprigBody"
  Transform3D
    position = 0 0 0
    rotation = 0 0 0
    scale = 1 1 1
  Mesh
    shape = model
    file = "models/sprig.glb"
    color = #ffffffff
    uv_scale = 1 1
    shadow = true
  Animator
    clip = "idle"
    speed = 1
    loop = true
    playing = true
    blend = 0.12
