@strict @3d
# switchdoor.bs - a door (bars, a fleshy curtain, planks) that rolls up into its lintel while
# the flag `when` is set and comes down again when it isn't (a floor switch held down). It
# shrinks upward rather than sliding up, so it never pokes into the wall above the doorway.
# With `stay`, once open it stays open.

var when: string = ""
var stay: bool = false
var game: entity
var top_y: number = 0                  # its top edge (where it rolls up to)
var full_h: number = 1
var up: number = 0
var latched: bool = false

func start() -> void {
    game = find("Game")
    full_h = self.scale.y
    top_y = self.y + full_h / 2
    if stay and game.flag(when) {
        latched = true
        up = 1
    }
    place()
}

func place() -> void {
    var h: number = max(0.02, full_h * (1 - up))
    self.scale = vec3(self.scale.x, h, self.scale.z)
    self.y = top_y - h / 2
    self.Mesh.visible = up < 0.99
}

func update(dt: number) -> void {
    var want: number = 0
    if latched or game.flag(when) { want = 1 }
    if stay and game.flag(when) { latched = true }
    var was: number = up
    if up < want { up = min(1, up + dt * 1.5) }
    if up > want { up = max(0, up - dt * 8) }      # (it drops shut fast: no slipping under it as it comes down)
    if up != was { place() }
}
