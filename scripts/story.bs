@strict
# story.bs - every word anyone says, the names of things, Flicker's hints, and what
# happens after a talk. The Story entity in each area runs it; the Game asks it for talks
# by id. A talk is a list of pages: [speaker, text, choices, icon] - choices a list of
# strings (the box asks), icon an item's picture ("" for none). '|' starts a new line.

var game: entity

func start() -> void { game = find("Game") }

func p(who: string, text: string) -> list { return [who, text, [], ""] }
func ask(who: string, text: string, choices: list) -> list { return [who, text, choices, ""] }

# ---- the talks ----
func talk(id: string) -> list {
    if game == nil { game = find("Game") }
    # ---- Sprouthollow: waking up
    if id == "intro" {
        return [p("???", "Sprig... SPRIG! Wake up!"),
                p("???", "Honestly. The Great Mother Starter herself sends me to fetch you, and you're SNORING."),
                p("FLICKER", "I'm Flicker. A pilot light. YOUR pilot light, from today - Mother Starter says so."),
                p("FLICKER", "Every Sprout in Sprouthollow has one, and now you do too. Lucky you!"),
                p("FLICKER", "Now get up! Mother Starter wants to see you. She's in her grove, north of the village."),
                p("FLICKER", "If you get stuck, press {flicker} and I'll tell you what to do. I'm very wise.")]
    }
    if id == "flicker" { return [p("FLICKER", hint())] }

    # ---- the Sprouts
    if id == "fennel_1" {
        return [p("FENNEL", "Sprig! You've got a pilot light! Finally!"),
                p("FENNEL", "Mother Starter sent her? Then it must be important. She's been so quiet lately... her bubbles have gone all grey."),
                p("FENNEL", "Chive won't let anyone up the grove path without a spoon and a shield, though. He thinks he's the boss.")]
    }
    if id == "fennel_2" {
        if game.flag("crock_done") {
            return [p("FENNEL", "Mother Starter is so quiet... Sprig, what happened in there?")]
        }
        return [p("FENNEL", "I heard there's a spoon hidden in the Kitchen Garden, past the hole in the hedge. Mind the rolling peas!")]
    }
    if id == "chive_block" {
        return [p("CHIVE", "Hey! Mr. No-Light! Oh... you've got a pilot light now? Big deal."),
                p("CHIVE", "Nobody goes to see the Great Mother Starter without a SPOON and a SHIELD. Them's the rules."),
                p("CHIVE", "Come back when you look like a proper Sprout. Hmph!")]
    }
    if id == "chive_half" {
        return [p("CHIVE", "Is that all you've got? I said a spoon AND a shield. Both! Hmph!")]
    }
    if id == "chive_move" {
        return [p("CHIVE", "What?! A spoon AND a Pot-Lid Shield?"),
                p("CHIVE", "...Fine. Go on, then. But I don't see why Mother Starter would want YOU. Hmph!")]
    }
    if id == "chive_after" { return [p("CHIVE", "Hmph. Mother Starter picked you. I still don't get it.")] }
    if id == "chive_sorry" {
        return [p("CHIVE", "Sprig... Mother Starter... she's gone quiet, isn't she."),
                p("CHIVE", "I was mean to you. I'm... sorry. Hmph. There. I said it.")]
    }
    if id == "mint" {
        return [p("MINT", "Did you know? If you hold {focus}, your pilot light will FOCUS on things, so you can talk to them from far away!"),
                p("DILL", "And enemies! Focus on enemies and you'll face them while you fight. Mint learned that from a sign."),
                p("MINT", "Dill!")]
    }
    if id == "dill" {
        return [p("DILL", "Roll by pressing {action} while you run! You can bonk things off trees. Sometimes beans fall out!")]
    }
    if id == "parsley" {
        return [p("PARSLEY", "Ahem. I, Parsley, Know-It-All of Sprouthollow, shall educate you."),
                p("PARSLEY", "Hold {attack} after a swing and let go for a SPIN ATTACK. It hits everything around you."),
                p("PARSLEY", "While focusing, press {action} to hop to the side, or back-flip. Forward + {action} with a spoon is a JUMP ATTACK."),
                p("PARSLEY", "There. You're welcome.")]
    }
    if id == "sage_shop" {
        var options: list = []
        if not game.has_item("potlid") { push(options, "Pot-Lid Shield - 40 beans") }
        if game.has_item("shooter") { push(options, "10 peas - 10 beans") }
        push(options, "Just looking")
        return [p("SAGE", "Welcome to Sage's, the only shop in Sprouthollow! You have " + game.beans + " beans."),
                ask("SAGE", "What'll it be?", options)]
    }
    if id == "sage_poor" { return [p("SAGE", "Ah... you don't have enough beans, dear. Cut the grass and smash the pots - beans turn up everywhere!")] }
    if id == "sage_bye" { return [p("SAGE", "Come again!")] }
    if id == "sage_full" { return [p("SAGE", "Your pea pouch is already full, dear.")] }

    # ---- signs
    if id == "sign_house" { return [p("", "SPRIG'S HOUSE|(the only Sprout without a pilot light)")] }
    if id == "sign_shop" { return [p("", "SAGE'S SHOP|Shields, peas, and sundries.")] }
    if id == "sign_garden" { return [p("", "THE KITCHEN GARDEN|Beware of rolling peas! Crawl through the hedge to enter.")] }
    if id == "sign_field" { return [p("", "TRAINING FIELD|Swing at the dummies with {attack}. Hold {focus} to focus on one first!")] }
    if id == "sign_grove" { return [p("", "THE GROVE OF MOTHER STARTER|Sprouts with spoons and shields only. -Chive")] }
    if id == "sign_bridge" { return [p("", "SOUTH: BREADBASKET FIELDS|Sprouts who leave the hollow never come back. (Probably.)")] }
    if id == "sign_roll" { return [p("", "TIP: Press {action} while running to roll. Rolling into a tree may shake something loose!")] }
    if id == "sign_spin" { return [p("", "TIP: Hold {attack}, then let go for a spin attack. Great for cutting grass!")] }

    # ---- Mother Starter
    if id == "starter_first" {
        return [p("MOTHER STARTER", "Ahh... Flicker. You have brought him. Thank you."),
                p("MOTHER STARTER", "Sprig... listen to an old starter. I have fed this village for four hundred years. But now..."),
                p("MOTHER STARTER", "A wicked one from the Rotlands has cursed me. A mould has crept into my crock, and laid something within..."),
                p("MOTHER STARTER", "I can feel it, feeding on me. Soon I will be nothing but grey."),
                p("MOTHER STARTER", "Sprig. You have the courage of your kind. Will you go inside me, and break this curse?"),
                p("FLICKER", "Inside?! Like... INSIDE inside?"),
                p("MOTHER STARTER", "Enter, brave one... and you too, Flicker.")]
    }
    if id == "starter_wait" { return [p("MOTHER STARTER", "Enter, Sprig... the curse grows within me...")] }
    if id == "starter_farewell" {
        return [p("MOTHER STARTER", "You did it, Sprig... the mite is gone. I can feel my bubbles... but it is too late for me."),
                p("MOTHER STARTER", "Listen. You are not a Sprout. You never needed a pilot light, because you are a HUMAN child."),
                p("MOTHER STARTER", "Long ago, in a war, a mother brought you to my grove and asked me to keep you safe. Then she was gone."),
                p("MOTHER STARTER", "The one who cursed me is a Duke from the Rotlands. A man of mould. He wanted this..."),
                p("MOTHER STARTER", "The EMBER OF COURAGE. One of the three Embers of the First Hearth. I would not give it to him."),
                p("MOTHER STARTER", "Take it to Castle Larder. Find the princess there. She... will know..."),
                p("MOTHER STARTER", "Goodbye, Sprig. Goodbye, Flicker. Look after... one... another...")]
    }
    if id == "starter_gone" { return [p("FLICKER", "...She's sleeping, Sprig. Come on. We have to go to the castle.")] }

    # ---- leaving
    if id == "fennel_bridge" {
        return [p("FENNEL", "You're leaving, aren't you? I always knew you would."),
                p("FENNEL", "It's okay. We'll always be friends, whatever you are. Here - take my reed pipe."),
                p("FENNEL", "Play it and think of me, okay?")]
    }
    if id == "fennel_stop" {
        if game.flag("starter_open") {
            return [p("FENNEL", "Sprig, Mother Starter opened her mouth for you! Whatever's inside her, you can't just walk away now.")]
        }
        return [p("FENNEL", "Whoa, where are you going? Nobody leaves Sprouthollow without Mother Starter's say-so."),
                p("FENNEL", "Go and see her - the grove's at the north end of the village. Chive's guarding the path.")]
    }
    if id == "sprout_exit_block" {
        return [p("FLICKER", "Sprig, wait! Mother Starter wants to see you first. Her grove is at the north end of the village!")]
    }
    # ---- Breadbasket Fields
    if id == "owl_fields" {
        return [p("???", "Hoo hoot! Sprig... look up here!"),
                p("SIR HOOTENANNY", "I am Sir Hootenanny, a crust-owl of some distinction. I have been waiting for you, young sprout."),
                p("SIR HOOTENANNY", "This is BREADBASKET FIELDS, the heart of the Pantry Kingdom. Every road in the land leads through here."),
                p("SIR HOOTENANNY", "To the NORTH is Larder Town, and Castle Larder above it. The princess lives there... but you knew that, didn't you? Hoo hoo."),
                p("SIR HOOTENANNY", "Mind the time! When the sun goes down, the town gate closes, and STALEBIES rise out of the field. Nasty, crumbly things."),
                p("SIR HOOTENANNY", "Did you get all that? I'm sure you did. Hoo hoot! Off you go!")]
    }
    if id == "basil_shop" {
        var options: list = []
        if not game.flag("bought_slice") { push(options, "Pie Slice - 99 beans") }
        if game.has_item("shooter") { push(options, "10 peas - 10 beans") }
        push(options, "Just looking")
        return [p("BASIL", "Hey there, little sprout! I'm Basil. Once upon a time I saved a whole castle full of cheese, but these days I cook."),
                p("BASIL", "Basil's Travelling Kitchen! Fresh from my cart, for the hungry adventurer. You have " + game.beans + " beans."),
                ask("BASIL", "What can I get you?", options)]
    }
    if id == "basil_poor" { return [p("BASIL", "Not enough beans, I'm afraid. Pots and grass, little sprout. Pots and grass.")] }
    if id == "basil_bye" { return [p("BASIL", "Come back hungry!")] }
    if id == "sign_fields" { return [p("", "BREADBASKET FIELDS|N: Larder Town   E: Buttercup Dairy   S: Sprouthollow")] }
    if id == "sign_dairy" { return [p("", "BUTTERCUP DAIRY|Fresh milk, cream and Custard the pudding-pony!")] }
    if id == "sign_lake" { return [p("", "WEST: LAKE BRINE|Fishing and the Fish Lab.")] }
    if id == "sign_peppermill" { return [p("", "NORTH-EAST: PEPPERMILL VILLAGE|and Mount Fondue beyond.")] }
    if id == "gate_shut" { return [p("FLICKER", "The gate is shut for the night! We'll have to wait for morning... or go and see what's out in the field.")] }
    if id == "tbc_town" {
        return [p("FLICKER", "Larder Town! The castle's up there... but this part of the kingdom is still being built."),
                p("FLICKER", "(Pantry Quest 3D continues here soon. Thanks for playing!)")]
    }
    if id == "tbc_dairy" { return [p("FLICKER", "Buttercup Dairy is up that hill. It isn't open yet... come back in a later version!")] }
    if id == "tbc_lake" { return [p("FLICKER", "The road to Lake Brine. Not finished yet - let's head north to the castle!")] }
    if id == "tbc_peppermill" { return [p("FLICKER", "Peppermill Village is this way, under the mountain. It isn't built yet!")] }
    if id == "tbc_thicket" { return [p("FLICKER", "The Thicket of Thyme is through there. Fennel says it's easy to get lost... Not today!")] }
    # ---- Larder Town
    if id == "sign_town" { return [p("", "LARDER TOWN|Royal capital of the Pantry Kingdom. Castle Larder: north.")] }
    if id == "sign_castle" { return [p("", "CASTLE LARDER|Visitors by appointment only. Trespassers will be peeled.")] }
    if id == "sign_kitchens" { return [p("", "THE ROYAL KITCHENS|Head Chef: Pip. Please knock. Please don't knock too hard.")] }
    if id == "temple_door" {
        if game.flag("met_saffron") { return [p("", "The Temple of the First Hearth. A great door, carved with three flames and a kettle. It won't move.")] }
        return [p("", "The Temple of the First Hearth. The door is sealed with three empty hollows, each shaped like a flame.")]
    }
    if id == "pip_1" {
        return [p("PIP", "Well now! A Sprout, out of the hollow? I haven't seen one of you in years."),
                p("PIP", "I'm Pip, head chef of the castle. When I was your size I chased Baron Gorge across the whole kingdom with a wooden spoon. Just like that one!"),
                p("PIP", "Want to see the princess? Ha! The guards won't let a dog in, let alone a Sprout. Though... they do walk the garden in very regular lines."),
                p("PIP", "Stay out of their sight and you might just make it. You didn't hear it from me.")]
    }
    if id == "pip_2" {
        return [p("PIP", "Saffron's Lullaby? Then the princess trusts you. So do I."),
                p("PIP", "Peppermill Village is north-east of the field, under Mount Fondue. Mind the Hardtack - they hug hard.")]
    }
    if id == "guard_1" { return [p("GUARD", "Halt! The castle is closed to Sprouts, children, and Sprout children. Move along.")] }
    if id == "guard_2" { return [p("GUARD", "You again! How did you... never mind. Move along.")] }
    if id == "baker" {
        return [p("BAKER", "Fresh loaves! Fresh... ah, it's no use. Everything I bake goes stale by noon now."),
                p("BAKER", "Ever since that grey Duke came to see the king. Mildew, they call him. Brrr.")]
    }
    if id == "townswoman" { return [p("GREENGROCER", "The finest pears in the kingdom! Well... they were. They keep going soft. Strange times.")] }
    if id == "townsman" {
        return [p("TOWNSMAN", "Did you see the Duke's carriage? All grey, with mushrooms growing on the wheels."),
                p("TOWNSMAN", "And the King just smiled and served him soup. The King serves everyone soup.")]
    }
    if id == "gossip" { return [p("GOSSIP", "They say the princess dreams things before they happen. They say she dreamed of a boy in green. Hmm! Green like YOU.")] }
    if id == "child" { return [p("TOWN KID", "Is that a real pilot light? Can I touch it? Ow! It's HOT!"), p("FLICKER", "Serves you right.")] }

    # ---- the castle garden
    if id == "guard_caught" {
        return [p("GUARD", "HEY! You there! How did a Sprout get into the royal garden?"),
                p("GUARD", "Out you go, and stay out!")]
    }
    if id == "saffron_meet" {
        return [p("???", "Who... who are you? How did you get past the guards?"),
                p("???", "A pilot light! Then... you come from the hollow. From the great sourdough!"),
                p("SAFFRON", "I'm Saffron, princess of the Pantry Kingdom. Every night I dream the same dream..."),
                p("SAFFRON", "Grey clouds cover the land. Then a boy in green comes out of the forest, holding a flame. That's you, isn't it?"),
                p("SAFFRON", "Look through the window - the man in grey, bowing to my father. That's Duke Mildew, from the Rotlands."),
                p("SAFFRON", "He wants the HEARTHFLAME: the three Embers of the First Hearth. Whoever holds all three can cook the whole world into anything they wish."),
                p("SAFFRON", "You have the Ember of Courage. We must find the other two before he does: the Ember of Power, kept by the Hardtack Clan on Mount Fondue..."),
                p("SAFFRON", "...and the Ember of Wisdom, kept by the Fizzlings of Fizzwater Falls. Then we can open the Door of Seasons, and keep the Hearthflame safe."),
                p("SAFFRON", "Take this letter. It will get you past anyone who serves my family. Please, Sprig... I'm counting on you.")]
    }
    if id == "kimchi_song" {
        return [p("NANNY KIMCHI", "So. You're the boy from Her Highness's dreams. Small, aren't you."),
                p("NANNY KIMCHI", "I am Kimchi, her nurse. I have sung her to sleep since she was a baby, with a song the royal family has always known."),
                p("NANNY KIMCHI", "Listen well. It is called SAFFRON'S LULLABY. Royal doors and old magic will answer it."),
                p("NANNY KIMCHI", "Now come. I'll see you out before the guards see you in.")]
    }
    # ---- Peppermill Village
    if id == "sign_pepper" { return [p("", "PEPPERMILL VILLAGE|Home of the finest pepper in the kingdom. N: Mount Fondue trail.")] }
    if id == "sign_well" { return [p("", "The old well has run dry. Something glints far below... but it's too deep to climb.")] }
    if id == "sign_grave" { return [p("", "PEPPERMILL GRAVEYARD|Here lie those who were ground fine. Please keep off the graves.")] }
    if id == "sign_potions" { return [p("", "OLD GINGER'S POTIONS|Closed until the mushrooms are back in season.")] }
    if id == "grave" { return [p("", "HERE LIES A GOOD PEPPERCORN.|He was always well seasoned.")] }
    if id == "miller" {
        return [p("MILLER", "The windmill turns, the pepper grinds. That's how it's been in Peppermill for three hundred years."),
                p("MILLER", "Lately the wind smells of mould, though. Coming down off the mountain, it is.")]
    }
    if id == "gravekeeper" {
        return [p("GRANDPA GRISTLE", "Heh heh. Come to dig, have you? Not today, young sprout. The ground's too hard."),
                p("GRANDPA GRISTLE", "Come back when you're older. Much older. Heh heh heh.")]
    }
    if id == "mtguard_no" {
        return [p("GUARD", "Halt! The Mount Fondue trail is closed by order of the King. The Hardtack have been in a foul mood, and the mountain's grumbling."),
                p("GUARD", "No one goes up without royal permission.")]
    }
    if id == "mtguard_letter" {
        return [p("GUARD", "What's that? A letter... from Princess Saffron herself? 'Please let this Sprout go wherever he likes.'"),
                p("GUARD", "Ha! Her Highness always did have a sense of humour. Very well, go on up. Mind the falling rocks!")]
    }
    if id == "mtguard_open" { return [p("GUARD", "Up the trail with you, then. The Hardtack City door is half way up.")] }

    # ---- Mount Fondue and the Hardtack
    if id == "sign_fondue" { return [p("", "MOUNT FONDUE TRAIL|Hardtack City ahead. Beware of falling cheese.")] }
    if id == "sign_caves" { return [p("", "HARDTACK CAVERNS|Hardtack food storage. Keep out! (signed: the Hardtack Clan)")] }
    if id == "boulder_caves" { return [p("FLICKER", "A huge boulder blocks the cave! If only we could blow it up... I wonder what those bulbs growing nearby are?")] }
    if id == "bombflower_no" { return [p("FLICKER", "Those are BOMB FLOWERS. Don't touch them! ...Well, you couldn't pull one off anyway. Not without something to grip with.")] }
    if id == "hardtack_1" {
        return [p("HARDTACK", "Hungry... so hungry... The Duke blocked our caverns. No more delicious rocks."),
                p("HARDTACK", "Big Biscotti is in his room, sulking. He won't open the door to anyone. Except maybe royalty.")]
    }
    if id == "hardtack_2" { return [p("HARDTACK", "You made Big Biscotti dance! Brother, you've got rhythm! Now clear our caverns!")] }
    if id == "biscotti_door" { return [p("", "BIG BISCOTTI'S ROOM. A royal crest is carved on the door: only a song of the royal family will open it.")] }
    if id == "biscotti_1" {
        return [p("BIG BISCOTTI", "WHAT?! Who dares disturb the Chief of the Hardtack Clan?!"),
                p("BIG BISCOTTI", "A Sprout?! With a letter from the princess... Bah! What does the royal family care? My people are STARVING!"),
                p("BIG BISCOTTI", "The Duke of Mildew wanted our treasure, the Ember of Power. I said no. So he filled Hardtack Caverns with monsters!"),
                p("BIG BISCOTTI", "Now no one can get at the rock roast. GO AWAY! I'm in a terrible mood. Nothing could cheer me up!")]
    }
    if id == "biscotti_dance" {
        return [p("BIG BISCOTTI", "...Hey. Hey hey HEY! That tune! It makes me want to..."),
                p("BIG BISCOTTI", "DANCE!! WOOO! I feel GREAT! Little brother, you've cheered me right up!"),
                p("BIG BISCOTTI", "Here. Take my GUM BRACELET. With it you can pull the bomb flowers that grow on the mountain."),
                p("BIG BISCOTTI", "Blow open the boulder at the caverns' mouth, and deal with whatever the Duke put in there!")]
    }
    if id == "biscotti_2" { return [p("BIG BISCOTTI", "The caverns are along the trail, past the bend! Blow the boulder with a bomb flower, brother!")] }
    if id == "biscotti_ember" {
        return [p("BIG BISCOTTI", "BROTHER!! You beat King Crustodon! The caverns are ours again! The rock roast is BACK!"),
                p("BIG BISCOTTI", "From today you are my Sworn Brother. And a brother should have this..."),
                p("BIG BISCOTTI", "The EMBER OF POWER! Our clan has guarded it since the First Hearth was lit. Keep it from the Duke!")]
    }
    if id == "biscotti_after" { return [p("BIG BISCOTTI", "Brother! Have some rock roast! ...No? Your loss! Go find the last Ember, brother. The Fizzlings have it, at Fizzwater Falls.")] }

    # ---- Hardtack Caverns
    if id == "hc_enter" {
        return [p("FLICKER", "Phew, it's HOT in here! The floor is molten cheese in places - don't fall in!"),
                p("FLICKER", "Those cracked walls look like a bomb would break them...")]
    }
    if id == "crustodon_title" { return [p("", "KING CRUSTODON|Infernal Crust Lizard")] }
    if id == "crustodon_beaten" { return [p("FLICKER", "You did it! The caverns are free! Step into the light - Big Biscotti will want to know!")] }
    if id == "tbc_summit" { return [p("FLICKER", "The crater's up there. It's way too hot to go up now... maybe later!")] }
    if id == "to_be_continued" {
        return [p("FLICKER", "Breadbasket Fields is out there... but the rest of the kingdom isn't finished yet!"),
                p("FLICKER", "(Thanks for playing this much of Pantry Quest 3D. More of the world is on its way.)")]
    }


    # ---- Brine Valley
    if id == "sign_brine" { return [p("", "BRINE VALLEY|North: Fizzwater Falls, home of the Fizzlings. South: Lake Brine.")] }
    if id == "falls_seal" {
        return [p("", "THE ROYAL SEAL OF THE FIZZLINGS.|The falls part for a song of the royal family."),
                p("FLICKER", "A song of the royal family... Sprig! Saffron's Lullaby!")]
    }
    if id == "frog" {
        if game.flag("gulp_done") { return [p("FROG", "Brrrup! You smell of sturgeon. Brrrup! Respect.")] }
        return [p("FROG", "Brrrup. We are the Brine Valley choir. Brrrup."),
                p("FROG", "Our conductor ran off to the lake. Brrrup. Ah well. Brrrup.")]
    }
    if id == "tbc_lake_temple" { return [p("FLICKER", "There's a door down there under the water... but it's shut tight. Maybe one day.")] }

    # ---- the Fizzling Domain
    if id == "fizz_enter" {
        return [p("FLICKER", "Wow... it's all bubbles! The Fizzlings live in here, behind the falls."),
                p("FLICKER", "Let's find the king. The Ember of Wisdom must be somewhere around here.")]
    }
    if id == "fizzling" {
        if game.flag("gulp_done") { return [p("FIZZLING", "The princess is back! Pop pop hooray! ...Ahem. Welcome, honoured guest.")] }
        return [p("FIZZLING", "Ssshh! The king is in a terrible mood. Princess Effervescia has gone missing!"),
                p("FIZZLING", "She was last seen at Lake Brine, swimming with her pet minnow. She's a fizzy one, our princess.")]
    }
    if id == "fizzling2" {
        return [p("FIZZLING", "Lord Gulp, the great sturgeon, guards our fountain. Lately he's been coughing up bubbles. Nasty ones."),
                p("FIZZLING", "He only eats fresh fish, you know. Served in a jar. He's very particular.")]
    }
    if id == "diver" {
        if game.has_item("fizzbubble") {
            return [ask("DIVER", "Again? Five stones, fifty seconds. For the fun of it!", ["Let's go", "No thanks"])]
        }
        return [p("DIVER", "You! Land-sprout! Can you dive? Bet you can't!"),
                ask("DIVER", "I'll drop five fizz-stones in the pool. Bring them all up in fifty seconds and you'll get a prize. Ready?", ["Let's go", "No thanks"])]
    }
    if id == "dive_won" {
        return [p("DIVER", "Wha-! All five! Not bad for a land-sprout!"),
                p("DIVER", "Here - the FIZZ BUBBLE. Hold it in your mouth and you'll go twice as deep.")]
    }
    if id == "dive_again" { return [p("DIVER", "All five again! You're half Fizzling, you are.")] }
    if id == "dive_lost" { return [p("DIVER", "Time's up! Bubble-brained! Talk to me if you want another go.")] }
    if id == "carb_1" {
        return [p("KING CARBONARIUS", "Hrmmph. A Sprout? With a pilot light? What does a Sprout want with the King of the Fizzlings?"),
                p("KING CARBONARIUS", "The Ember of Wisdom?! Do you think I care about embers when my daughter, my little Effervescia, is LOST?!"),
                p("KING CARBONARIUS", "She went out to Lake Brine and never came back. Find her, and maybe we'll talk. Now leave me to my sorrow. *gurgle*")]
    }
    if id == "carb_2" { return [p("KING CARBONARIUS", "*sniff* Effervescia... she loved Lake Brine so. South of the valley, Sprout. Find her! *gurgle*")] }
    if id == "carb_letter" {
        return [p("KING CARBONARIUS", "What's that? A letter... in a jar? That's Effervescia's writing!"),
                p("", "\"HELP! I'm inside Lord Gulp's tummy! Don't tell Daddy! --Fizzy\""),
                p("KING CARBONARIUS", "INSIDE LORD GULP?! The guardian has been acting strange since that Duke came round with a present for him..."),
                p("KING CARBONARIUS", "Go through to the fountain, Sprout. Lord Gulp eats only fish, served in a jar. Keep the jar. Find my daughter!"),
                p("", "King Carbonarius shuffled aside, very slowly.")]
    }
    if id == "carb_moved" { return [p("KING CARBONARIUS", "The fountain is through there. Lord Gulp eats fish, in a jar. Hurry, Sprout! *gurgle*")] }
    if id == "carb_thanks" {
        return [p("KING CARBONARIUS", "Effervescia is home! Sprout, you have the thanks of every Fizzling. *happy gurgle*"),
                p("KING CARBONARIUS", "...She says you're engaged now? Hrmmph. We'll talk about that later.")]
    }

    # ---- Lake Brine
    if id == "sign_lake" { return [p("", "LAKE BRINE|The great salt lake. Bathing at your own risk.")] }
    if id == "professor" {
        if game.flag("got:lake_jar") { return [p("PROFESSOR BRINEWORTH", "A letter in a jar! How marvellous! The currents bring all sorts of things to rest by the island.")] }
        return [p("PROFESSOR BRINEWORTH", "Hello there! I study the waters of Lake Brine. Fascinating stuff."),
                p("PROFESSOR BRINEWORTH", "I saw something glinting at the bottom near the island the other day. Too deep for me - I can't dive more than a whisker."),
                p("PROFESSOR BRINEWORTH", "The Fizzlings can dive ever so deep, of course. They have a trick with bubbles.")]
    }
    if id == "sign_fishing" { return [p("", "FISHING POND|Closed for repairs. Back soon! --The Pond Man")] }
    if id == "fizzy_letter" {
        return [p("", "There's a letter inside the jar. It smells of soda.|\"HELP! I'm inside Lord Gulp's tummy! Don't tell Daddy! --Fizzy\""),
                p("FLICKER", "Fizzy... Princess Effervescia! We should show this to King Carbonarius!")]
    }

    # ---- Fizzwater Fountain
    if id == "fountain_enter" { return [p("FLICKER", "The fountain! And that big shape out in the water... that must be Lord Gulp. He's HUGE.")] }
    if id == "gulp_look" {
        if game.flag("carb_moved") and not game.has_item("jar1") { return [p("FLICKER", "Lord Gulp is fast asleep... and his tummy is gurgling. Bad.")] }
        if game.flag("jar1_fish") { return [p("FLICKER", "Lord Gulp is snoring. Sprig, the fish! Use the jar on the altar, by Lord Gulp!")] }
        return [p("FLICKER", "Lord Gulp is snoring. The king said he eats fish from a jar... Catch one of the fish in the shallows! Swing the jar at it.")]
    }
    if id == "got_fish" { return [p("", "You caught a fish in your jar!|Use it again to let it go, or feed it to someone hungry.")] }
    if id == "gulp_fed" {
        return [p("", "SLUUURP!"),
                p("FLICKER", "He ate it! And he's... opening wide... SPRIG! He's going to-")]
    }
    if id == "fizzy_ember" {
        return [p("FIZZY", "There you are! My knight in shining... apron. Hmph. You took your time."),
                p("FIZZY", "You carried me all the way through Lord Gulp. Do you know what that means, among Fizzlings?"),
                p("FIZZY", "...It means we're ENGAGED. Don't argue. It's tradition."),
                p("FIZZY", "And a Fizzling princess gives her betrothed her most precious treasure. Here. The EMBER OF WISDOM. Mother gave it to me.")]
    }
    if id == "fizzy_after" { return [p("FIZZY", "Go on then, save the kingdom. And then come back. We have a wedding to plan!")] }

    # ---- inside Lord Gulp
    if id == "gulp_enter" {
        return [p("FLICKER", "Eww eww EWW! We're inside a FISH! It's all squishy!"),
                p("FLICKER", "The princess must be in here somewhere. And whatever's making Lord Gulp sick...")]
    }
    if id == "fizzy_meet" {
        return [p("PRINCESS FIZZY", "Who are YOU? Did Daddy send you? I TOLD him not to worry!"),
                p("PRINCESS FIZZY", "I'm not lost. I'm looking for my mother's stone, the one she gave me. Lord Gulp swallowed it when the Duke made him sick."),
                p("PRINCESS FIZZY", "You can help me look. But I am NOT walking on this squishy floor. You'll have to carry me."),
                p("FLICKER", "Press {action} near her to lift her up, and {action} or {attack} to set her down. She looks heavy enough to hold down a switch...")]
    }
    if id == "fizzy_wait" { return [p("PRINCESS FIZZY", "I'll wait here. Do hurry up, it smells in there.")] }
    if id == "gulp_sw_tip" { return [p("FLICKER", "A switch in the floor. The door only stays open while something's pressing it down...")] }
    if id == "gulp_tendril" { return [p("FLICKER", "That tendril is holding something up. A spoon won't reach that far... but something you could throw might.")] }
    if id == "knot_title" { return [p("", "THE GRISTLE KNOT|Indigestible Tangled Parasite")] }
    if id == "knot_beaten" { return [p("FLICKER", "Gross, but you did it! Lord Gulp's going to feel MUCH better. Step into the light!")] }


    # ---- the storm (Larder Town, three Embers)
    if id == "storm_1" {
        return [p("FLICKER", "Sprig... the sky's gone dark. And look - up the hill. The CASTLE is on FIRE!"),
                p("FLICKER", "Someone's coming down the castle road. Fast!")]
    }
    if id == "storm_saffron" {
        return [p("SAFFRON", "SPRIG! It's the Duke - he's taken the castle!"),
                p("SAFFRON", "I threw it in the moat - he mustn't have it! Find it, Sprig! Keep it safe!")]
    }
    if id == "storm_mildew" {
        return [p("???", "Hmm. A little sprout, out in the rain. With a pilot light, no less."),
                p("DUKE MILDEW", "Did you see a girl run by, little sprout? A girl with something that belongs to me?"),
                p("DUKE MILDEW", "...No? No matter. Everything rots in the end. Even princesses."),
                p("DUKE MILDEW", "Be a good sprout and stay out of the way. The Hearthflame will be mine either way.")]
    }
    if id == "storm_after" {
        return [p("FLICKER", "That was HIM. The Duke. The Mould... I've never felt so cold."),
                p("FLICKER", "Sprig - Saffron said she threw something into the moat. By the bridge, on the castle road. Dive for it!")]
    }
    if id == "saffron_vision" {
        return [p("", "As you hold the whistle, you hear the princess's voice..."),
                p("SAFFRON", "Sprig... If you hear this, I couldn't wait for you. The Duke came for the Embers."),
                p("SAFFRON", "Take the KETTLE WHISTLE to the Temple of the First Hearth. Stand before the Door of Seasons with the three Embers..."),
                p("SAFFRON", "...and play this song. The song of the royal family's time. Please, Sprig. Hurry.")]
    }
    if id == "temple_shut" { return [p("", "THE TEMPLE OF THE FIRST HEARTH|Its doors are always open to the hungry.")] }

    # ---- the Temple of the First Hearth
    if id == "temple_enter" {
        return [p("FLICKER", "So this is the Temple of the First Hearth... It's so quiet. Like a kitchen before dawn."),
                p("FLICKER", "That must be the Door of Seasons, behind the altar.")]
    }
    if id == "altar" {
        return [p("", "THE ALTAR OF EMBERS|\"Courage that makes it rise, Power that transforms, Wisdom that preserves.\""),
                p("", "\"Bring the three, and the song of time, and the Door of Seasons opens on the Pantry of Ages.\"")]
    }
    if id == "seasons_door" {
        if not (game.has_item("ember_courage") and game.has_item("ember_power") and game.has_item("ember_wisdom")) {
            return [p("", "THE DOOR OF SEASONS.|It is sealed fast. Three empty hollows wait beside it.")]
        }
        if not game.has_item("song_rising") { return [p("", "THE DOOR OF SEASONS.|The three Embers glow beside it. It seems to be waiting for a song.")] }
        return [p("FLICKER", "The Embers are glowing! Play the SONG OF RISING, Sprig!")]
    }
    if id == "cleaver_pull" {
        return [p("", "THE CLEAVER OF DAWN.|It rests in an ancient butcher's block, as if it was waiting for you."),
                ask("", "Pull the Cleaver of Dawn from the block?", ["Pull it", "Not yet"])]
    }
    if id == "mildew_thanks" {
        return [p("DUKE MILDEW", "Ahh. Thank you, little sprout. I could never have opened that door myself."),
                p("DUKE MILDEW", "The Pantry of Ages... and the Hearthflame, at last. Sleep well, little sprout."),
                p("FLICKER", "SPRIG! Sprig, what's happening to you?! SPRIG!")]
    }
    if id == "cleaver_again" { return [ask("", "Pull the Cleaver of Dawn, and rise seven years?", ["Pull it", "Not yet"])] }
    if id == "cleaver_return" { return [ask("", "Put the Cleaver of Dawn back, and return to your younger days?", ["Put it back", "Not yet"])] }

    # ---- the Proofing Vault
    if id == "mozz_1" {
        return [p("OLD MOZZ", "Ah. Awake at last. Don't try to stand too quickly, young man. You've been proofing a long while."),
                p("OLD MOZZ", "I am Mozz. Once a butler, in a castle of cheese, long ago. Now I keep the Vault, and the flavour of Umami."),
                p("OLD MOZZ", "The Cleaver of Dawn chose you, Sprig. But a child cannot carry it. So the Vault sealed you away... to rise."),
                p("OLD MOZZ", "Seven years, my boy. You have been asleep for SEVEN YEARS."),
                p("FLICKER", "Seven...?! Sprig! You're... you're so TALL!"),
                p("OLD MOZZ", "And while you slept, the Duke walked through the door you opened, and took the Hearthflame."),
                p("OLD MOZZ", "But it split in his hands. He kept only the Ember of Power. Courage stayed with you. And Wisdom... went elsewhere."),
                p("OLD MOZZ", "Mildew rules the kingdom now. Everything rots. To stand against him you must wake the five other Keepers of Flavour."),
                p("OLD MOZZ", "Take this. The UMAMI MEDALLION, my own. It will remind the others what they are.")]
    }
    if id == "mozz_2" { return [p("OLD MOZZ", "Five Keepers, in five temples, Sprig. Step into the light. The world outside has changed... be ready.")] }
    if id == "cinder" {
        return [p("???", "So. The Hero of Rising wakes at last."),
                p("CINDER", "I am Cinder. The last of the Sootfolk. I have waited a long time on these steps."),
                p("CINDER", "The first of the Keepers sleeps in the Thyme Temple, deep in the Thicket. A friend of yours, I think."),
                p("CINDER", "Learn this song. If you are ever lost, play it, and it will bring you back here, to the hearth."),
                p("", "Cinder played a warm, rising melody...")]
    }
    if id == "cinder_after" { return [p("CINDER", "The Thicket of Thyme, Hero. The forest remembers you. Go.")] }
    if id == "spire" { return [p("FLICKER", "That... that's where the castle was. It's all mould now. A tower of it.")] }
    if id == "tbc_risen" {
        return [p("FLICKER", "The Thicket of Thyme is that way... but the rest of the Risen world isn't finished yet!"),
                p("FLICKER", "(Thanks for playing this far! Seven years, the Cleaver of Dawn... the five temples are on their way.)")]
    }
    if id == "risen_townsfolk" { return [p("FLICKER", "Everyone's gone. The houses are all cold.")] }


    # ---- the Risen world
    if id == "ghost_race" {
        return [p("GRANDPA GRISTLE'S GHOST", "Heh heh heh... A young man, in MY graveyard? Seven years I've waited for a visitor."),
                p("GRANDPA GRISTLE'S GHOST", "Fancy a race, young man? Keep up with me round the village, and you can have my treasure. Heh heh!"),
                ask("GRANDPA GRISTLE'S GHOST", "Ready?", ["Go!", "Not now"])]
    }
    if id == "ghost_won" {
        return [p("GRANDPA GRISTLE'S GHOST", "Heh... heh... You're quick, young man. Quicker than I ever was."),
                p("GRANDPA GRISTLE'S GHOST", "A promise is a promise. Take my LICORICE LASH. I used it to pull myself up out of graves. Heh heh!")]
    }
    if id == "ghost_lost" { return [p("GRANDPA GRISTLE'S GHOST", "Heh heh heh! Too slow! Come and find me in the graveyard if you want another go!")] }
    if id == "ghost_after" { return [p("GRANDPA GRISTLE'S GHOST", "Heh heh. Use that lash well. Wooden things, young man... it bites into wooden things.")] }
    if id == "risen_miller" {
        return [p("MILLER", "You don't look like the Duke's sort. Seven years now the windmill's turned the wrong way, and it never rains."),
                p("MILLER", "They say the old gravekeeper still walks the graveyard at night. Race you, he would, if you asked.")]
    }
    if id == "risen_gate" { return [p("FLICKER", "The guard's gone... the trail up the mountain's open. Everything feels so empty.")] }
    if id == "sign_thicket" { return [p("", "THE THICKET OF THYME|Those who enter without a friend may never find the way out.")] }
    if id == "thicket_kid" {
        if game.era == "risen" { return [p("SPROUT", "...A big person? In the Thicket? You look like someone I used to know. He never came back.")] }
        return [p("SPROUT", "Sprig! You're going out in the world? Don't get lost in the Thicket like the big people do!")]
    }


    if id == "sign_temple_stair" { return [p("", "THE STAIR TO THE THYME TEMPLE.|It crumbled long ago. The Keepers' temple waits on the ledge above.")] }
    if id == "lash_target" { return [p("FLICKER", "A wooden target... something that bites into wood could pull you right over to it.")] }
    if id == "tt_enter" {
        return [p("FLICKER", "The Thyme Temple... It smells like Fennel's hair. Like the whole Thicket at once."),
                p("FLICKER", "Somewhere in here is the first Keeper. Let's find her.")]
    }
    if id == "tt_lift" {
        if game.flag("tt_flames") { return [p("FLICKER", "All three braziers are burning! Stand in the middle - the floor's going down!")] }
        return [p("", "THREE BRAZIERS, COLD.|\"When the sisters' lanterns burn here again, the way down will open.\"")]
    }
    if id == "sister_beaten" { return [p("FLICKER", "Her flame flew back to the hall! One more brazier burning!")] }
    if id == "duke_title" { return [p("", "THE HOLLOW DUKE|Mould-Puppet of the Moldering Spire")] }
    if id == "duke_beaten" { return [p("FLICKER", "It was only a puppet... the real Duke is still out there. But the temple's free! Step into the light!")] }
    if id == "fennel_keeper" {
        if game.flag("keeper_bitter") { return [p("FENNEL", "I'll always be here, Sprig. In every leaf of the Thicket. Go on - the other Keepers need you.")] }
        return [p("FENNEL", "Sprig...? Is that really you? You're so... tall."),
                p("FENNEL", "I'm a Keeper, Sprig. The Keeper of Bitter, it turns out. Herbs and leaves and the green taste of the Thicket."),
                p("FENNEL", "I always knew you weren't a Sprout, you know. Sprouts don't grow up. But you'll always be one of us."),
                p("FENNEL", "Take my medallion. And Sprig... when this is all over, come and play my tune for me. Promise?")]
    }
    if id == "cinder_minuet" {
        return [p("CINDER", "The Keeper of Bitter wakes. The Thicket breathes again."),
                p("CINDER", "Learn this. The MINUET OF THYME. It will carry you here, to the Glade, from anywhere under the sky."),
                p("CINDER", "The next Keeper sleeps in fire, under Mount Fondue. Your sworn brother's people need you, Hero.")]
    }


    # ---- the Fondue Forge arc
    if id == "little_biscotti" {
        if game.has_item("apron") { return [p("LITTLE BISCOTTI", "Go get 'em, big brother! Bring my dad back!")] }
        return [p("LITTLE BISCOTTI", "W-who's there?! ...You're not one of the Duke's? You smell like... my dad's Sworn Brother!"),
                p("LITTLE BISCOTTI", "The Duke's dragon came out of the crater. It took everyone to the Forge to feed it! Dad went after them and never came back."),
                p("LITTLE BISCOTTI", "You're going up there? Then take this! Dad's spare OVEN APRON. Without it you'd cook in a minute up there!")]
    }
    if id == "sign_forge" { return [p("", "THE CRATER OF MOUNT FONDUE.|The Fondue Forge burns below. The heat cooks the unprotected.")] }
    if id == "forge_enter" {
        if game.has_item("apron") { return [p("FLICKER", "Phew - good thing you've got that apron on! It's like the inside of an oven in here.")] }
        return [p("FLICKER", "It's SO hot! Sprig, we can't stay in here long - we need something to keep the heat off!")]
    }
    if id == "prisoner" {
        return [p("HARDTACK", "Brother?! Biscotti's Sworn Brother! The Duke's dragon locked us all in here to eat later!"),
                p("HARDTACK", "Big Biscotti went down to fight it... Don't worry about us. Find him! The big hammer's in the west room, guarded by crust golems.")]
    }
    if id == "prisoner2" { return [p("HARDTACK", "Brother! The Boss Key's on the far side of the cheese. That rusty switch moves the old bridge - give it a good WHACK!")] }
    if id == "gratinox_title" { return [p("", "GRATINOX|Broiling Dragon of the Crater")] }
    if id == "gratinox_beaten" { return [p("FLICKER", "The dragon's gone! Mount Fondue is safe! Step into the light, Sprig!")] }
    if id == "biscotti_keeper" {
        if game.flag("keeper_spice") { return [p("BIG BISCOTTI", "Go, brother! The others are waiting for you!")] }
        return [p("BIG BISCOTTI", "BROTHER!! Look at you, all grown up! And you beat that dragon! Ha HA!"),
                p("BIG BISCOTTI", "Turns out I'm a Keeper, brother. The Keeper of SPICE. The heat of the mountain, the fire in the rock roast!"),
                p("BIG BISCOTTI", "My people are free, and my boy is safe. Take my medallion, brother. And keep the apron. It suits you!")]
    }
    if id == "cinder_bolero" {
        return [p("CINDER", "The Keeper of Spice wakes. The mountain's fire is its own again."),
                p("CINDER", "This is the BOLERO OF EMBERS. Play it, and it will carry you here, to the crater's edge."),
                p("CINDER", "Three Keepers sleep still. The lake has frozen, Hero. The Fizzlings need you.")]
    }


    # ---- the frozen lake arc
    if id == "sign_freezer" { return [p("", "THE FREEZER CAVES.|Cold enough to keep anything forever. Even a grudge.")] }
    if id == "freezer_sign" { return [p("FLICKER", "Brr! That fire's BLUE. And cold! I bet you could carry some in a jar...")] }
    if id == "got_bluefire" { return [p("", "You caught some blue fire in your jar!|Use it on something that needs melting.")] }
    if id == "carb_frozen" { return [p("FLICKER", "King Carbonarius... frozen solid in red ice! Fire won't touch that... unless it's BLUE fire.")] }
    if id == "carb_thawed" {
        return [p("KING CARBONARIUS", "*gurgle* ...Brrr. Who - who thawed me? A grown Sprout? ...SPRIG? Is that you?"),
                p("KING CARBONARIUS", "The Duke's cold rot froze the whole domain. My people fled... and Effervescia went to the temple under Lake Brine to stop it."),
                p("KING CARBONARIUS", "Take this, my boy. The royal SNORKEL APRON. With it you can breathe under water as long as you like. Find my daughter!")]
    }
    if id == "carb_risen" { return [p("KING CARBONARIUS", "The Fizzwater Temple is under Lake Brine, Sprig. Effervescia is in there. *shiver*")] }
    if id == "cinder_serenade" {
        return [p("CINDER", "The Cast-Iron Boots. Heavy... but the bottom of the lake is a long way down."),
                p("CINDER", "Learn the SERENADE OF BRINE. It will carry you to Lake Brine, to the island above the temple."),
                p("CINDER", "The Fizzlings' princess fights alone down there. Hurry, Hero.")]
    }
    if id == "lake_temple_door" { return [p("FLICKER", "The temple's down there... we'll need to sink to the bottom. Those iron boots!")] }
    if id == "bt_enter" {
        return [p("FLICKER", "The Fizzwater Temple... it's all water and echoes. Use the boots to sink, and take them off to float up."),
                p("FLICKER", "Fizzy must be in here somewhere!")]
    }
    if id == "bt_plate" {
        if game.flag("bt_low") { return [p("", "A ROYAL CREST, WORN BY WATER.|The water has drained away. Play Saffron's Lullaby again to fill the temple.")] }
        return [p("", "A ROYAL CREST, WORN BY WATER.|\"The royal song calls the tide.\"")]
    }
    if id == "shadow_title" { return [p("", "SHADOW SPRIG|Your Reflection, Gone Mouldy")] }
    if id == "shadow_beaten" { return [p("FLICKER", "It... melted away. Like it was never there. Brr. There's a chest!")] }
    if id == "brine_title" { return [p("", "THE LIVING BRINE|Giant Aquatic Mould")] }
    if id == "brine_beaten" { return [p("FLICKER", "The water's clear again! Lake Brine is saved! Into the light, Sprig!")] }
    if id == "fizzy_keeper" {
        if game.flag("keeper_salt") { return [p("FIZZY", "Go on, my betrothed! Save the world! And then come back - you promised!")] }
        return [p("FIZZY", "SPRIG! You came! And you're... um. Taller. And... hmm. Quite handsome, actually."),
                p("FIZZY", "I'm the Keeper of SALT, it turns out. The sea, the tears, the brine in the pickle jar. Very important."),
                p("FIZZY", "You remember our engagement, I hope? A Fizzling never forgets. Take my medallion. It's practically a ring.")]
    }


    # ---- the Compost Crypt arc
    if id == "risen_miller2" {
        if game.has_item("song_boiling") { return [p("MILLER", "Round and round, wrong way round... Play that song by the well if you're thirsty. Hah!")] }
        return [p("MILLER", "Seven years without a drop of rain! I'll tell you why: there was a boy, years back, who played a song in here and the well dried right up. Or did it fill...?"),
                p("MILLER", "It went like this. Listen... the BOILING SONG. It makes the clouds boil over!")]
    }
    if id == "well_look" {
        if game.flag("well_drained") { return [p("FLICKER", "The well's dried up! There's a way down...")] }
        return [p("", "THE PEPPERMILL WELL.|Full to the brim with dark, still water.")]
    }
    if id == "well_enter" { return [p("FLICKER", "The bottom of the well... It's dark and it smells like old graves. Something's down here.")] }
    if id == "lens_hint" { return [p("FLICKER", "Things here aren't what they seem. That wall looks... wobbly?")] }
    if id == "cinder_nocturne" {
        return [p("CINDER", "The Onion Lens. It peels the lies from the world. You'll need it, below."),
                p("CINDER", "Learn the NOCTURNE OF ROT. It brings you here, among the graves... and it opens the Compost Crypt."),
                p("CINDER", "Your old nanny's... I mean, the Keeper of Sour sleeps down there, Hero.")]
    }
    if id == "crypt_door" { return [p("", "THE COMPOST CRYPT.|\"What rots is not lost. Sing the night's song, and enter.\"")] }
    if id == "cc_enter" {
        return [p("FLICKER", "The Compost Crypt... everything forgotten ends up here. Even ghosts."),
                p("FLICKER", "Keep the Onion Lens handy. Nothing down here is what it looks like.")]
    }
    if id == "maw_title" { return [p("", "THE MAW OF ROT|Unseen Eater of the Forgotten")] }
    if id == "maw_beaten" { return [p("FLICKER", "The Maw's gone... the crypt is just a crypt again. Into the light!")] }
    if id == "kimchi_keeper" {
        if game.flag("keeper_sour") { return [p("NANNY KIMCHI", "Go on, then. There's one more Keeper. And then... and then we'll see about the princess.")] }
        return [p("NANNY KIMCHI", "Well, well. The little Sprout who sneaked into the castle garden. Look at you now."),
                p("NANNY KIMCHI", "I am the Keeper of SOUR. Ferment, brine, the patience of a pickle jar. Seven years I waited down there."),
                p("NANNY KIMCHI", "Take my medallion. And Sprig... the princess is closer than you think. Trust the one who teaches you songs.")]
    }


    # ---- the Sugar Dunes and the Salt Idol
    if id == "sign_fort" { return [p("", "THE RAIDER FORT.|Home of the Paprika Raiders. Visitors will be robbed.")] }
    if id == "raider_caught" {
        return [p("RAIDER", "Hey! A man, sneaking in here? OUT you go, sweetie!"),
                p("", "You were thrown out of the fort.")]
    }
    if id == "fort_gate" { return [p("FLICKER", "The gate to the Haunted Flats... there must be a lever inside the fort somewhere.")] }
    if id == "sign_flats" { return [p("", "THE HAUNTED FLATS.|Follow the posts. Those who stray are lost in the sand.")] }
    if id == "flats_lost" { return [p("FLICKER", "We're going round in circles! The sand brought us back... Stick to the posts. And maybe the Onion Lens would show the way?")] }
    if id == "sign_idol" { return [p("", "THE SALT IDOL.|The temple of the twin witches, Saccharine and Sodium.")] }
    if id == "cinder_requiem" {
        return [p("CINDER", "The Salt Idol. The last Keeper sleeps within... but this temple is meant for two."),
                p("CINDER", "Learn the REQUIEM OF SUGAR. It brings you here, in any era... even as a child."),
                p("CINDER", "Some doors here only open for the small. Return to the Cleaver, and come back young.")]
    }
    if id == "caramel_child" {
        if game.has_item("platter") { return [p("CARAMEL", "Go on, kid! I'll handle the witches. Probably.")] }
        return [p("CARAMEL", "A KID? In the Idol? Who are you, the Raiders' new mascot? ...Sprig, you say? Cute name."),
                p("CARAMEL", "I'm Caramel, second of the Paprika Raiders. The witches have a treasure in here - the SILVER PLATTER. I want it to stop them."),
                p("CARAMEL", "But the way to it is through a hole too small for me. You'd fit! Get it for me... and I'll owe you one, kid.")]
    }
    if id == "platter_got" {
        return [p("CARAMEL", "You got it! Ha HA! Now... AAAH! What's - the witches! LET ME GO, YOU CRONES!"),
                p("", "Caramel was carried off by two cackling witches on broomsticks..."),
                p("FLICKER", "They took her! Sprig... you keep the platter. We'll come back for her. When you're bigger.")]
    }
    if id == "heavy_no" { return [p("FLICKER", "A block of rock salt... way too heavy to budge. You'd need something really strong.")] }
    if id == "crawl_hint" { return [p("FLICKER", "A little hole... too small for you now, Sprig. You'd fit when you were younger!")] }
    if id == "si_enter" {
        return [p("FLICKER", "The Salt Idol... The witches who raised the Duke live here. Be careful, Sprig.")]
    }
    if id == "witch_title" { return [p("", "SACCHARINE & SODIUM|The Twin Witches of Sugar and Salt")] }
    if id == "witch_beaten" {
        return [p("SACCHARINE", "Hee hee... we're dead? We're dead! Oh, sister, we've been beaten by a SPROUT!"),
                p("SODIUM", "Don't worry, sister. Mildew will take care of him. Mildew takes care of everything... eventually."),
                p("FLICKER", "They're gone! Into the light, Sprig!")]
    }
    if id == "caramel_keeper" {
        if game.flag("keeper_sweet") { return [p("CARAMEL", "Six Keepers, kid! Go - Cinder's waiting at the temple. Something big is about to happen.")] }
        return [p("CARAMEL", "Hey, kid. ...Or not a kid any more. You came back for me. Nobody comes back for a Raider."),
                p("CARAMEL", "I'm the Keeper of SWEET, apparently. Guess I'm not just a thief, huh?"),
                p("CARAMEL", "Here. My medallion. That makes six, kid. Go back to the Temple of the First Hearth. Cinder's waiting.")]
    }


    # ---- the finale
    if id == "saffron_reveal" {
        return [p("CINDER", "Six Keepers awake. Six flavours, Hero. You have done what I could not."),
                p("CINDER", "Then it is time you knew the truth. I am not one of the Sootfolk. There are no Sootfolk."),
                p("SAFFRON", "It's me, Sprig. Saffron. I hid for seven years behind this mask, holding the Ember of Wisdom where the Duke couldn't find it."),
                p("SAFFRON", "With it, and the six Keepers, we can finally -"),
                p("DUKE MILDEW", "Finally WHAT, little princess? Thank you both. I've been looking for that Ember for SEVEN YEARS."),
                p("", "A crystal of mould closed round Saffron, and Duke Mildew's laugh faded away..."),
                p("FLICKER", "He's taken her to his Spire! Sprig - the Keepers... I can hear them. They're building a bridge across the rot. To the castle!")]
    }
    if id == "rainbow" { return [p("FLICKER", "A bridge of six flavours across the rot! The Moldering Spire... Saffron's up there, Sprig. Let's go!")] }
    if id == "spire_enter" {
        return [p("FLICKER", "The Moldering Spire. Every floor of it is rotten through. Mildew's at the very top."),
                p("FLICKER", "Everything you've learned, Sprig. You'll need all of it.")]
    }
    if id == "spire_stairs" { return [p("FLICKER", "Stairs up! Each floor's guarded somehow...")] }
    if id == "mildew_top" {
        return [p("DUKE MILDEW", "Ah. The little sprout. All grown up. Seven years of rising, and you come to me sour and stale."),
                p("DUKE MILDEW", "Everything rots, boy. Bread. Kingdoms. Princesses. HEROES. Let me show you!")]
    }
    if id == "mildew_falls" {
        return [p("DUKE MILDEW", "Impossible... beaten by a... by a SPROUT...!"),
                p("SAFFRON", "Sprig! The crystal's gone - I'm free! But the tower... it's coming down! RUN!")]
    }
    if id == "escape_fail" { return [p("FLICKER", "The tower came down on us... Sprig! Wake up! We're back at the top. RUN, faster!")] }
    if id == "escape_out" { return [p("FLICKER", "We made it out! The Spire's gone... but what's that, in the ruins?")] }
    if id == "gorgemold_title" { return [p("", "GORGEMOLD|The Rotting Beast")] }
    if id == "saffron_holds" { return [p("SAFFRON", "I've got it, Sprig! Its TAIL - strike its tail!")] }
    if id == "gorgemold_end" {
        return [p("SAFFRON", "Now, Sprig! With the Cleaver of Dawn!"),
                p("", "Saffron's light held the beast fast, and Sprig brought the Cleaver of Dawn down..."),
                p("", "The six Keepers' voices rose together, and the Rotting Beast was sealed away in the compost of the Void."),
                p("SAFFRON", "It's over. It's really over, Sprig."),
                p("SAFFRON", "You lost seven years for us. I can't give them back... but the Kettle Whistle can send you home. To the years you lost."),
                p("SAFFRON", "Goodbye, Sprig. ...No. Not goodbye. See you again. In the garden.")]
    }
    if id == "ending_garden" {
        return [p("", "Seven years before, in the castle garden..."),
                p("SAFFRON", "Who are you? How did you get past the guards? ...You have a pilot light! Are you from the Thicket?"),
                p("FLICKER", "(Sprig... she doesn't remember. But we do. Shall we say hello?)")]
    }
    if id == "ending_starter" {
        return [p("", "And in Sprouthollow, in the old grove, in the cracked and empty crock..."),
                p("", "...a single small green bubble rose, and popped. Mother Starter was starting again.")]
    }
    if id == "the_end" { return [p("", "THE END|Thank you for playing Pantry Quest 3D!")] }


    # ---- Buttercup Dairy
    if id == "sign_dairy2" { return [p("", "BUTTERCUP DAIRY|The creamiest custard in the kingdom.")] }
    if id == "creme" {
        if game.has_item("song_custard") { return [p("CRÈME", "Custard loves that song! Sing it to her any time, fairy boy.")] }
        return [p("CRÈME", "Hi! I'm Crème. You've got a fairy! ...A pilot light? Oh. Same thing."),
                p("CRÈME", "That's Custard, our pudding-pony. She's shy. But she always comes running for Mum's song... want to learn it?")]
    }
    if id == "grubb_lazy" { return [p("GRUBB", "Zzz... Wha? Work? Later. Zzzz...")] }
    if id == "creme_risen" {
        if game.flag("custard") { return [p("CRÈME", "You knew Mum's song! Custard remembered it... and you. Grubb's furious! Hee hee.")] }
        return [p("CRÈME", "Grubb runs the dairy now. He sucks up to the Duke, and he wants Custard for him."),
                p("CRÈME", "But she won't let anyone near her. Not since... well. If only someone knew Mum's song.")]
    }
    if id == "grubb" { return [p("GRUBB", "That pony's the Duke's, you hear? Paid for! ...Well, promised for. Hands off!")] }
    if id == "custard_won" {
        return [p("", "Custard came trotting up and nuzzled Sprig."),
                p("CRÈME", "She remembers you! She's yours, Sprig - she'd never go to the Duke now. Here, take this, for Custard's sake!")]
    }


    # ---- the Golden Weevils
    if id == "sign_weevils" { return [p("", "THE WEEVIL HOUSE.|Golden Weevil tokens wanted. Ask inside... er, outside.")] }
    if id == "weevil_got" { return [p("", "You got a GOLDEN WEEVIL TOKEN!|You have " + game.count("weevils") + ". The Weevil House in Peppermill wants them.")] }
    if id == "weevil_house" {
        var n: int = game.count("weevils")
        if n >= 30 and not game.flag("weevil_r30") { return [p("WEEVIL KID", "THIRTY! I'm almost me again! Here - the biggest thing we had left. A whole HEART PIE!")] }
        if n >= 20 and not game.flag("weevil_r20") { return [p("WEEVIL KID", "Twenty tokens! My fingers are back! Take this, it's all we've got... a PIE SLICE.")] }
        if n >= 10 and not game.flag("weevil_r10") { return [p("WEEVIL KID", "Ten tokens! I can feel my nose again! Here - Dad's GIANT BEAN PURSE. It holds 200!")] }
        return [p("WEEVIL KID", "Bzzz... we were greedy, and now we're Golden Weevils. Every token you find turns one of us back a little."),
                p("WEEVIL KID", "You have " + n + ". Bring me 10, 20, and 30, and I'll give you something nice. Bzzz.")]
    }

    # ---- the Great Crock
    if id == "crock_enter" {
        return [p("FLICKER", "Eww. It's all warm and bubbly in here. And it smells like... bread?"),
                p("FLICKER", "The curse must be deep down. Let's look around! Press {flicker} if you get stuck.")]
    }
    if id == "crock_eye" { return [p("FLICKER", "That eye over the door is watching us! If only we had something to shoot it with...")] }
    if id == "crock_crates" { return [p("", "CRUST BLOCKS|Walk into a block and keep pushing: it slides a step. Heavy enough to hold a switch down!")] }
    if id == "crock_proof" { return [p("", "THE PROOFING ROOM|Warm dough rises under a sprout's feet, and sinks when he steps off. Don't dawdle!")] }
    if id == "crock_furnace" { return [p("", "THE FURNACE|Cold dough won't rise. Light the fire-bowls and their warmth will raise it - for good.")] }
    if id == "crock_bkroom" { return [p("", "Both switches down, and the gate opens.")] }
    if id == "crock_web" { return [p("FLICKER", "This web is made of mould. Swords won't cut it... but I bet fire would burn it right up!")] }
    if id == "crock_torch" { return [p("FLICKER", "A torch! If a pea flew through that flame... it might catch fire!")] }
    if id == "crock_scrubs" {
        return [p("", "THE THREE SCRUB BROTHERS GUARD THIS DOOR.|Strike them in order: the middle one, then the right, then the left.")]
    }
    if id == "scrub_beaten" {
        return [p("SPIT-SCRUB", "Ow ow ow! You win, you win! Don't hurt me!"),
                p("SPIT-SCRUB", "We only serve the mould because it makes us strong... Here's a tip: the Queen's eye is her weak spot. Bye!")]
    }
    if id == "scrub_wrong" { return [p("SPIT-SCRUB", "Wrong order! Hee hee! Try again!")] }
    if id == "scrubs_done" { return [p("FLICKER", "The door opened! Brothers, huh.")] }
    if id == "queen_title" { return [p("", "QUEEN MILDEWMITE|Parasitic Mould Mite")] }
    if id == "queen_beaten" {
        return [p("FLICKER", "We did it! The curse is broken... I think."),
                p("FLICKER", "Step into that light, Sprig. It'll take us back to Mother Starter.")]
    }
    if id == "locked" { return [p("", "The door is locked. You need a small key.")] }
    if id == "boss_locked" { return [p("", "A huge lock seals this door. It needs the Boss Key.")] }
    return [p("", "...")]
}

# ---- what happens when a talk ends ----
func after(what: string, choice: int) -> void {
    if game == nil { game = find("Game") }
    if what == "met_flicker" {
        game.set_flag("met_flicker")
    } elif what == "chive_moved" {
        game.set_flag("chive_moved")
    } elif what == "starter_open" {
        game.set_flag("starter_open")
        broadcast("starter_opens")
    } elif what == "ember" {
        game.set_flag("starter_farewell")
        game.give("ember_courage", "")
    } elif what == "pipe" {
        game.set_flag("fennel_bridge")
        game.give("pipe", "")
    } elif what == "shop" {
        var options: list = []
        if not game.has_item("potlid") { push(options, "potlid") }
        if game.has_item("shooter") { push(options, "peas") }
        push(options, "none")
        if choice < 0 or choice >= len(options) { return }
        var pick: string = options[choice]
        if pick == "potlid" {
            if game.beans < 40 { game.talk("sage_poor", "") } else {
                game.add_beans(-40)
                game.give("potlid", "")
            }
        } elif pick == "peas" {
            if game.peas >= game.max_peas() { game.talk("sage_full", "") } elif game.beans < 10 { game.talk("sage_poor", "") } else {
                game.add_beans(-10)
                game.peas = min(game.max_peas(), game.peas + 10)
                game.commit()
                play_sound("sfx/bean.wav", 0.6)
                game.talk("sage_bye", "")
            }
        } else {
            game.talk("sage_bye", "")
        }
    } elif what == "basil_shop" {
        var opts: list = []
        if not game.flag("bought_slice") { push(opts, "slice") }
        if game.has_item("shooter") { push(opts, "peas") }
        push(opts, "none")
        if choice < 0 or choice >= len(opts) { return }
        var pk: string = opts[choice]
        if pk == "slice" {
            if game.beans < 99 { game.talk("basil_poor", "") } else {
                game.add_beans(-99)
                game.set_flag("bought_slice")
                game.give("slice", "")
            }
        } elif pk == "peas" {
            if game.beans < 10 { game.talk("basil_poor", "") } else {
                game.add_beans(-10)
                game.peas = min(game.max_peas(), game.peas + 10)
                game.commit()
                play_sound("sfx/bean.wav", 0.6)
                game.talk("basil_bye", "")
            }
        } else {
            game.talk("basil_bye", "")
        }
    } elif what == "saffron_done" {
        game.set_flag("met_saffron_talk")
        game.give("letter", "kimchi")
    } elif what == "kimchi" {
        game.talk("kimchi_song", "lullaby")
    } elif what == "lullaby" {
        play_sound("sfx/secret.wav", 0.8)
        game.give("song_lullaby", "escort")
    } elif what == "escort" {
        game.set_flag("met_saffron")
        game.go("town", "castle")
    } elif what == "mountain_open" {
        game.set_flag("mountain_open")
    } elif what == "bracelet" {
        game.give("bracelet", "")
    } elif what == "ember_power" {
        game.give("ember_power", "")
    } elif what == "caught" {
        game.go(game.area, "start")
    } elif what == "owl_leaves" {
        for o in find_all("Owl") { send(o, "fly_away") }
    } elif what == "dive_go" {
        if choice == 0 { find("Dive Game").begin() }
    } elif what == "fizzbubble" {
        game.give("fizzbubble", "")
    } elif what == "carb_moved" {
        game.set_flag("carb_moved")
    } elif what == "fizzy_letter_read" {
        game.give("letter_fizzy", "fizzy_letter_talk")
    } elif what == "fizzy_letter_talk" {
        game.talk("fizzy_letter", "")
    } elif what == "gulp_in" {
        game.go("gulp", "start")
    } elif what == "ember_wisdom" {
        game.give("ember_wisdom", "")
    } elif what == "whistle_vision" {
        game.talk("saffron_vision", "song_rising")
    } elif what == "song_rising" {
        play_sound("sfx/secret.wav", 0.8)
        game.give("song_rising", "")
    } elif what == "risen_first" {
        if choice == 0 {
            play_sound("sfx/rumble.wav", 0.9)
            shake_camera(3, 1.2)
            game.talk("mildew_thanks", "risen_sleep")
        }
    } elif what == "risen_sleep" {
        game.set_flag("risen_once")
        game.clear_flag("storm_now")
        game.add_item("cleaver")
        game.era = "risen"
        game.commit()
        game.go("vault", "start")
    } elif what == "era_risen" {
        if choice == 0 {
            game.era = "risen"
            game.commit()
            play_sound("sfx/warp.wav", 0.8)
            game.go("temple", "block")
        }
    } elif what == "era_fresh" {
        if choice == 0 {
            game.era = "fresh"
            game.commit()
            play_sound("sfx/warp.wav", 0.8)
            game.go("temple", "block")
        }
    } elif what == "umami" {
        game.set_flag("met_mozz")
        game.give("med_umami", "")
    } elif what == "prelude" {
        play_sound("sfx/secret.wav", 0.8)
        game.give("song_prelude", "")
    } elif what == "race_go" {
        if choice == 0 { find("Ghost").go() }
    } elif what == "lash" {
        game.give("lash", "")
    } elif what == "med_bitter" {
        game.set_flag("keeper_bitter")
        game.give("med_bitter", "")
    } elif what == "minuet" {
        play_sound("sfx/secret.wav", 0.8)
        game.give("song_minuet", "")
    } elif what == "apron" {
        game.give("apron", "")
    } elif what == "med_spice" {
        game.set_flag("keeper_spice")
        game.give("med_spice", "")
    } elif what == "bolero" {
        play_sound("sfx/secret.wav", 0.8)
        game.give("song_bolero", "")
    } elif what == "snorkel" {
        game.give("snorkel", "")
    } elif what == "serenade" {
        play_sound("sfx/secret.wav", 0.8)
        game.give("song_serenade", "")
    } elif what == "med_salt" {
        game.set_flag("keeper_salt")
        game.give("med_salt", "")
    } elif what == "boiling" {
        play_sound("sfx/secret.wav", 0.8)
        game.give("song_boiling", "")
    } elif what == "nocturne" {
        play_sound("sfx/secret.wav", 0.8)
        game.give("song_nocturne", "")
    } elif what == "med_sour" {
        game.set_flag("keeper_sour")
        game.give("med_sour", "")
    } elif what == "requiem" {
        play_sound("sfx/secret.wav", 0.8)
        game.give("song_requiem", "")
    } elif what == "platter_after" {
        game.set_flag("caramel_taken")
        game.talk("platter_got", "")
    } elif what == "med_sweet" {
        game.set_flag("keeper_sweet")
        game.give("med_sweet", "")
    } elif what == "reveal" {
        game.set_flag("saffron_taken")
        game.set_flag("rainbow")
    } elif what == "escape" {
        set_global("escape_left", 150)
        game.set_flag("escaping")
    } elif what == "ending" {
        game.clear_flag("escaping")
        game.set_flag("game_done")
        game.era = "fresh"
        game.commit()
        game.go("ending", "start")
    } elif what == "custard_song" {
        play_sound("sfx/secret.wav", 0.8)
        game.give("song_custard", "")
    } elif what == "custard_slice" {
        game.give("slice", "")
    } elif what == "weevil_reward" {
        var n: int = game.count("weevils")
        if n >= 30 and not game.flag("weevil_r30") {
            game.set_flag("weevil_r30")
            game.give("heartpie", "")
        } elif n >= 20 and not game.flag("weevil_r20") {
            game.set_flag("weevil_r20")
            game.give("slice", "")
        } elif n >= 10 and not game.flag("weevil_r10") {
            game.set_flag("weevil_r10")
            game.give("purse200", "")
        }
    } elif what == "crock_warp" {
        game.set_flag("crock_done")
        game.go("sprouthollow", "grove")
    }
}

# A new area has started: first-time talks.
func area_started(area: string) -> void {
    if game == nil { game = find("Game") }
    if area == "sprouthollow" and not game.flag("met_flicker") { game.talk("intro", "met_flicker") }
    if area == "fields" and not game.flag("fields_entered") {
        game.set_flag("fields_entered")
    }
    if area == "hardcaves" and not game.flag("hc_entered") {
        game.set_flag("hc_entered")
        game.talk("hc_enter", "")
    }
    if area == "fizzdomain" and not game.flag("fizz_entered") {
        game.set_flag("fizz_entered")
        game.talk("fizz_enter", "")
    }
    if area == "fountain" and not game.flag("fountain_entered") {
        game.set_flag("fountain_entered")
        game.talk("fountain_enter", "")
    }
    if area == "gulp" and not game.flag("gulp_entered") {
        game.set_flag("gulp_entered")
        game.talk("gulp_enter", "")
    }
    if area == "temple" and not game.flag("temple_entered") {
        game.set_flag("temple_entered")
        game.talk("temple_enter", "")
    }
    if area == "vault" and not game.flag("met_mozz") { game.talk("mozz_1", "umami") }
    if area == "town" and game.era == "risen" and not game.flag("spire_seen") {
        game.set_flag("spire_seen")
        game.talk("spire", "")
    }
    if area == "thymetemple" and not game.flag("tt_entered") {
        game.set_flag("tt_entered")
        game.talk("tt_enter", "")
    }
    if area == "forge" and not game.flag("forge_entered") {
        game.set_flag("forge_entered")
        game.talk("forge_enter", "")
    }
    if area == "brinetemple" and not game.flag("bt_entered") {
        game.set_flag("bt_entered")
        game.talk("bt_enter", "")
    }
    if area == "well" and not game.flag("well_entered") {
        game.set_flag("well_entered")
        game.talk("well_enter", "")
    }
    if area == "crypt" and not game.flag("cc_entered") {
        game.set_flag("cc_entered")
        game.talk("cc_enter", "")
    }
    if area == "idoltemple" and not game.flag("si_entered") {
        game.set_flag("si_entered")
        game.talk("si_enter", "")
    }
    if area == "spire" and not game.flag("spire_entered") {
        game.set_flag("spire_entered")
        game.talk("spire_enter", "")
    }
    if area == "ruins" and not game.flag("ruins_entered") {
        game.set_flag("ruins_entered")
        game.clear_flag("escaping")
        game.talk("escape_out", "")
    }
    if area == "crock" and not game.flag("crock_entered") {
        game.set_flag("crock_entered")
        game.talk("crock_enter", "")
    }
    # out of the Great Crock, the curse broken: Mother Starter speaks at once
    if area == "sprouthollow" and game.flag("crock_done") and not game.flag("starter_farewell") and game.spawn == "grove" {
        game.talk("starter_farewell", "ember")
    }
}

# ---- Flicker's hints: the first thing still to do ----
func hint() -> string {
    if game == nil { game = find("Game") }
    if game.dungeon == "crock" { return crock_hint() }
    if not game.has_item("spoon") and not game.has_item("potlid") {
        return "Chive won't let you near Mother Starter without a spoon and a shield. There's a Kitchen Garden through the hedge on the west side - and Sage's shop sells shields!"
    }
    if not game.has_item("spoon") { return "You still need a spoon! Crawl through the hole in the hedge on the west side, into the Kitchen Garden." }
    if not game.has_item("potlid") {
        return "Sage's shop sells a Pot-Lid Shield for 40 beans. You have " + game.beans + ". Cut grass, smash pots and roll into trees to find more!"
    }
    if not game.flag("chive_moved") { return "Show Chive your spoon and shield! He's guarding the grove path, north of the village green." }
    if not game.flag("starter_open") { return "Mother Starter is waiting in her grove, at the end of the path north!" }
    if not game.flag("crock_done") { return "Mother Starter's mouth is open. We have to go inside and break the curse!" }
    if not game.has_item("ember_courage") { return "Talk to Mother Starter, Sprig." }
    if not game.has_item("pipe") { return "Fennel... I think she's waiting for you, by the bridge south of the village." }
    if not game.flag("met_saffron") {
        if game.area == "castle" { return "Sneak through the garden to the princess! Stay out of the guards' sight - see the pale light in front of them? Wait behind the shrubs till they turn." }
        if game.area == "town" { return "The castle road leaves the north side of town. The princess is somewhere in the castle garden!" }
    }
    if game.dungeon == "hardcaves" { return hardcaves_hint() }
    if not game.flag("mountain_open") { return "The Ember of Power is with the Hardtack Clan on Mount Fondue. Go to Peppermill Village (north-east of the field) - and show the princess's letter to the guard at the trail!" }
    if not game.has_item("bracelet") {
        if not game.flag("door:biscotti") { return "Big Biscotti's room is at the top of Hardtack City. Its door has a royal crest... play SAFFRON'S LULLABY on your pipe!" }
        return "Big Biscotti is in a terrible mood. Fennel said her tune cheers anyone up... play FENNEL'S TUNE for him!"
    }
    if not game.flag("caves_boulder") { return "Pull a bomb flower with the Gum Bracelet and blow up the boulder at Hardtack Caverns, further up the trail!" }
    if not game.flag("hardcaves_done") { return "Into Hardtack Caverns! Find out what the Duke put in there." }
    if not game.has_item("ember_power") { return "Big Biscotti is waiting outside the caverns!" }
    if game.dungeon == "gulp" { return gulp_hint() }
    if not game.flag("door:falls") { return "The last Ember is with the Fizzlings. Take the west road from the field into Brine Valley, and follow the river up to Fizzwater Falls!" }
    if not game.flag("talked_carb") { return "King Carbonarius must be at the back of the Fizzling Domain. Let's talk to him!" }
    if not game.has_item("fizzbubble") { return "The princess was last seen at Lake Brine... but we may need to dive deep. The Fizzling by the pool has a diving game - win it!" }
    if not game.has_item("letter_fizzy") { return "Lake Brine is south down Brine Valley. Something was glinting at the bottom, near the island. Dive for it!" }
    if not game.flag("carb_moved") { return "Show Fizzy's letter to King Carbonarius!" }
    if not game.flag("gulp_open") { return "Lord Gulp eats fish from a jar. Catch a fish in the fountain's shallows with your jar, then use the jar at the altar beside him." }
    if not game.flag("gulp_done") { return "Lord Gulp opened wide for us. In we go... Fizzy's in there somewhere!" }
    if not game.has_item("ember_wisdom") { return "Fizzy's waiting at Fizzwater Fountain!" }
    if not game.flag("storm_seen") { return "All three Embers! Let's go back to Larder Town and tell Saffron." }
    if not game.has_item("whistle") { return "Saffron threw something into the moat, by the castle road's bridge. Dive in and find it!" }
    if not game.flag("door:seasons") { return "Saffron said: take the Embers to the Door of Seasons, in the Temple of the First Hearth (east side of town), and play the SONG OF RISING." }
    if not game.flag("risen_once") { return "The Cleaver of Dawn is in the Pantry of Ages, past the Door of Seasons." }
    if not game.flag("met_mozz") { return "Talk to Old Mozz." }
    if not game.has_item("song_prelude") { return "Someone's waiting on the temple steps, outside." }
    if game.dungeon == "thymetemple" { return thyme_hint() }
    if not game.has_item("lash") {
        if game.area == "thicket" { return "The temple's stair is broken. We need something that could pull us across... Peppermill's old gravekeeper had a treasure, they say. His ghost haunts the graveyard." }
        return "The Thyme Temple is in the Thicket of Thyme, east of the field - but its stair is broken. In Peppermill, the old gravekeeper's ghost is said to race visitors for his treasure."
    }
    if not game.flag("thymetemple_done") { return "The Thyme Temple! Through the Thicket, east of the field, up the broken stair in the Glade. Lash yourself across to the target!" }
    if not game.flag("keeper_bitter") { return "Fennel is waiting in the Chamber of Keepers." }
    if not game.has_item("song_minuet") { return "Cinder's in the Glade. Go and see what they want." }
    if game.dungeon == "forge" { return forge_hint() }
    if not game.has_item("apron") { return "The next Keeper sleeps in fire, in the Fondue Forge up in Mount Fondue's crater. It'll be too hot without protection... someone in Hardtack City might help." }
    if not game.flag("forge_done") { return "The Fondue Forge! Up the Mount Fondue trail, past Peppermill, into the crater." }
    if not game.flag("keeper_spice") { return "Big Biscotti is waiting in the Chamber of Keepers." }
    if not game.has_item("song_bolero") { return "Cinder's waiting at the crater's edge." }
    if game.dungeon == "brinetemple" { return brine_hint() }
    if not game.has_item("boots") { return "The Fizzling Domain has frozen over. Go through it to the fountain - there's a cave across the ice. Something heavy might be in there." }
    if not game.has_item("snorkel") { return "King Carbonarius is frozen in red ice in his domain. Blue fire from the Freezer Caves would melt it! Carry some in a jar." }
    if not game.flag("brinetemple_done") { return "The Fizzwater Temple is under Lake Brine, below the island. Put on the Cast-Iron Boots and sink!" }
    if not game.flag("keeper_salt") { return "Fizzy is waiting in the Chamber of Keepers." }
    if game.dungeon == "crypt" { return crypt_hint() }
    if not game.has_item("lens") {
        if not game.has_item("song_boiling") { return "Peppermill's miller says the well dried up when someone played a song in the windmill. Ask him about it!" }
        if not game.flag("well_drained") { return "Play the Boiling Song beside Peppermill's well!" }
        return "Climb down into the dried-up well. Something's down there..."
    }
    if not game.has_item("song_nocturne") { return "Cinder's waiting in Peppermill's graveyard." }
    if not game.flag("crypt_done") { return "The Compost Crypt is under the graveyard. Play the Nocturne of Rot at the crypt door, at the back!" }
    if not game.flag("keeper_sour") { return "Nanny Kimchi is waiting in the Chamber of Keepers." }
    if game.dungeon == "idoltemple" { return idol_hint() }
    if not game.flag("fort_gate") { return "The last Keeper is in the Salt Idol, beyond the Raider Fort (west from Brine Valley's bridge). Sneak into the fort and find the gate lever!" }
    if not game.has_item("song_requiem") { return "Cross the Haunted Flats - follow the posts - to the Salt Idol. Someone's waiting there." }
    if not game.has_item("platter") {
        if game.era == "risen" { return "Cinder said some doors in the Idol only open for the small. Put the Cleaver back at the temple, then play the Requiem of Sugar!" }
        return "Play the Requiem of Sugar and crawl through the little hole in the Salt Idol!"
    }
    if not game.flag("idol_done") {
        if game.era == "fresh" { return "You've got the Silver Platter! Now grow up again - pull the Cleaver at the temple - and come back to the Idol." }
        return "The Salt Idol, with the Silver Platter: heave that block of rock salt aside!"
    }
    if not game.flag("keeper_sweet") { return "Caramel is waiting in the Chamber of Keepers." }
    if not game.flag("saffron_taken") { return "Six Keepers! Caramel said Cinder's waiting at the Temple of the First Hearth." }
    if game.flag("escaping") { return "The tower's coming down! Get out - the way down is at the edge of the top floor!" }
    if not game.flag("mildew_beaten") { return "The Moldering Spire, where the castle was - over the Keepers' bridge at the top of Larder Town. Saffron's up there!" }
    return "Gorgemold! Its tail is its weak spot. When Saffron holds it still, run round behind it and strike!"
}

func idol_hint() -> string {
    if game.era == "fresh" { return "Crawl through the little hole - Caramel wants the Silver Platter!" }
    if not game.flag("si_salt") { return "Heave the block of rock salt aside with the Silver Platter." }
    if not game.has_item("bosskey_idoltemple") { return "The Boss Key's somewhere up the stairs. Cut down what guards it!" }
    return "The witches! Catch their bolts on your shield - a sugar bolt flies back at the salt witch, and the other way round."
}

func crypt_hint() -> string {
    if not game.flag("door:cc_key") { return "Use the Onion Lens! There are walls that aren't walls, and floors you can't see." }
    if not game.has_item("hover") { return "The room past the blades... beat everything in there." }
    if not game.has_item("bosskey_crypt") { return "With the Meringue Boots you can walk on air for a moment. That gap in the north room!" }
    return "The Maw of Rot waits past the big door. Strike its hands after they slam down; then look at it through the Onion Lens!"
}

func brine_hint() -> string {
    if not game.flag("bt_low") and not game.has_item("longlash") { return "Find the royal crest in the middle of the temple and play Saffron's Lullaby to lower the water!" }
    if not game.has_item("longlash") { return "With the water down, the lower rooms are open. Something waits in the west room..." }
    if not game.has_item("bosskey_brinetemple") { return "The Long Licorice reaches twice as far. That high target in the east room!" }
    return "The boss is through the big door, north. When its core shows, lash it out of the water!"
}

func forge_hint() -> string {
    if not game.has_item("hammer") { return "The prisoner said the big hammer's in the west room, guarded by crust golems." }
    if not game.flag("fg_rust") { return "That rusty switch in the east room won't budge... unless you whack it with the Meat Tenderizer!" }
    if not game.flag("door:fg_north") { return "The small key's in the alcove past the east room's rusty door." }
    if not game.has_item("bosskey_forge") { return "Hit the rusty switch in the north room to raise the bridge over the cheese." }
    return "The dragon's lair is past the big door. When a hole glows, be ready to WHACK its head with the hammer as it comes up!"
}

func thyme_hint() -> string {
    if not game.flag("tt_flame1") and not game.has_item("map_thymetemple") { return "The braziers' flames were stolen by ghosts. The rooms off the hall are haunted... start with the west one." }
    if not game.has_item("bow") { return "The east room's guarded by Stalebies. Beat them - there must be something good in there." }
    if not game.flag("door:tt_north") { return "The small key is up on the ledge in the east room. Lash up to the target!" }
    if not game.flag("tt_flame2") { return "The red sister floats too high for the Cleaver. Skewer her when she shows herself!" }
    if not game.flag("tt_flame3") { return "One sister left: east of the north room, across the pit. Lash over!" }
    if not game.flag("tt_flames") { return "Go back to the hall of braziers." }
    return "All three braziers burn! Stand on the lift in the middle of the hall. And bring skewers..."
}

func gulp_hint() -> string {
    if not game.flag("ga_sw") { return "Stand on the switch in the floor and see what opens!" }
    if not game.flag("met_fizzy") { return "Princess Fizzy must be further in. Keep going north!" }
    if not game.has_item("boomerang") { return "The west door needs its switch held down. Carry Fizzy over and set her down on it ({attack})! Then deal with what's inside." }
    if not game.flag("gd_bridge") { return "In the east room, a tendril holds up a bridge. Focus on it with {focus} and throw the boomerang!" }
    if not game.flag("door:gulp_north") { return "Use the small key on the north door of the round room!" }
    if not game.has_item("bosskey_gulp") { return "There's a door in the north room that needs a switch held down. Bring Fizzy!" }
    if not game.flag("ge_knot") { return "Three tendrils in the north room guard the way to the boss. Cut them all with the boomerang!" }
    return "The boss is through the big door. Its tendrils protect it - cut them with the boomerang, and it'll drop!"
}

func hardcaves_hint() -> string {
    if not game.flag("hc_wall1") { return "That cracked wall to the north... pull a bomb flower and throw it (A), or put it down beside the wall (B) and stand back!" }
    if not game.has_item("bombs") { return "There must be something in here to carry bombs with. Search the rooms off the cheese hall!" }
    if not game.flag("door:hc_north") { return "We need a small key for the door north of the cheese hall. Try the east room - is something blocking the way?" }
    if not game.has_item("bosskey_hardcaves") { return "The Boss Key must be in the north room. Cracked walls hide things!" }
    return "The big door! King Crustodon is behind it. If he breathes in... feed him a bomb!"
    if game.area == "sprouthollow" { return "The bridge to the south leads out of Sprouthollow, to Breadbasket Fields and Castle Larder beyond." }
    return "Castle Larder is north, across the field. Mother Starter said to find the princess there!"
}

func crock_hint() -> string {
    if not game.flag("door:crock_proof") and game.count("keys_crock") <= 0 { return "The room to the east has a crust block - and a switch in the floor. Push the block on to it!" }
    if not game.has_item("shooter") { return "The locked door is to the west of the big hall. Ride the warm dough up to the ledge in there!" }
    if not game.flag("crock_eye") { return "The eye under the balcony! Focus on it with {focus} and shoot it with the Pea Shooter." }
    if not (game.flag("crock_bowl_w") and game.flag("crock_bowl_e")) { return "Shoot a pea through a torch's flame and it'll catch fire. Then aim it at the fire-bowls across the gap!" }
    if game.count("keys_crock") <= 0 and not game.flag("door:crock_bk") and not game.flag("crock_web_key") { return "The web over there guards something! A burning pea will burn it - find a torch in line with it." }
    if not game.flag("crock_web_hall") { return "The warm dough in the hall is behind a web. Shoot a pea through the torch in front of it!" }
    if not game.has_item("bosskey_crock") { return "Up on the balcony, the locked door north. Two blocks, two switches!" }
    return "The big door is at the west end of the balcony. The Queen's eye is her weak spot - shoot it when it glows red!"
}

# ---- names and descriptions of things ----
func item_name(kind: string) -> string {
    var names: list = [["spoon", "WOODEN SPOON"], ["potlid", "POT-LID SHIELD"], ["shooter", "PEA SHOOTER"],
                       ["map_crock", "DUNGEON MAP"], ["compass_crock", "COMPASS"], ["bosskey_crock", "BOSS KEY"],
                       ["key", "SMALL KEY"], ["heartpie", "HEART PIE"], ["ember_courage", "EMBER OF COURAGE"],
                       ["pipe", "FENNEL'S PIPE"], ["slice", "PIE SLICE"], ["letter", "SAFFRON'S LETTER"], ["song_lullaby", "SAFFRON'S LULLABY"], ["bean20", "RED BEAN"], ["bean50", "PURPLE BEAN"]]
    for n in names {
        if n[0] == kind { return n[1] }
    }
    return kind
}

func item_text(kind: string) -> string {
    if kind == "purse200" { return "You got the GIANT BEAN PURSE!|Now you can carry 200 beans." }
    if kind == "song_custard" { return "You learned CUSTARD'S SONG!|A gentle farm song. Custard the pudding-pony always comes running for it." }
    if kind == "song_requiem" { return "You learned the REQUIEM OF SUGAR!|Play it anywhere outside a dungeon - in either era - to warp to the Salt Idol." }
    if kind == "platter" { return "You got the SILVER PLATTER!|Strong enough to heave the heaviest block of rock salt. It's yours for good." }
    if kind == "med_sweet" { return "You got the SWEET MEDALLION!|Caramel, Keeper of Sweet, has woken. Six medallions!" }
    if kind == "map_idoltemple" { return "You found the DUNGEON MAP!|See every room of the Salt Idol in the pause menu." }
    if kind == "compass_idoltemple" { return "You found the COMPASS!|Now the map shows the treasure and the witches." }
    if kind == "bosskey_idoltemple" { return "You got the BOSS KEY!|It opens the way to the twin witches." }
    if kind == "song_boiling" { return "You learned the BOILING SONG!|A stormy song that makes the clouds boil over. Rain follows it." }
    if kind == "lens" { return "You got the ONION LENS!|Put it on a button and peel back the world: see what's hidden, and see through what's false." }
    if kind == "song_nocturne" { return "You learned the NOCTURNE OF ROT!|Play it to warp to Peppermill's graveyard. It also opens the Compost Crypt." }
    if kind == "hover" { return "You got the MERINGUE BOOTS!|So light you can walk on air for a moment. {hover} puts them on; press it again to take them off." }
    if kind == "med_sour" { return "You got the SOUR MEDALLION!|Nanny Kimchi, Keeper of Sour, has woken." }
    if kind == "map_crypt" { return "You found the DUNGEON MAP!|See every room of the Compost Crypt in the pause menu." }
    if kind == "compass_crypt" { return "You found the COMPASS!|Now the map shows the treasure and the master." }
    if kind == "bosskey_crypt" { return "You got the BOSS KEY!|It opens the door to the Maw of Rot." }
    if kind == "boots" { return "You got the CAST-IRON BOOTS!|{boots} puts them on: you sink in water and walk the bottom. Press it again to take them off." }
    if kind == "snorkel" { return "You got the SNORKEL APRON!|The royal Fizzling apron. Now you can breathe under water as long as you like." }
    if kind == "song_serenade" { return "You learned the SERENADE OF BRINE!|Play it anywhere outside a dungeon to warp to Lake Brine." }
    if kind == "longlash" { return "You got the LONG LICORICE!|Your Licorice Lash now reaches twice as far!" }
    if kind == "med_salt" { return "You got the SALT MEDALLION!|Fizzy, Keeper of Salt, has woken." }
    if kind == "map_brinetemple" { return "You found the DUNGEON MAP!|See every room of the Fizzwater Temple in the pause menu." }
    if kind == "compass_brinetemple" { return "You found the COMPASS!|Now the map shows the treasure and the master." }
    if kind == "bosskey_brinetemple" { return "You got the BOSS KEY!|It opens the door to the Living Brine." }
    if kind == "apron" { return "You got the OVEN APRON!|Big Biscotti's spare. Now the worst heat can't hurt you." }
    if kind == "hammer" { return "You got the MEAT TENDERIZER!|Put it on a button and SMASH: rusty switches, cracked rock, and the odd dragon." }
    if kind == "med_spice" { return "You got the SPICE MEDALLION!|Big Biscotti, Keeper of Spice, has woken." }
    if kind == "song_bolero" { return "You learned the BOLERO OF EMBERS!|Play it anywhere outside a dungeon to warp to Mount Fondue's crater." }
    if kind == "map_forge" { return "You found the DUNGEON MAP!|See every room of the Fondue Forge in the pause menu." }
    if kind == "compass_forge" { return "You found the COMPASS!|Now the map shows the treasure and the master." }
    if kind == "bosskey_forge" { return "You got the BOSS KEY!|It opens the door to the dragon's lair." }
    if kind == "song_minuet" { return "You learned the MINUET OF THYME!|Play it anywhere outside a dungeon to warp to the Glade in the Thicket." }
    if kind == "map_thymetemple" { return "You found the DUNGEON MAP!|See every room of the Thyme Temple in the pause menu." }
    if kind == "compass_thymetemple" { return "You found the COMPASS!|Now the map shows the treasure and the master." }
    if kind == "bosskey_thymetemple" { return "You got the BOSS KEY!|...though this temple's master waits down the lift." }
    if kind == "lash" { return "You got the LICORICE LASH!|Fire it with its button. It bites into wooden targets and pulls you over to them." }
    if kind == "bow" { return "You got the SKEWER BOW!|Fire skewers with its button. Focus with {focus} first to aim. Holds 30." }
    if kind == "med_bitter" { return "You got the BITTER MEDALLION!|Fennel, Keeper of Bitter, has woken." }
    if kind == "whistle" { return "You got the KETTLE WHISTLE!|The royal family's treasure. It plays every song the pipe did, only sweeter." }
    if kind == "song_rising" { return "You learned the SONG OF RISING!|A song of time itself. Play it before the Door of Seasons." }
    if kind == "med_umami" { return "You got the UMAMI MEDALLION!|Old Mozz's own. It holds the deep, savoury flavour of the Keeper of Umami." }
    if kind == "song_prelude" { return "You learned the PRELUDE OF THE HEARTH!|Play it anywhere outside a dungeon to warp back to the Temple of the First Hearth." }
    if kind == "fizzbubble" { return "You got the FIZZ BUBBLE!|Now you can dive much deeper. Press {action} while swimming, and hold it to go down." }
    if kind == "jar1" { return "You got a JAR!|Put it on a button. Swing it to catch things... like fish." }
    if kind == "letter_fizzy" { return "You got FIZZY'S LETTER!|A soggy letter from Princess Effervescia. Her father should see this." }
    if kind == "boomerang" { return "You got the SPATULA BOOMERANG!|Press its button to throw it. Focus with {focus} first to aim. It stuns, cuts, and fetches things." }
    if kind == "ember_wisdom" { return "You got the EMBER OF WISDOM!|The ember that preserves. All three Embers are yours!" }
    if kind == "map_gulp" { return "You found the DUNGEON MAP!|See every room inside Lord Gulp in the pause menu." }
    if kind == "compass_gulp" { return "You found the COMPASS!|Now the map shows the treasure and the boss." }
    if kind == "bosskey_gulp" { return "You got the BOSS KEY!|It opens the way to what's making Lord Gulp sick." }
    if kind == "spoon" { return "You got the WOODEN SPOON!|Swing it with {attack}. Hold {attack} and let go for a spin attack!" }
    if kind == "potlid" { return "You got the POT-LID SHIELD!|Hold {shield} to raise it. It blocks attacks from the front." }
    if kind == "shooter" { return "You got the PEA SHOOTER!|It's on an item button: press it to aim, then again to shoot. Focused with {focus}, it fires straight away." }
    if kind == "map_crock" { return "You found the DUNGEON MAP!|See every room of the Great Crock in the pause menu." }
    if kind == "compass_crock" { return "You found the COMPASS!|Now the map shows where the treasure chests and the boss are." }
    if kind == "bosskey_crock" { return "You got the BOSS KEY!|It opens the door to the lair of the Great Crock's master." }
    if kind == "key" { return "You found a SMALL KEY!|It opens a locked door, but only in this place." }
    if kind == "heartpie" { return "You got a HEART PIE!|Your life energy has grown by one heart!" }
    if kind == "ember_courage" { return "You got the EMBER OF COURAGE!|The ember that makes things rise. Mother Starter kept it for four hundred years." }
    if kind == "pipe" { return "You got FENNEL'S PIPE!|A reed pipe that sounds like the grove. Its songs will come later..." }
    if kind == "bracelet" { return "You got the GUM BRACELET!|Now you can pull up bomb flowers: A picks one, A throws it, B puts it down." }
    if kind == "bombs" { return "You got POPCORN BOMBS!|Put them on a button. Press it to hold a bomb up, A to throw, B to set it down. Holds 20." }
    if kind == "ember_power" { return "You got the EMBER OF POWER!|The ember that transforms. Two Embers, and one to go." }
    if kind == "map_hardcaves" { return "You found the DUNGEON MAP!|See every room of Hardtack Caverns in the pause menu." }
    if kind == "compass_hardcaves" { return "You found the COMPASS!|Now the map shows the treasure and the boss." }
    if kind == "bosskey_hardcaves" { return "You got the BOSS KEY!|It opens the door to King Crustodon's lair." }
    if kind == "letter" { return "You got SAFFRON'S LETTER!|Signed by the princess herself. Show it to anyone who serves the royal family." }
    if kind == "song_lullaby" { return "You learned SAFFRON'S LULLABY!|A gentle royal song. Royal doors and old magic answer it." }
    if kind == "slice" { return "You found a PIE SLICE!|Collect four to make a whole new heart." }
    if kind == "bean20" { return "You got a RED BEAN!|It's worth 20 beans!" }
    if kind == "bean50" { return "You got a PURPLE BEAN!|It's worth 50 beans!" }
    return "You got " + item_name(kind) + "!"
}
