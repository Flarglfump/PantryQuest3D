@strict
# testsetup.bs - for trying an area on its own (the play-test bots put these at the top of
# a copy of an area): adds items and story flags to the journey before the Game starts.

var items: list = []
var flags: list = []
var spawn: string = ""
var clock: number = -1
var era: string = ""

func start() -> void {
    var s: list = global("save", [])
    if len(s) < 12 { s = [[], [], 12, 12, 0, 0, ["", "", ""], [], "", "start", 0, "fresh"] }
    var fl: list = s[0]
    var it: list = s[1]
    for f in flags { push(fl, f) }
    for i in items {
        if substr(i, 0, 4) == "key:" {
            push(s[7], ["keys_" + substr(i, 4), 1])
            continue
        }
        push(it, i)
        if i == "shooter" { s[5] = 30 }
        if i == "bombs" { push(s[7], ["bombs", 20]) }
        if i == "bow" { push(s[7], ["arrows", 30]) }
        if i == "pipe" { push(it, "song_fennel") }
        if i == "shooter" or i == "bombs" or i == "pipe" or i == "boomerang" or i == "jar1" or i == "lash" or i == "bow" or i == "hammer" {
            var slots: list = s[6]
            var placed: bool = false
            for k in 3 {
                if not placed and slots[k] == "" {
                    slots[k] = i
                    placed = true
                }
            }
        }
        if i == "heartpie" {
            s[3] = s[3] + 4
            s[2] = s[3]
        }
    }
    if spawn != "" { s[9] = spawn }
    if era != "" { s[11] = era }
    set_global("save", s)
    if clock >= 0 { set_global("clock", clock) }
}
