@strict @3d
# sprig.bs - the hero. A kinematic capsule moved with move_and_slide(); what you see is a
# child entity (Body: the skinned model) so it can turn, roll and spin without turning the
# capsule. The spoon and the pot-lid are children of the body, placed by this script for
# each move (on his back, drawn, swung, raised).
#
# Controls are actions (game.bs binds them): move, action (A: talk / open / climb / roll /
# hop / grab), attack (X: slash, combo, hold for a spin), focus (LT: lock on with Flicker;
# the camera's left / right moves it to the next thing that way), shield (RT: planted, turning
# on the spot - stepping about only while focused), item1..3 (LB, RB, Y), flicker (hints),
# song, boots, hover (the D-pad), map, pause. The Pea Shooter and the Skewer Bow aim first
# (look about, press the button again to shoot) unless something is focused.

const RUN: number = 5.2
const GRAVITY: number = 24
const SWIM_Y: number = 0.9         # how far under the surface he floats (his feet)
const HOP: number = 5.6            # the automatic hop off a ledge while running

var game: entity
var cam: entity
var body: entity
var weapon: entity
var lid: entity

var vel: vec3
var facing: number = 0             # yaw, degrees (0: looking down -z)
var st: string = "free"            # free slash charge spin roll hop jumpatk airatk hurt climb hold talk shoot aim grab dead
var st_t: number = 0
var combo: int = 0
var queued: bool = false
var hit_list: list = []
var charge: number = 0
var spin_angle: number = 0
var pitch: number = 0              # the body's tumble (rolls, back-flips)
var hop_dir: vec3
var drawn: number = 0              # seconds left with the spoon out
var invuln: number = 0
var flash: number = 0

var target: entity                 # what Flicker has focused on
var focusing: bool = false
var focus_yaw: number = 0

var was_floor: bool = true
var safe_pos: vec3
var safe_t: number = 0
var platform: entity
var plat_last: vec3

var vine: entity
var carrying: entity                # a bomb held over his head
var boomerang: entity               # the boomerang, while it's out
var water: entity                  # the water he's in (water.bs)
var lash_line: entity              # the Licorice Lash, while it's out
var hammer: entity                 # the Meat Tenderizer, while he swings it
var lash_to: vec3
var lash_tip: vec3
var lash_t: number = 0
var dive_t: number = 0
var under: bool = false            # his head under the water (the Cast-Iron Boots, or a dive)
var air: number = 8                # seconds of breath left under water (no Snorkel Apron)
var hover_t: number = 0            # time spent walking on air (the Meringue Boots)
var zone: entity                   # the way out he's standing in (it may wait for a story flag)
var action_label: string = ""      # what A does now (the HUD shows it)
var action_target: entity
var move_amount: number = 0
var shielding: bool = false
var hint_glow: bool = false
var at: vec3                       # (where he is: for the play-test bots)
var last_hurt: string = ""         # (what hurt him last: for the bots)
var aim_item: string = ""          # aiming the Pea Shooter or the Skewer Bow (st "aim")...
var aim_yaw: number = 0            # ... this way round (degrees, as facing)...
var aim_pitch: number = 0          # ... and this far up (degrees)
var grabbed: entity                # the crust block he's holding (st "grab")...
var grab_axis: vec3                # ... from him into it
var grab_t: number = 0
var switch_acc: number = 0         # the mouse moved sideways while focused (to switch target)
var motion: vec2 = vec2(0, 0)
var toggled: bool = false          # focused by a press, in the TARGETING: TOGGLE setting
var last_target: entity            # (the last thing focused on: taken up again by a held Focus)
var air_t: number = 0              # how long he has been off the ground
var lost_ok: bool = false          # (toggled on with nothing to target: it stays on without one)
var rs_was: number = 0             # the right stick's x a step ago
var shooter: entity                # the Pea Shooter in his hand, while aiming
var trail: entity                  # the streak at the spoon's tip (on while he swings)

func start() -> void {
    game = find("Game")
    cam = find("Camera")
    body = spawn("prefabs/sprig_body.scene", vec3(0, 0, 0), self)
    if game.era == "risen" {
        body.scale = vec3(1.3, 1.3, 1.3)              # seven years older
        weapon = spawn("prefabs/cleaver.scene", vec3(0, 0.6, 0.15), body)
    } else {
        weapon = spawn("prefabs/spoon.scene", vec3(0, 0.6, 0.15), body)
    }
    lid = spawn("prefabs/potlid.scene", vec3(0, 0.6, 0.18), body)
    trail = spawn("prefabs/swingtrail.scene", vec3(0, 0, -0.6), weapon)
    safe_pos = self.position
}

# The Game has moved him to a spawn point.
func placed() -> void {
    facing = self.rotation.y
    self.rotation = vec3(0, 0, 0)
    safe_pos = self.position
    vel = vec3(0, 0, 0)
    if cam != nil { cam.snap_behind() }
}

func forward_of(yaw: number) -> vec3 { return vec3(-sin(yaw), 0, -cos(yaw)) }
func yaw_of(d: vec3) -> number { return atan2(-d.x, -d.z) }
func head() -> vec3 { return self.position + vec3(0, 0.9, 0) }
func focus_point() -> vec3 { return self.position + vec3(0, 0.7, 0) }

func turn_to(yaw: number, rate: number, dt: number) -> void {
    var d: number = ((yaw - facing + 540) % 360) - 180
    var step: number = rate * dt
    if abs(d) <= step { facing = yaw } else { facing += sign(d) * step }
}

func has_spoon() -> bool { return game.has_item("spoon") or (game.era == "risen" and game.has_item("cleaver")) }
func has_lid() -> bool { return game.has_item("potlid") }

# ---- input ----
func stick_input() -> vec2 {
    var mv := vec2(action_axis("left", "right"), action_axis("up", "down"))
    var s: vec2 = stick("left")
    if length(s) > length(mv) { mv = s }
    if length(mv) > 1 { mv = normalize(mv) }
    return mv
}

func world_dir(mv: vec2) -> vec3 {
    var ahead: vec3 = cam.forward
    ahead.y = 0
    if length(ahead) < 0.01 { ahead = forward_of(facing) }
    ahead = normalize(ahead)
    var side := vec3(-ahead.z, 0, ahead.x)
    return side * mv.x - ahead * mv.y
}

# ---- focus ----
# Can e be focused on from here (in range, not behind his back unless close, in sight)?
func focusable(e: entity) -> bool {
    if not e.alive or has_tag(e, "hidden") { return false }
    var to: vec3 = e.global_position - self.position
    to.y = 0
    var d: number = length(to)
    var far: number = 11
    if has_tag(e, "hookable") and game.has_item("longlash") { far = 21 }
    if d > far or d < 0.05 { return false }
    return in_sight(e)
}

# The camera swung left (-1) or right (+1) while focused on something: the next thing that
# way round from it, seen from Sprig (the nearest turn that way), if there is one.
func switch_target(way: number) -> void {
    if target == nil { return }
    var now: vec3 = target.global_position - self.position
    var base: number = atan2(-now.x, -now.z)
    var best: entity = nil
    var best_turn: number = 999
    for e in find_tagged("focusable") {
        if e == target or not focusable(e) { continue }
        var to: vec3 = e.global_position - self.position
        var turn: number = ((atan2(-to.x, -to.z) - base + 540) % 360) - 180      # (+: to the left)
        turn = turn * -way                                                        # (+: the way asked)
        if turn > 2 and turn < best_turn {
            best_turn = turn
            best = e
        }
    }
    if best != nil {
        target = best
        play_sound("sfx/focus.wav", 0.5, 1.2)
    }
}

func drop_focus() -> void {
    target = nil
    focusing = false
    toggled = false
    play_sound("sfx/focus.wav", 0.35, 0.8)
}

func acquire() -> void {
    var best: entity = nil
    var best_score: number = 1000
    var fwd: vec3 = forward_of(facing)
    for e in find_tagged("focusable") {
        if not e.alive or has_tag(e, "hidden") { continue }
        var to: vec3 = e.global_position - self.position
        to.y = 0
        var d: number = length(to)
        var far: number = 11
        if has_tag(e, "hookable") and game.has_item("longlash") { far = 21 }
        if d > far or d < 0.05 { continue }
        var facing_dot: number = dot(normalize(to), fwd)
        if facing_dot < -0.3 and d > 3 { continue }
        if not in_sight(e) { continue }           # (not through a wall, or a floor)
        var score: number = d * (1.6 - facing_dot)
        if score < best_score {
            best_score = score
            best = e
        }
    }
    target = best
    focusing = true
    focus_yaw = facing
    if target != nil {
        play_sound("sfx/focus.wav", 0.5)
    } else {
        cam.snap_behind()
    }
}

# Shooting without focusing: if something to shoot (an eye, a web, a fire-bowl) is nearly
# straight ahead, the shot goes right at it - keys and sticks can't aim finer than that.
# (A torch on the way lights the pea as it passes.) If there's nothing, but a torch's flame
# close by, it goes through the flame.
func aim_assist(from: vec3, dir: vec3) -> vec3 {
    var best: number = 0.966                   # (within about 15 degrees; aiming, 8)
    if st == "aim" { best = 0.99 }
    var aim: vec3 = dir
    var flat: vec3 = normalize(vec3(dir.x, 0, dir.z))
    var found: bool = false
    for e in find_tagged("shootable") {
        var p2: vec3 = e.global_position
        var to2: vec3 = vec3(p2.x - from.x, 0, p2.z - from.z)
        if length(to2) < 0.5 or length(to2) > 18 { continue }
        var c2: number = dot(normalize(to2), flat)
        var seen: any = raycast(from, p2, self)          # (nothing solid in the way)
        if c2 > best and (seen == nil or seen[0] == e or distance(seen[1], p2) < 0.6) {
            best = c2
            aim = normalize(p2 - from)
            found = true
        }
    }
    if found { return aim }
    for t in find_tagged("torch") {
        if not t.lit { continue }
        var p: vec3 = t.flame_point()
        var to: vec3 = vec3(p.x - from.x, 0, p.z - from.z)
        if length(to) < 0.3 or length(to) > 4 { continue }
        var c: number = dot(normalize(to), flat)
        if c > best and abs(p.y - from.y) < 1.2 {
            best = c
            aim = normalize(to)
        }
    }
    return aim
}

# Whether Sprig can see e (nothing solid between his eyes and the point he'd aim at).
func in_sight(e: entity) -> bool {
    var eye: vec3 = self.position + vec3(0, 1.0, 0)
    var p: vec3 = e.focus_point()
    var hit: any = raycast(eye, p, self)
    if hit == nil or hit[0] == e { return true }
    return distance(hit[1], p) < 0.6
}

func target_point() -> vec3 { return target.focus_point() }

# ---- being hurt ----
# Something hurts Sprig: `quarters` of a heart, from a point, of a kind ("touch", "nut",
# "fire", "fall"...). Returns "blocked" (the shield took it), "hit" or "ignored".
func hurt(quarters: int, from: vec3, kind: string) -> string {
    if st == "dead" or invuln > 0 or game.state != "play" { return "ignored" }
    var to: vec3 = from - self.position
    to.y = 0
    if length(to) < 0.01 { to = forward_of(facing) }
    to = normalize(to)
    if shielding and kind != "fall" and kind != "unblockable" and dot(to, forward_of(facing)) > 0.35 {
        play_sound("sfx/block.wav", 0.7)
        vel = to * -3
        return "blocked"
    }
    invuln = 1.2
    flash = 1.2
    last_hurt = kind + " " + str(from)
    play_sound("sfx/hurt.wav", 0.8)
    shake_camera(2, 0.2)
    if game.damage(quarters) {
        die()
        return "hit"
    }
    st = "hurt"
    st_t = 0
    vel = to * -5 + vec3(0, 3, 0)
    play_animation(body, "hurt", 1, false)
    return "hit"
}

func die() -> void {
    st = "dead"
    st_t = 0
    vel = vec3(0, 0, 0)
    play_animation(body, "dead", 1, false)
    play_sound("sfx/dead.wav", 0.8)
}

# ---- fanfares and talks ----
func hold_up() -> void {
    st = "hold"
    st_t = 0
    vel = vec3(0, 0, 0)
    play_animation(body, "hold", 1, true)
}
func talk_ended() -> void {
    if st == "hold" or st == "talk" { st = "free" }
}

# A talk or a scene begins: out of whatever he was doing (a roll, a swing, a hop) and standing
# as he usually does - on a vine or in the water he stays as he is.
func stand_for_talk() -> void {
    if st == "hold" or st == "talk" or st == "climb" or st == "swim" or st == "dive" or st == "dead" { return }
    st = "talk"
    pitch = 0
    spin_angle = 0
    charge = 0
    combo = 0
    queued = false
    shielding = false
    vel = vec3(0, min(vel.y, 0), 0)
    play_animation(body, "idle", 1, true)
    animate()
}

# While the area waits under the text box (or a menu): stood ready for the talk, not frozen mid-roll.
func paused_update(dt: number) -> void {
    if game != nil and game.state == "talk" { stand_for_talk() }
}

# ---- the spoon ----
func start_slash(kind: string) -> void {
    st = kind
    st_t = 0
    hit_list = []
    queued = false
    drawn = 3
    var clip: string = "slash"
    if kind == "slash2" { clip = "slash2" }
    if kind == "thrust" { clip = "thrust" }
    play_animation(body, clip, 1, false)
    play_sound("sfx/swing.wav", 0.6, 0.9 + random() * 0.2)
}

# Attack in the air (off a ledge, a hop, a back-flip): the spoon up over his head and down,
# carrying on the way he was going - a hit on the way down and a heavier one as he lands.
var air_dir: vec3
func can_air_attack(on_floor: bool) -> bool {
    return action_pressed("attack") and has_spoon() and carrying == nil and not on_floor and air_t > 0.08 and st != "swim" and st != "dive"
}

func start_airatk() -> void {
    air_dir = vec3(vel.x, 0, vel.z)
    if length(air_dir) > 5 { air_dir = normalize(air_dir) * 5 }
    if target != nil { facing = yaw_of(target.global_position - self.position) }
    elif length(air_dir) > 0.5 { facing = yaw_of(air_dir) }
    st = "airatk"
    st_t = 0
    pitch = 0
    hit_list = []
    drawn = 3
    vel.y = max(vel.y, 3)                        # (a lift to swing in)
    play_animation(body, "jumpslash", 1.5, false)
    play_sound("sfx/jumpatk.wav", 0.6, 1.1)
}

# A low jab from behind the raised shield (attack while crouching): quick, and the shield
# stays up through it.
func start_crouchstab() -> void {
    st = "crouchstab"
    st_t = 0
    hit_list = []
    queued = false
    drawn = 3
    play_animation(body, "crouchstab", 1, false)
    play_sound("sfx/swing.wav", 0.5, 1.2 + random() * 0.15)
}

# Hits whatever is in a sphere (once per swing).
func strike(centre: vec3, radius: number, amount: int, kind: string) -> void {
    for e in overlap_sphere(centre, radius) {
        if e == self or contains(hit_list, e) { continue }
        push(hit_list, e)
        send(e, "hit", amount, kind, self.position)
    }
}

func damage() -> int {
    if game.era == "risen" { return 2 }                # the Cleaver of Dawn
    return 1
}

# ---- the C buttons ----
# Holding something up (a bomb): A throws it, B puts it down.
func carry(e: entity) -> void {
    carrying = e
    e.carried = true
    play_animation(body, "hold", 1, true)
}

func throw_held() -> void {
    if carrying == nil { return }
    var f: vec3 = forward_of(facing)
    if target != nil {
        var to: vec3 = target.global_position - self.position
        to.y = 0
        if length(to) > 0.1 { f = normalize(to) }
    }
    carrying.throw(f * (7 + move_amount * 3) + vec3(0, 5, 0))
    carrying = nil
    play_sound("sfx/swing.wav", 0.6, 0.7)
}

func use_item(name: string) -> void {
    if name == "bombs" {
        if carrying != nil { return }
        if game.count("bombs") <= 0 {
            play_sound("sfx/empty.wav", 0.6)
            return
        }
        game.add_count("bombs", -1)
        var b: entity = spawn("prefabs/bomb.scene", self.position + vec3(0, 1.3, 0))
        carry(b)
        play_sound("sfx/pop.wav", 0.5)
        return
    }
    if name == "pipe" {
        game.play_pipe()
        return
    }
    if name == "lash" {
        if lash_line != nil and lash_line.alive { return }
        var from: vec3 = self.position + vec3(0, 0.95, 0) + forward_of(facing) * 0.3
        var dir: vec3 = forward_of(facing)
        if target != nil { dir = normalize(target_point() - from) }
        var lash_len: number = 11
        if game.has_item("longlash") { lash_len = 22 }
        var hit: any = raycast(from, from + dir * lash_len, self)
        lash_tip = from + dir * lash_len
        lash_line = spawn("prefabs/lashline.scene", from)
        lash_t = 0
        play_sound("sfx/lunge.wav", 0.7, 1.3)
        st = "lashshot"
        st_t = 0
        play_animation(body, "aim", 1, false)
        if hit != nil {
            lash_tip = hit[1]
            if has_tag(hit[0], "hookable") {
                lash_to = hit[1] - dir * 0.45 - vec3(0, 0.75, 0)
                st = "lash"
                play_sound("sfx/thunk.wav", 0.8)
            } else {
                send(hit[0], "hit", 1, "lash", from)
                play_sound("sfx/tick.wav", 0.6)
            }
        }
        for p2 in find_tagged("pickup") {               # it fetches what it passes
            var rel: vec3 = p2.position - from
            var along: number = dot(rel, dir)
            if along > 0 and along < distance(from, lash_tip) and length(rel - dir * along) < 0.6 { p2.position = self.position + vec3(0, 0.5, 0) }
        }
        return
    }
    if name == "boots" {
        if game.flag("boots_on") { game.clear_flag("boots_on") } else {
            game.set_flag("boots_on")
            game.clear_flag("hover_on")
        }
        play_sound("sfx/thunk.wav", 0.8, 0.6)
        return
    }
    if name == "hover" {
        if game.flag("hover_on") { game.clear_flag("hover_on") } else {
            game.set_flag("hover_on")
            game.clear_flag("boots_on")
        }
        play_sound("sfx/bubble.wav", 0.8, 0.8)
        return
    }
    if name == "lens" {
        if game.flag("lens_on") { game.clear_flag("lens_on") } else { game.set_flag("lens_on") }
        play_sound("sfx/secret.wav", 0.4, 1.5)
        return
    }
    if name == "hammer" {
        st = "hammer"
        st_t = 0
        hit_list = []
        drawn = 3
        play_animation(body, "slash", 0.7, false)
        play_sound("sfx/swing.wav", 0.8, 0.6)
        return
    }
    if name == "bow" {
        if target == nil and st != "aim" {
            start_aim(name)
            return
        }
        if game.count("arrows") <= 0 {
            play_sound("sfx/empty.wav", 0.6)
            return
        }
        game.add_count("arrows", -1)
        var from2: vec3 = self.position + vec3(0, 1.0, 0) + forward_of(facing) * 0.4
        var dir2: vec3 = forward_of(facing)
        if target != nil { dir2 = normalize(target_point() - from2) } elif st == "aim" {
            from2 = aim_from()
            dir2 = aim_assist(from2, aim_dir())
        } else { dir2 = aim_assist(from2, dir2) }
        var ar: entity = spawn("prefabs/arrow.scene", from2)
        ar.dir = dir2
        ar.owner = self
        look_at(ar, from2 + dir2)
        play_sound("sfx/pea.wav", 0.7, 0.6)
        if st != "aim" {
            st = "shoot"
            st_t = 0
            play_animation(body, "aim", 1, false)
        }
        return
    }
    if name == "jar1" {
        if game.flag("jar1_fire") {
            for ice in find_tagged("redice") {
                var ip: vec3 = ice.global_position
                if distance(vec3(ip.x, 0, ip.z), vec3(self.x, 0, self.z)) < 1.6 + ice.scale.x * 0.5 + 1.0 and abs(ip.y - self.y) < 4 {
                    game.clear_flag("jar1_fire")
                    ice.melt()
                    return
                }
            }
            game.clear_flag("jar1_fire")                          # it puffs out
            spawn("prefabs/flame.scene", self.position + forward_of(facing) * 0.8)
            return
        }
        if not game.flag("jar1_fish") {
            for bf in find_tagged("bluefire") {
                if distance(bf.global_position, self.position) < 2.4 {
                    game.set_flag("jar1_fire")
                    play_sound("sfx/ignite.wav", 0.7, 1.4)
                    game.talk("got_bluefire", "")
                    return
                }
            }
        }
        if game.flag("jar1_fish") {
            for g in find_tagged("fishfeed") {                   # (Lord Gulp's altar, in reach)
                if distance(g.global_position, self.position) < g.reach {
                    g.fed(self)
                    return
                }
            }
            game.clear_flag("jar1_fish")                          # let it go
            var f2: entity = spawn("prefabs/fish.scene", self.position + forward_of(facing) * 0.8 + vec3(0, 0.1, 0))
            play_sound("sfx/splash.wav", 0.5)
            return
        }
        st = "shoot"
        st_t = 0
        play_animation(body, "slash", 1.4, false)
        play_sound("sfx/swing.wav", 0.6, 0.8)
        var at2: vec3 = self.position + forward_of(facing) * 0.8
        for f in find_tagged("fish") {
            if distance(vec3(f.x, 0, f.z), vec3(at2.x, 0, at2.z)) < 1.0 and abs(f.y - self.y) < 1.2 {
                destroy(f)
                game.set_flag("jar1_fish")
                game.talk("got_fish", "")
                return
            }
        }
        return
    }
    if name == "boomerang" {
        if boomerang != nil and boomerang.alive { return }
        var from: vec3 = self.position + vec3(0, 0.8, 0) + forward_of(facing) * 0.4
        var b: entity = spawn("prefabs/boomerang.scene", from)
        b.owner = self
        if target != nil {
            b.goal = target_point()
            b.aim = target
        } else {
            b.goal = from + forward_of(facing) * 9
        }
        boomerang = b
        play_sound("sfx/swing.wav", 0.7, 1.2)
        st = "shoot"
        st_t = 0
        play_animation(body, "slash", 1.2, false)
        return
    }
    if name == "shooter" {
        if target == nil and st != "aim" {
            start_aim(name)
            return
        }
        if game.peas <= 0 {
            play_sound("sfx/empty.wav", 0.6)
            return
        }
        game.peas = game.peas - 1
        game.commit()
        var from: vec3 = self.position + vec3(0, 0.75, 0) + forward_of(facing) * 0.4
        var dir: vec3 = forward_of(facing)
        if target != nil { dir = normalize(target_point() - from) } elif st == "aim" {
            from = aim_from()
            dir = aim_assist(from, aim_dir())
        } else { dir = aim_assist(from, dir) }
        var p: entity = spawn("prefabs/pea.scene", from)
        p.dir = dir
        p.owner = self
        play_sound("sfx/pea.wav", 0.6)
        if st != "aim" {
            st = "shoot"
            st_t = 0
            play_animation(body, "aim", 1, false)
        }
    }
}

# ---- every step ----
func update(dt: number) -> void {
    motion = mouse_motion()                  # (the mouse's move this frame: taken once, used below and in update_aim)
    invuln = max(0, invuln - dt)
    flash = max(0, flash - dt)
    drawn = max(0, drawn - dt)
    st_t += dt
    var playing: bool = game.state == "play"
    var mv: vec2 = vec2(0, 0)
    if playing { mv = stick_input() }
    move_amount = length(mv)
    var dir: vec3 = world_dir(mv)

    # focus (hold to keep it)
    # (the SETTINGS page's TARGETING: "hold" keeps the focus while Focus is held, as in the
    # later games; "toggle" keeps it after a press - on a target, or on nothing - until the next
    # press, as in Ocarina)
    var toggle: bool = global("target_toggle", false)
    if playing and action_pressed("focus") and st != "dead" and st != "aim" {
        if toggle and toggled and target != nil {
            drop_focus()
        } elif toggle and toggled {
            acquire()                          # (focused on nothing: a press takes a target if there's one now,
            if target == nil { drop_focus() }  # or lets the focus go)
            else { lost_ok = false }
        } else {
            acquire()
            toggled = toggle                   # (TOGGLE: on until the next press, with a target or without)
            lost_ok = target == nil
        }
    }
    if not toggle { toggled = false }
    # HOLD: focused all the while Focus is held - if it was let go of anyhow (a talk, a cutscene,
    # a press missed), holding it is enough to take it up again, on the same target if it's there
    if playing and not toggle and action_down("focus") and not focusing and st != "dead" and st != "aim" {
        var was: entity = last_target
        acquire()
        if was != nil and was.alive and focusable(was) { target = was }
    }
    if (not action_down("focus") and not toggled) or not playing {
        target = nil
        focusing = false
        toggled = false
    }
    # focused on something: the camera's left / right (keys, right stick, mouse) moves to the next
    if target != nil and playing {
        var way: number = 0
        if action_pressed("cam_left") { way = -1 }
        if action_pressed("cam_right") { way = 1 }
        var rx: number = stick("right").x
        if rx < -0.6 and rs_was >= -0.6 { way = -1 }
        if rx > 0.6 and rs_was <= 0.6 { way = 1 }
        if mouse_locked() {
            switch_acc = switch_acc * max(0, 1 - dt * 4) + motion.x      # (a flick sideways, in game pixels: like the right stick's)
            if switch_acc < -14 { way = -1 }
            if switch_acc > 14 { way = 1 }
        }
        if way != 0 {
            switch_acc = 0
            switch_target(way)
        }
    } else {
        switch_acc = 0
    }
    rs_was = stick("right").x
    var keep: number = 15
    if target != nil and target.alive and has_tag(target, "hookable") { keep = 23 }
    if target != nil and (not target.alive or has_tag(target, "hidden") or distance(target.global_position, self.position) > keep) {
        target = nil
    }
    if target != nil { last_target = target }
    if toggled and target == nil and not lost_ok {     # (a toggled focus on a target ends with it: gone, or too far)
        toggled = false
        focusing = action_down("focus")
    }

    var on_floor: bool = is_on_floor(self)
    if on_floor { air_t = 0 } else { air_t += dt }
    shielding = false
    var want := vec3(0, 0, 0)      # horizontal speed wanted

    if st == "dead" {
        if st_t > 1.6 and game.state == "play" { game.game_over() }
    } elif not playing {
        # a talk or a scene begins: out of whatever he was doing (a roll, a swing, a hop) and
        # standing as he usually does - on a vine or in the water he stays as he is
        stand_for_talk()
    } elif st == "talk" {
        st = "free"
    }

    # into deep water: swimming
    var wet: bool = water != nil and water.alive and self.y < water.surface - SWIM_Y - 0.05
    var heavy: bool = game.flag("boots_on")
    if heavy and (st == "swim" or st == "dive") {
        st = "free"
        pitch = 0
    }
    if wet and heavy {
        wet = false                                   # the Cast-Iron Boots: he sinks, and walks the bottom
    }
    under = water != nil and water.alive and self.y + 1.1 < water.surface
    if under and not game.has_item("snorkel") and game.state == "play" and st != "dead" {
        air -= dt
        if air <= 0 {
            air = 2
            hurt(2, self.position, "unblockable")
        }
    } else {
        air = min(8, air + dt * 4)
    }
    if wet and st != "swim" and st != "dive" and st != "dead" and st != "climb" and st != "hold" and st != "talk" {
        st = "swim"
        st_t = 0
        pitch = 0
        spin_angle = 0
        drawn = 0
        play_sound("sfx/splash.wav", 0.6)
        spawn("prefabs/poof.scene", vec3(self.x, water.surface, self.z))
        if carrying != nil and carrying.alive {
            carrying.put_down(self.position + vec3(0, 0.3, 0))
            carrying = nil
        }
    }

    if st == "free" {
        update_free(dt, mv, dir, on_floor)
        want = vel_want(dir, mv)
    } elif st == "swim" or st == "dive" {
        want = update_swim(dt, mv, dir, on_floor)
    } elif st == "aim" {
        update_aim(dt, mv)
    } elif st == "grab" {
        update_grab(dt, dir)
    } elif st == "slash" or st == "slash2" or st == "thrust" {
        want = forward_of(facing) * max(0, 2 - st_t * 8)
        if target != nil { turn_to(yaw_of(target.global_position - self.position), 900, dt) }
        if action_pressed("attack") and st_t > 0.05 { queued = true }
        if st_t > 0.05 and st_t < 0.2 {
            var reach: number = 0.75
            if st == "thrust" { reach = 0.95 }
            strike(self.position + vec3(0, 0.6, 0) + forward_of(facing) * reach, 0.7, damage(), "blade")
        }
        if st_t >= 0.3 {
            if queued {
                combo += 1
                if combo == 1 { start_slash("slash2") } elif combo == 2 { start_slash("thrust") } else {
                    combo = 0
                    start_slash("slash")
                }
            } elif action_down("attack") {
                st = "charge"
                st_t = 0
                charge = 0
                combo = 0
            } else {
                st = "free"
                combo = 0
            }
        }
    } elif st == "crouchstab" {
        shielding = has_lid() and action_down("shield")
        if action_pressed("attack") and st_t > 0.08 { queued = true }
        if st_t > 0.04 and st_t < 0.15 {
            strike(self.position + vec3(0, 0.35, 0) + forward_of(facing) * 0.95, 0.55, damage(), "blade")
        }
        if st_t >= 0.25 {
            st = "free"
            if queued and shielding { start_crouchstab() }     # (again, as fast as he's asked)
        }
    } elif st == "charge" {
        charge += dt
        drawn = 3
        if move_amount > 0.1 {
            want = dir * 1.6
            if target == nil { turn_to(yaw_of(dir), 400, dt) }
        }
        if target != nil { turn_to(yaw_of(target.global_position - self.position), 900, dt) }
        play_animation(body, "charge", 1, true)
        if not action_down("attack") {
            if charge >= 0.6 {
                st = "spin"
                st_t = 0
                hit_list = []
                spin_angle = 0
                play_animation(body, "spin", 1, true)
                play_sound("sfx/spin.wav", 0.8)
            } else {
                st = "free"
            }
        }
    } elif st == "spin" {
        spin_angle = st_t / 0.45 * 360
        strike(self.position + vec3(0, 0.6, 0), 1.9, damage() * 2, "spin")
        if st_t >= 0.45 {
            st = "free"
            spin_angle = 0
        }
    } elif st == "roll" {
        want = forward_of(facing) * 7.0 * max(0.3, 1 - st_t * 1.2)
        pitch = -st_t / 0.45 * 360
        var front: entity = nil
        if is_on_wall(self) and st_t > 0.08 { front = wall_thing() }     # (not a lip in the ground)
        if front != nil {
            # whatever he rolled into: two pots side by side both break
            var bonked: list = overlap_sphere(self.position + forward_of(facing) * 0.55 + vec3(0, 0.45, 0), 0.5)
            if not contains(bonked, front) { push(bonked, front) }
            for b in bonked {
                if b != self and b.alive { send(b, "bonked", self.position) }
            }
            play_sound("sfx/bonk.wav", 0.6)
            shake_camera(1.5, 0.15)
            st = "hurt"
            st_t = 0.1
            vel = forward_of(facing) * -3 + vec3(0, 2.5, 0)
            pitch = 0
        }
        if st_t >= 0.45 {
            st = "free"
            pitch = 0
        }
    } elif (st == "hop" or st == "backflip") and can_air_attack(on_floor) {
        start_airatk()
    } elif st == "hop" {
        want = hop_dir * 5.5
        if target != nil { turn_to(yaw_of(target.global_position - self.position), 900, dt) }
        if st_t > 0.12 and on_floor {
            st = "free"
            pitch = 0
        }
    } elif st == "backflip" {
        want = hop_dir * 4.5
        pitch = min(1, st_t / 0.45) * 360
        if st_t > 0.12 and on_floor {
            st = "free"
            pitch = 0
        }
    } elif st == "jumpatk" {
        want = forward_of(facing) * 5.5
        if st_t > 0.12 and on_floor {
            strike(self.position + vec3(0, 0.5, 0) + forward_of(facing) * 0.8, 1.0, damage() * 2, "jump")
            shake_camera(1.5, 0.15)
            play_sound("sfx/land.wav", 0.7)
            st = "slash"
            st_t = 0.2
        }
    } elif st == "airatk" {
        # the midair attack: carried on as he was going, the spoon over his head and down;
        # it hits on the way down, and again (harder) as he lands
        want = air_dir
        if st_t > 0.1 and st_t < 0.3 {
            strike(self.position + vec3(0, 0.4, 0) + forward_of(facing) * 0.75, 0.8, damage(), "blade")
        }
        if st_t > 0.08 and on_floor {
            strike(self.position + vec3(0, 0.5, 0) + forward_of(facing) * 0.8, 1.0, floor(damage() * 1.5), "jump")
            shake_camera(1.0, 0.12)
            play_sound("sfx/land.wav", 0.6)
            st = "slash"
            st_t = 0.2
        } elif st_t > 1.5 {
            st = "free"                          # (a long way down: just falling)
        }
    } elif st == "hurt" {
        want = vec3(vel.x, 0, vel.z) * 0.9
        if st_t >= 0.45 { st = "free" }
    } elif st == "shoot" {
        if target != nil { turn_to(yaw_of(target.global_position - self.position), 900, dt) }
        if st_t >= 0.3 { st = "free" }
    } elif st == "climb" {
        update_climb(dt, mv)
    } elif st == "hammer" {
        if target != nil { turn_to(yaw_of(target.global_position - self.position), 600, dt) }
        if st_t > 0.28 and st_t - dt <= 0.28 {
            strike(self.position + vec3(0, 0.3, 0) + forward_of(facing) * 1.0, 1.1, 3, "hammer")
            shake_camera(2.5, 0.25)
            play_sound("sfx/smash.wav", 0.8, 0.7)
            spawn("prefabs/poof.scene", self.position + forward_of(facing) * 1.0)
        }
        if st_t >= 0.6 { st = "free" }
    } elif st == "lashshot" {
        if target != nil { turn_to(yaw_of(target.global_position - self.position), 900, dt) }
        if st_t >= 0.45 { st = "free" }
    } elif st == "lash" {
        var to2: vec3 = lash_to - self.position
        if length(to2) < 0.35 or st_t > 2.2 or (st_t > 0.15 and is_on_wall(self) and length(to2) < 1.6) {
            st = "free"
            vel = vec3(0, 3, 0)
            var flat: vec3 = vec3(to2.x, 0, to2.z)
            if length(flat) > 0.05 and is_on_wall(self) {
                var over: vec3 = self.position + vec3(0, 0.9, 0) + normalize(flat) * 0.6       # up over the lip
                if raycast(self.position + vec3(0, 0.9, 0), over + vec3(0, 0.5, 0), self) == nil {
                    var down: any = raycast(over + vec3(0, 0.5, 0), over + vec3(0, -1.5, 0), self)
                    if down != nil { self.position = down[1] + vec3(0, 0.05, 0) }
                }
            }
        }
    }

    # moving
    if st == "lash" {
        var d2: vec3 = lash_to - self.position
        if length(d2) > 0.01 { vel = normalize(d2) * min(17, length(d2) / max(dt, 0.001)) }
        vel = move_and_slide(self, vel)
        safe_t = 0
    } elif st != "climb" {
        if st == "hurt" or st == "hold" or st == "talk" or st == "dead" {
            vel.x = vel.x * max(0, 1 - dt * 6)
            vel.z = vel.z * max(0, 1 - dt * 6)
            if st == "hurt" { vel.x = want.x; vel.z = want.z }
        } else {
            vel.x = want.x
            vel.z = want.z
        }
        if (st == "swim" or st == "dive" or ((st == "hold" or st == "talk" or st == "hurt") and wet)) and water != nil and water.alive {
            if st != "dive" { vel.y = clamp((water.surface - SWIM_Y - self.y) * 4, -3, 4) }
        } elif heavy and water != nil and water.alive and self.y < water.surface {
            vel.y -= GRAVITY * 0.5 * dt                  # sinking slowly in the boots
            vel.x = vel.x * 0.6
            vel.z = vel.z * 0.6
        } elif game.flag("hover_on") and not on_floor and hover_t < 0.9 and st == "free" and vel.y <= 0.5 {
            hover_t += dt                                 # the Meringue Boots: a moment's walk on air
            vel.y = 0
        } else {
            vel.y -= GRAVITY * dt
        }
        if on_floor { hover_t = 0 }
        if on_floor and vel.y < -2 { vel.y = -2 }
        # going down a slope: down with it, as fast as it falls away under him (else he leaves it
        # every step, and stutters in the air, and can't roll)
        var downhill: bool = false
        if (on_floor or was_floor) and vel.y <= 0 and st != "swim" and st != "dive" {
            var under: any = raycast(self.position + vec3(0, 0.3, 0), self.position + vec3(0, -0.6, 0), self)
            if under != nil and under[2].y > 0.6 {
                var follow: number = -(under[2].x * vel.x + under[2].z * vel.z) / under[2].y
                if follow < 0 {
                    vel.y = min(vel.y, follow - 0.5)
                    downhill = true
                }
            }
        }
        carry_on_platform()
        vel = move_and_slide(self, vel)
        var now_floor: bool = is_on_floor(self)
        if downhill and not now_floor {             # (still left it, over a bump: back down on to it)
            var below: any = raycast(self.position + vec3(0, 0.2, 0), self.position + vec3(0, -0.5, 0), self)
            if below != nil and below[2].y > 0.6 {
                self.position = vec3(self.x, below[1].y + 0.01, self.z)
                now_floor = true
            }
        }
        if was_floor and not now_floor and vel.y <= 0.5 and (st == "free" or st == "roll") and length(vec2(vel.x, vel.z)) > 3.6 and ledge_ahead() and not game.flag("hover_on") {
            if st == "roll" {                           # (rolling off: up out of the roll into the hop)
                st = "free"
                pitch = 0
            }
            vel.y = HOP                                 # off a ledge at a run: a hop
            play_sound("sfx/hop.wav", 0.5)
            play_animation(body, "jump", 1, false)
        }
        was_floor = now_floor
        if now_floor and st == "free" and platform == nil {
            safe_t += dt
            if safe_t > 0.25 {
                safe_pos = self.position
                safe_t = 0
            }
        }
    }
    if self.y < game.kill_y and st != "dead" { fell() }
    if zone != nil and zone.alive and playing and st != "dead" { zone.entered(self) }

    at = self.position
    if carrying != nil and carrying.alive and carrying.carried {
        var lift: number = 0.2                         # (a bomb's half: it sits on his raised hands)
        if has_tag(carrying, "weight") { lift = 0.05 }
        var hp: vec3 = hands_point()
        carrying.position = vec3(self.x, max(hp.y, self.y + 0.9) + lift, self.z) + forward_of(facing) * 0.05
        if st == "hurt" or st == "dead" or st == "climb" {
            carrying.put_down(self.position + vec3(0, 0.3, 0))
            carrying = nil
        }
    }
    if lash_line != nil and lash_line.alive {
        lash_t += dt
        var hand: vec3 = self.position + vec3(0, 0.95, 0) + forward_of(facing) * 0.3
        var tip: vec3 = lash_tip
        if st != "lash" {
            var out_frac: number = min(1, lash_t / 0.15)
            if lash_t > 0.25 { out_frac = max(0, 1 - (lash_t - 0.25) / 0.2) }
            tip = lerp(hand, lash_tip, out_frac)
            if lash_t > 0.45 { destroy(lash_line) }
        }
        if lash_line.alive {
            var L: number = max(0.05, distance(hand, tip))
            lash_line.position = (hand + tip) * 0.5
            look_at(lash_line, tip)
            lash_line.scale = vec3(0.06, 0.06, L)
            if st != "lash" and st != "lashshot" and lash_t > 0.45 { destroy(lash_line) }
        }
    }
    update_context()
    place_gear(dt)
    animate()
    if playing and action_pressed("flicker") { game.talk("flicker", "") }
    # the D-pad: a song on the pipe, the Cast-Iron Boots, the Meringue Boots
    if playing and st != "dead" and (st == "free" or st == "swim") {
        if action_pressed("song") {
            if game.has_item("pipe") { game.play_pipe() } else { play_sound("sfx/empty.wav", 0.5) }
        }
        if action_pressed("boots") {
            if game.has_item("boots") { use_item("boots") } else { play_sound("sfx/empty.wav", 0.5) }
        }
        if action_pressed("hover") {
            if game.has_item("hover") { use_item("hover") } else { play_sound("sfx/empty.wav", 0.5) }
        }
    }
}

# Shield up without focusing: down behind it, turning on the spot (focusing: stepping about).
func crouching() -> bool { return shielding and not focusing and target == nil }

func vel_want(dir: vec3, mv: vec2) -> vec3 {
    var speed: number = RUN
    if focusing { speed = 4.2 }
    if shielding {
        if not focusing { return vec3(0, 0, 0) }   # (shield up: planted, turning on the spot...)
        speed = SHIELD_WALK                        # (... and only focused does he step about behind it)
    }
    return dir * speed * move_amount
}

func update_free(dt: number, mv: vec2, dir: vec3, on_floor: bool) -> void {
    if has_lid() and action_down("shield") and on_floor {
        shielding = true
        drawn = 3
    }
    # facing (behind the shield, unfocused, the stick turns him on the spot; focused he keeps
    # facing ahead, or what's focused, and steps aside or back)
    if target != nil {
        turn_to(yaw_of(target.global_position - self.position), 900, dt)
    } elif focusing {
        turn_to(focus_yaw, 900, dt)
    } elif move_amount > 0.1 and shielding {
        turn_to(yaw_of(dir), 300, dt)
    } elif move_amount > 0.1 {
        turn_to(yaw_of(dir), 720, dt)
    }
    if carrying != nil and carrying.alive {
        if action_pressed("action") {
            throw_held()
            return
        }
        if action_pressed("attack") {
            carrying.put_down(self.position + forward_of(facing) * 0.7 + vec3(0, 0.2, 0))
            carrying = nil
            return
        }
    } elif carrying != nil {
        carrying = nil
    }
    if action_pressed("action") {
        if action_target != nil {
            action_target.interact(self)
            return
        }
        if focusing and move_amount > 0.3 and on_floor {
            var local_fwd: number = dot(dir, forward_of(facing))
            if local_fwd > 0.6 and has_spoon() {                  # (focused - something to hit there or not)
                st = "jumpatk"
                st_t = 0
                vel.y = 6
                drawn = 3
                play_animation(body, "jumpslash", 1, false)      # (up over his head, and down as he lands)
                play_sound("sfx/jumpatk.wav", 0.7)
            } elif local_fwd < -0.6 {
                st = "backflip"
                st_t = 0
                hop_dir = forward_of(facing) * -1
                vel.y = 6.5
                play_animation(body, "jump", 1, false)
                play_sound("sfx/hop.wav", 0.6)
            } else {
                st = "hop"
                st_t = 0
                hop_dir = normalize(dir - forward_of(facing) * local_fwd)
                vel.y = 5
                play_animation(body, "jump", 1, false)
                play_sound("sfx/hop.wav", 0.6)
            }
            return
        }
        if move_amount > 0.3 and on_floor {
            st = "roll"
            st_t = 0
            if target == nil { facing = yaw_of(dir) }
            play_animation(body, "roll", 1, true)
            play_sound("sfx/roll.wav", 0.6)
            return
        }
    }
    if can_air_attack(on_floor) {
        start_airatk()                           # (off the ground: over his head and down)
        return
    }
    if action_pressed("attack") and has_spoon() and carrying == nil and crouching() {
        start_crouchstab()                       # (crouched behind the shield: a low jab past it)
        return
    }
    if action_pressed("attack") and has_spoon() and carrying == nil {
        combo = 0
        if focusing and move_amount > 0.3 and dot(dir, forward_of(facing)) > 0.6 { start_slash("thrust") } else { start_slash("slash") }
        return
    }
    for i in 3 {
        if action_pressed("item" + (i + 1)) and game.slots[i] != "" {
            use_item(game.slots[i])
            return
        }
    }
    if vine != nil and move_amount > 0.3 and dot(dir, vine.out * -1) > 0.6 and vine.reachable(self.position) {
        st = "climb"
        st_t = 0
        facing = yaw_of(vine.out * -1)
        play_animation(body, "climb", 1, true)
    }
}

# Swimming: slow strokes at the surface; A dives (hold it to go deeper, as deep as he can:
# deeper with the Fizz Bubble). Swim into a low bank or ledge and he climbs out.
func update_swim(dt: number, mv: vec2, dir: vec3, on_floor: bool) -> vec3 {
    if water == nil or not water.alive {
        st = "free"
        pitch = 0
        return vec3(0, 0, 0)
    }
    if move_amount > 0.1 { turn_to(yaw_of(dir), 300, dt) }
    var deepest: number = 3.0
    if game.has_item("fizzbubble") { deepest = 8.5 }
    if st == "swim" {
        pitch = -20 * move_amount
        if on_floor and self.y > water.surface - SWIM_Y - 0.4 {
            st = "free"                      # walked out into the shallows
            pitch = 0
            return vec3(0, 0, 0)
        }
        if action_pressed("boots") and game.has_item("boots") {
            use_item("boots")
            return vec3(0, 0, 0)
        }
        if action_pressed("action") and game.state == "play" {
            st = "dive"
            dive_t = 0
            vel.y = -4.5
            play_sound("sfx/dive.wav", 0.6)
            return forward_of(facing) * 1.5
        }
        if move_amount > 0.3 and is_on_wall(self) {
            # up on to the bank: somewhere flat enough to stand, a little way in (not on the
            # bank's steep face, where he'd only slide back in)
            for reach in [0.7, 1.0, 1.4, 1.8] {
                var from: vec3 = self.position + forward_of(facing) * reach + vec3(0, SWIM_Y + 1.6, 0)
                var bank: any = raycast(from, vec3(from.x, water.surface - 0.6, from.z), self)
                if bank != nil and bank[1].y - water.surface < 1.5 and bank[1].y > water.surface - 0.2 and bank[2].y > 0.75 {
                    self.position = bank[1] + vec3(0, 0.1, 0)
                    st = "free"
                    pitch = 0
                    vel = vec3(0, 0, 0)
                    play_sound("sfx/hop.wav", 0.5)
                    return vec3(0, 0, 0)
                }
            }
        }
        if move_amount > 0.1 { play_animation(body, "run", 0.5, true) } else { play_animation(body, "idle", 0.6, true) }
        return dir * 3.2 * move_amount
    }
    # diving
    dive_t += dt
    pitch = -70
    play_animation(body, "jump", 1, true)
    var depth: number = water.surface - SWIM_Y - self.y
    if action_down("action") and depth < deepest and dive_t < 3.5 and not on_floor {
        vel.y = -4.5
    } else {
        vel.y = min(vel.y + 12 * dt, 3.5)
        if depth <= 0.05 {
            st = "swim"
            pitch = 0
            play_sound("sfx/bubble.wav", 0.5)
        }
    }
    return dir * 2.4 * move_amount
}

# ---- aiming (the Pea Shooter, the Skewer Bow), as the old adventures had it: he stands
# still and looks along the shot - the stick, the right stick or the mouse turn him and tilt
# the aim - and the item's button shoots. Action, attack, shield or focus put it away. ----
func start_aim(name: string) -> void {
    if st != "free" and st != "shoot" { return }
    aim_item = name
    aim_yaw = facing
    aim_pitch = 0
    st = "aim"
    st_t = 0
    vel = vec3(0, vel.y, 0)
    play_animation(body, "aim", 1, true)
    play_sound("sfx/focus.wav", 0.4, 0.8)
}

func aim_dir() -> vec3 {
    var f: vec3 = forward_of(aim_yaw)
    return normalize(f * cos(aim_pitch) + vec3(0, sin(aim_pitch), 0))
}
func aim_from() -> vec3 { return self.position + vec3(0, 0.8, 0) + forward_of(aim_yaw) * 0.35 }

func update_aim(dt: number, mv: vec2) -> void {
    vel = vec3(0, vel.y, 0)
    var turn: number = mv.x * 90 * dt
    var tilt: number = -mv.y * 60 * dt
    var rs: vec2 = stick("right")
    if abs(rs.x) > 0.15 { turn += rs.x * 110 * dt }
    if abs(rs.y) > 0.15 { tilt -= rs.y * 80 * dt }
    if mouse_locked() {
        var mm: vec2 = motion
        turn += mm.x * 0.35
        tilt -= mm.y * 0.35
    }
    turn += action_axis("cam_left", "cam_right") * 90 * dt
    aim_yaw -= turn
    aim_pitch = clamp(aim_pitch + tilt, -45, 60)
    facing = aim_yaw
    if st_t < 0.1 { return }                       # (not the press that started it)
    for i in 3 {
        if action_pressed("item" + (i + 1)) {
            var it: string = game.slots[i]
            if it == aim_item { use_item(it) } elif it == "shooter" or it == "bow" {
                aim_item = it                      # (the other one, aimed the same way)
                use_item(it)
            } else {
                st = "free"
                if it != "" { use_item(it) }
            }
            return
        }
    }
    if action_pressed("action") or action_pressed("attack") or action_pressed("shield") or action_pressed("focus") {
        st = "free"
        play_sound("sfx/menu.wav", 0.3, 0.8)
    }
}

# ---- holding a crust block (pushblock.bs): stick away from it pushes, towards him pulls;
# letting go of Action lets go ----
func grab(block: entity, axis: vec3) -> void {
    grabbed = block
    grab_axis = axis
    grab_t = 0
    st = "grab"
    st_t = 0
    facing = yaw_of(axis)
    vel = vec3(0, 0, 0)
    play_sound("sfx/thunk.wav", 0.4, 1.3)
}

func update_grab(dt: number, dir: vec3) -> void {
    if grabbed == nil or not grabbed.alive or not action_down("action") {
        if grabbed == nil or not grabbed.alive or grabbed.sliding < 0 {
            st = "free"
            grabbed = nil
            return
        }
    }
    facing = yaw_of(grab_axis)
    var hold: vec3 = grabbed.hold_point(grab_axis, self.y)
    if grabbed.sliding >= 0 {
        self.position = hold                       # (going with it)
        grab_t = 0
        return
    }
    self.position = lerp(self.position, hold, min(1, dt * 12))
    var along: number = dot(dir, grab_axis) * move_amount
    if abs(along) < 0.5 {
        grab_t = 0
        return
    }
    grab_t += dt
    if grab_t < 0.2 { return }
    grab_t = -0.6                                   # (once a step, with a moment between)
    grabbed.try_move(grab_axis, along < 0, self)
}

const CLIMB_GAP: number = 0.45        # how far from the wall he climbs (his middle; the vines are drawn 0.15 out)

const SHIELD_WALK: number = 2.4      # how fast he steps with the shield up

func update_climb(dt: number, mv: vec2) -> void {
    if vine == nil {
        st = "free"
        return
    }
    var up: number = -mv.y
    var side: vec3 = vec3(vine.out.z, 0, -vine.out.x)       # (his right, facing the vine)
    # he holds on at arm's length from the wall: not drifting in or out, whatever is behind
    var wall: vec3 = vine.global_position - vine.out * 0.45
    var gap: number = dot(self.position - wall, vine.out)
    var v: vec3 = vec3(0, up * 1.8, 0) + side * (mv.x * 1.4) + vine.out * ((CLIMB_GAP - gap) * 8)
    vel = move_and_slide(self, v)
    if abs(up) > 0.1 or abs(mv.x) > 0.1 { play_animation(body, "climb", 1, true) } else { stop_animation(body) }
    if self.y >= vine.top - 0.05 and up > 0 {
        # up over the top: on to the ledge, well in from its edge
        self.position = vec3(self.x, vine.top + 0.1, self.z) + vine.out * -(gap + 0.55)
        st = "free"
        vel = vec3(0, 0, 0)
    } elif up < 0 and is_on_floor(self) {
        st = "free"
    } elif action_pressed("action") {
        st = "free"                                   # let go
        vel = vine.out * 2
    }
}

# What he's up against, straight ahead or a little to either side (between two pots, the
# middle ray can miss both); nil if nothing is found.
func wall_thing() -> entity {
    var from: vec3 = self.position + vec3(0, 0.4, 0)
    var f: vec3 = forward_of(facing)
    var side := vec3(-f.z, 0, f.x) * 0.3
    for off in [vec3(0, 0, 0), side, side * -1] {
        var hit: any = raycast(from + off, from + off + f * 0.8, self)
        if hit != nil { return hit[0] }
    }
    return nil
}

# Is there a real drop just ahead (not a bump or a dip)?
func ledge_ahead() -> bool {
    var from: vec3 = self.position + forward_of(facing) * 0.5 + vec3(0, 0.3, 0)
    var hit: any = raycast(from, from + vec3(0, -1.1, 0), self)
    return hit == nil
}

func carry_on_platform() -> void {
    var hit: any = raycast(self.position + vec3(0, 0.3, 0), self.position + vec3(0, -0.25, 0), self)
    var under: entity = nil
    if hit != nil and has_tag(hit[0], "platform") { under = hit[0] }
    if under != nil {
        if under == platform {
            var d: vec3 = under.global_position - plat_last
            self.position = self.position + d
        }
        plat_last = under.global_position
    }
    platform = under
}

func burned() -> void {
    play_sound("sfx/sizzle.wav", 0.8)
    self.position = safe_pos + vec3(0, 0.2, 0)
    vel = vec3(0, 0, 0)
    st = "free"
    pitch = 0
    cam.snap_behind()
    hurt(4, self.position, "fall")
}

func fell() -> void {
    self.position = safe_pos + vec3(0, 0.2, 0)
    vel = vec3(0, 0, 0)
    st = "free"
    pitch = 0
    game.fade = 1
    cam.snap_behind()
    hurt(2, self.position, "fall")
}

func on_trigger(other: entity) -> void {
    if has_tag(other, "climbable") { vine = other }
    if has_tag(other, "pit") and st != "dead" { fell() }
    if has_tag(other, "lava") and st != "dead" { burned() }
    if has_tag(other, "loadzone") { zone = other }
    if has_tag(other, "water") { water = other }
}
func on_trigger_exit(other: entity) -> void {
    if other == vine { vine = nil }
    if other == zone { zone = nil }
    if other == water { water = nil }
}

# What A would do: talk to someone, read a sign, open a chest...
func update_context() -> void {
    action_target = nil
    action_label = ""
    if st == "swim" {
        action_label = "Dive"
        return
    }
    if st == "grab" {
        action_label = "Hold"
        return
    }
    if st == "aim" {
        action_label = "Stop"
        return
    }
    if st != "free" { return }
    var best: number = 99
    var fwd: vec3 = forward_of(facing)
    for e in find_tagged("interact") {
        if not e.alive { continue }
        var to: vec3 = e.global_position - self.position
        to.y = 0
        var d: number = length(to)
        var reach: number = e.reach
        if e == target {                       # (focused on: further - and someone to talk to, from well off)
            reach = max(reach, 4)
            if e.prompt == "Talk" { reach = max(reach + 4, 8) }
        }
        if d > reach { continue }
        if abs(e.focus_point().y - (self.y + 0.7)) > 2.4 { continue }          # (not things on a ledge above, or below)
        if d > 0.3 and dot(normalize(to), fwd) < 0.4 and e != target { continue }
        if not e.can_use(self.position) { continue }
        if d < best {
            best = d
            action_target = e
        }
    }
    if carrying != nil {
        action_label = "Throw"
    } elif action_target != nil {
        action_label = action_target.prompt
    } elif vine != nil and vine.reachable(self.position) {
        action_label = "Climb"
    } elif focusing and move_amount > 0.3 {
        action_label = "Jump"
    } elif move_amount > 0.3 {
        action_label = "Roll"
    }
}

# The spoon and lid: on his back, or in his hands - the spoon in his right fist (drawn, swung),
# the lid on his left (raised, or held at his side); the hammer in both hands; the Pea Shooter
# held out in his left while he aims. place_on_bone() puts them where the animation has the
# hands, so he's really holding them.
func place_gear(dt: number) -> void {
    weapon.Mesh.visible = has_spoon()
    lid.Mesh.visible = has_lid()
    var busy: bool = st == "climb" or st == "swim" or st == "dive" or st == "grab" or st == "aim" or st == "hold" or carrying != nil
    var swinging: bool = st == "slash" or st == "slash2" or st == "thrust" or st == "jumpatk" or st == "airatk" or st == "spin" or st == "charge" or st == "crouchstab"
    var out: bool = (drawn > 0 or focusing or swinging) and not busy
    if st == "hammer" {
        if hammer == nil or not hammer.alive { hammer = spawn("prefabs/hammer.scene", vec3(0, 0, 0), body) }
        place_on_bone(hammer, body, "hand_r", vec3(0, -0.15, 0.04), vec3(-80, 0, 0))
        weapon.Mesh.visible = false
    } elif hammer != nil and hammer.alive {
        destroy(hammer)
    }
    if out and has_spoon() and st != "hammer" {
        var r := vec3(-25, 0, 0)                 # (held ready: the bowl forward, a little down)
        if swinging { r = vec3(-85, 0, 0) }      # (swung: along his arm)
        if not place_on_bone(weapon, body, "hand_r", vec3(0, -0.15, 0.03), r) {
            weapon.position = vec3(-0.2, 0.55, -0.12)
            weapon.rotation = vec3(28, 8, 0)
        }
    } else {
        weapon.position = vec3(0.02, 0.62, 0.125)         # on his back (the body's back is at z 0.1)
        weapon.rotation = vec3(115, 0, -25)
    }
    # the streak: through the sweep of a swing (not the wind-up or the recovery), all through a spin
    var sweep: bool = st == "spin" or (st == "jumpatk" and st_t > 0.12) or (st == "airatk" and st_t > 0.08) or (st == "crouchstab" and st_t > 0.02 and st_t < 0.16)
    if (st == "slash" or st == "slash2" or st == "thrust") and st_t > 0.04 and st_t < 0.23 { sweep = true }
    trail.Particles.emitting = sweep and out and has_spoon()
    var placed: bool = false
    if shielding {
        placed = place_on_bone(lid, body, "hand_l", vec3(0, -0.2, 0), vec3(180, 0, 0))       # (its face (+y) out along his raised arm)
    } elif out {
        placed = place_on_bone(lid, body, "hand_l", vec3(0.05, -0.1, 0), vec3(0, 0, -90))     # (on his arm, facing out)
    }
    if not placed {
        lid.position = vec3(0, 0.6, 0.15)                  # on his back, over the spoon
        lid.rotation = vec3(90, 0, 0)
    }
    # the Pea Shooter, out while he aims it
    if st == "aim" and aim_item == "shooter" {
        if shooter == nil or not shooter.alive { shooter = spawn("prefabs/shooter_held.scene", vec3(0, 0, 0), body) }
        place_on_bone(shooter, body, "hand_l", vec3(0, -0.16, 0), vec3(-90, 0, 0))
    } elif shooter != nil and shooter.alive {
        destroy(shooter)
    }
}

# Where his hands are now (between them), in the world: what he holds over his head sits on them.
func hands_point() -> vec3 {
    var l: any = bone_position(body, "hand_l", vec3(0, -0.18, 0))
    var r: any = bone_position(body, "hand_r", vec3(0, -0.18, 0))
    if l == nil or r == nil { return self.position + vec3(0, 1.2, 0) }
    var lv: vec3 = l
    var rv: vec3 = r
    return (lv + rv) * 0.5
}

func animate() -> void {
    var yaw: number = facing + spin_angle
    var h: number = 0.35
    body.rotation = vec3(pitch, yaw, 0)
    var f: vec3 = forward_of(yaw)
    var lift: vec3 = vec3(0, h - h * cos(pitch), 0) + f * (h * sin(pitch))
    if game.era == "risen" { lift = lift * 1.3 }
    body.position = lift
    var visible: bool = not (flash > 0 and floor(flash * 20) % 2 == 0)
    body.Mesh.visible = visible
    if st == "free" and carrying != nil {
        if move_amount > 0.1 { play_animation(body, "walk", 1.2, true) } else { play_animation(body, "hold", 1, true) }
    } elif st == "free" {
        if not is_on_floor(self) and abs(vel.y) > 1.5 {
            play_animation(body, "jump", 1, false)
        } elif shielding and crouching() {
            play_animation(body, "crouch", 1, true)
        } elif shielding {
            play_animation(body, "shield", 1, true)
        } elif move_amount > 0.6 {
            play_animation(body, "run", 0.8 + move_amount * 0.4, true)
        } elif move_amount > 0.1 {
            play_animation(body, "walk", 0.8 + move_amount, true)
        } else {
            play_animation(body, "idle", 1, true)
        }
    } elif st == "talk" {
        play_animation(body, "idle", 1, true)
    } elif st == "aim" {
        play_animation(body, "aim", 1, true)
    } elif st == "grab" {
        if grabbed != nil and grabbed.alive and grabbed.sliding >= 0 { play_animation(body, "push", 1, true) } else { play_animation(body, "grab", 1, true) }
    }
}
