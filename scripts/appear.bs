@strict @3d
# appear.bs - hidden until the story flag `when` is set (the heart pie and the blue light
# after a boss): then it shows itself with a puff.

var when: string = ""
var game: entity
var shown: bool = false
var scale0: vec3

func start() -> void {
    game = find("Game")
    scale0 = self.scale
    if game.flag(when) { show() } else { hide() }
}

func hide() -> void {
    self.scale = vec3(0.001, 0.001, 0.001)
    add_tag(self, "hidden")
}

func show() -> void {
    shown = true
    self.scale = scale0
    remove_tag(self, "hidden")
}

func flags_changed() -> void {
    if not shown and game.flag(when) {
        show()
        spawn("prefabs/poof.scene", self.position + vec3(0, 0.5, 0))
    }
}
