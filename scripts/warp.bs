@strict @3d
# warp.bs - the blue light left when a dungeon's master is beaten: stepping in takes Sprig
# out (to `to`, at `at`), setting the flag `sets` on the way.

var to: string = "sprouthollow"
var at: string = "grove"
var sets: string = ""
var when: string = ""                  # it appears when this flag is set
var until: string = ""                 # (and is gone once this one is)
var game: entity
var used: bool = false
var t: number = 0
var scale0: vec3
var armed: bool = false                # (not until Sprig has been outside it: never taken out the moment it appears on him)

func start() -> void {
    game = find("Game")
    scale0 = self.scale
}

func update(dt: number) -> void {
    t += dt
    if used { return }
    if (when != "" and not game.flag(when)) or (until != "" and game.flag(until)) {
        self.scale = vec3(0.001, 0.001, 0.001)
        if has(self, "Particles") { self.Particles.emitting = false }
        return
    }
    self.scale = scale0
    if has(self, "Particles") { self.Particles.emitting = true }
    self.rotation = vec3(0, t * 60, 0)
    var sprig: entity = find("Sprig")
    var d: vec3 = sprig.position - self.position
    var inside: bool = abs(d.x) < 1.0 and abs(d.z) < 1.0 and abs(d.y) < 2
    if not armed {
        if not inside {
            armed = true
        } else {                           # it came up under him (or he came in on it): ease him out of it first
            var away: vec3 = vec3(d.x, 0, d.z)
            if length(away) < 0.05 { away = vec3(0, 0, 1) }
            sprig.position = sprig.position + normalize(away) * 10.0 * dt     # (quicker than he runs or rolls: a moment, and he is out)
        }
        return
    }
    if inside and game.state == "play" {
        used = true
        play_sound("sfx/warp.wav", 0.8)
        if sets != "" { game.set_flag(sets) }
        game.go(to, at)
    }
}
