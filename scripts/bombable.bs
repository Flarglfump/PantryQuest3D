@strict @3d
# bombable.bs - a cracked wall or a boulder: a bomb going off beside it breaks it (for good:
# the flag `id`).

var id: string = ""
var size_r: number = 1.5
var game: entity

func start() -> void {
    game = find("Game")
    if id != "" and game.flag(id) { destroy(self) }
}

func focus_point() -> vec3 { return self.global_position }

func hit(amount: int, how: string, from: vec3) -> void {
    if how != "bomb" { return }
    if id != "" { game.set_flag(id) }
    spawn("prefabs/poof.scene", self.global_position)
    spawn("prefabs/shards.scene", self.global_position)
    play_sound("sfx/crumble.wav", 0.9)
    play_sound("sfx/secret.wav", 0.6)
    destroy(self)
}
