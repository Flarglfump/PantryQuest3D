@strict @3d
# lockdoor.bs - a door with a lock: A uses a small key (once), and it's open for good
# (flag "door:<id>"). With `boss`, it needs the dungeon's Boss Key instead. The lock on it
# (an entity tagged "lock" close by) goes with it.

var id: string = ""
var boss: bool = false
var prompt: string = "Open"
var reach: number = 2.2
var game: entity

func start() -> void {
    game = find("Game")
    if game.flag("door:" + id) { open_up() }
}

func focus_point() -> vec3 { return self.position + vec3(0, 1.2, 0) }
func can_use(p: vec3) -> bool { return true }

# The door and its lock go.
func open_up() -> void {
    for l in find_tagged("lock") {
        if l.alive and distance(l.global_position, self.global_position) < 1.2 { destroy(l) }
    }
    destroy(self)
}

func interact(who: entity) -> void {
    if boss {
        if not game.has_item("bosskey_" + game.dungeon) {
            game.talk("boss_locked", "")
            return
        }
    } else {
        var k: string = "keys_" + game.dungeon
        if game.count(k) <= 0 {
            game.talk("locked", "")
            return
        }
        game.add_count(k, -1)
    }
    game.set_flag("door:" + id)
    play_sound("sfx/door.wav", 0.8)
    play_sound("sfx/secret.wav", 0.5)
    spawn("prefabs/poof.scene", self.position + vec3(0, 1.2, 0))
    open_up()
}
