@strict @3d
# secret.bs - something the Onion Lens shows the truth of. kind "invisible": there (and
# solid) but unseen, unless the lens is on. kind "fake": a wall that looks real but isn't
# (no collider), seen through when the lens is on.

var kind: string = "invisible"
var game: entity

func start() -> void { game = find("Game") }

func update(dt: number) -> void {
    var lens: bool = game.flag("lens_on")
    if kind == "invisible" { self.Mesh.visible = lens } else { self.Mesh.visible = not lens }
}
