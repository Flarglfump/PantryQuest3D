@strict
# settings.bs - the SETTINGS page (from the title screen or the pause menu's SYSTEM page):
# sliders for the whole mix, the music and the sound effects. Up and down choose, left and
# right (or a click or drag on a slider, or the mouse wheel over it) change it. Kept in the
# saved data "settings" ([[bus, volume], ...]); title.bs and game.bs set the buses from it.

var draw_layer: int = 98
var cur: int = 0
var t: number = 0
var vols: list = []                      # one per slider, 0..1
var closing: bool = false
var last_mouse: vec2 = vec2(-1, -1)
var dragging: int = -1
var blip_t: number = 0

# bus, name, its usual volume
const SLIDERS: list = [["master", "MASTER VOLUME", 1.0], ["music", "MUSIC", 0.8], ["sfx", "SOUND EFFECTS", 1.0]]
const TOP: number = 70
const ROW: number = 34
const BAR_X: number = 64
const BAR_W: number = 192

func start() -> void {
    lock_mouse(false)
    var saved: list = load_data("settings", [])
    for sl in SLIDERS {
        var v: number = sl[2]
        for kv in saved {
            if kv[0] == sl[0] { v = kv[1] }
        }
        push(vols, v)
    }
}

func rows() -> int { return len(SLIDERS) + 2 }     # (and RESET, BACK)

func row_y(i: int) -> number {
    if i < len(SLIDERS) { return TOP + i * ROW }
    return TOP + len(SLIDERS) * ROW + 4 + (i - len(SLIDERS)) * 16
}

func row_at(p: vec2) -> int {
    for i in rows() {
        var y: number = row_y(i)
        var h: number = 14
        if i < len(SLIDERS) { h = 30 }
        if p.x >= 20 and p.x < 300 and p.y >= y - 4 and p.y < y - 4 + h { return i }
    }
    return -1
}

func set_vol(i: int, v: number) -> void {
    var nv: number = clamp(floor(v * 20 + 0.5) / 20, 0, 1)          # (in twentieths)
    if nv == vols[i] { return }
    vols[i] = nv
    set_volume(SLIDERS[i][0], nv)
    if blip_t <= 0 and SLIDERS[i][0] != "music" {          # (a blip to hear it by; the music speaks for itself)
        play_sound("sfx/cursor.wav", 0.6)
        blip_t = 0.08
    }
}

func save() -> void {
    var out: list = []
    for i in len(SLIDERS) { push(out, [SLIDERS[i][0], vols[i]]) }
    save_data("settings", out)
}

func update(dt: number) -> void {
    t += dt
    blip_t = max(0, blip_t - dt)
    if closing { return }
    if t < 0.2 { return }
    var mp: vec2 = mouse_position()
    var moved: bool = distance(mp, last_mouse) > 0.5
    last_mouse = mp
    var row: int = row_at(mp)
    if dragging < 0 and row >= 0 and moved and row != cur {
        cur = row
        play_sound("sfx/cursor.wav", 0.3)
    }
    # the mouse on a slider: click or drag along it, or the wheel
    if mouse_pressed(0) and row >= 0 and row < len(SLIDERS) {
        dragging = row
        cur = row
    }
    if dragging >= 0 {
        if mouse_down(0) {
            set_vol(dragging, (mp.x - BAR_X) / BAR_W)
        } else {
            dragging = -1
            save()
        }
    }
    var wheel: vec2 = mouse_wheel()
    if wheel.y != 0 and row >= 0 and row < len(SLIDERS) {
        set_vol(row, vols[row] + sign(wheel.y) * 0.05)
        save()
    }
    if action_pressed("m_up") or key_pressed("up") {
        cur = (cur + rows() - 1) % rows()
        play_sound("sfx/cursor.wav", 0.3)
    }
    if action_pressed("m_down") or key_pressed("down") {
        cur = (cur + 1) % rows()
        play_sound("sfx/cursor.wav", 0.3)
    }
    if cur < len(SLIDERS) {
        var d: number = 0
        if action_pressed("m_left") or key_pressed("left") { d = -0.05 }
        if action_pressed("m_right") or key_pressed("right") { d = 0.05 }
        if d != 0 {
            set_vol(cur, vols[cur] + d)
            save()
        }
    }
    if action_pressed("m_back") or key_pressed("escape") or mouse_pressed(1) {
        close()
        return
    }
    if action_pressed("m_ok") or key_pressed("enter") or (mouse_pressed(0) and row >= len(SLIDERS)) {
        if mouse_pressed(0) and row >= 0 { cur = row }
        if cur == len(SLIDERS) {
            for i in len(SLIDERS) {
                vols[i] = SLIDERS[i][2]
                set_volume(SLIDERS[i][0], vols[i])
            }
            save()
            play_sound("sfx/select.wav", 0.5)
        } elif cur == len(SLIDERS) + 1 {
            close()
        }
    }
}

func close() -> void {
    closing = true
    save()
    play_sound("sfx/menu.wav", 0.5, 0.8)
    pop_scene()
}

func draw() -> void {
    if closing { return }
    draw_rect(vec2(0, 0), vec2(320, 240), [0, 0, 0, 150])
    draw_rect(vec2(16, 20), vec2(288, 200), [30, 22, 40, 252])
    draw_rect(vec2(16, 20), vec2(288, 200), [220, 190, 120, 255], false)
    var title: string = "SETTINGS"
    draw_text(title, vec2(160 - text_size(title, 2).x / 2, 30), [255, 220, 130], 2)
    for i in len(SLIDERS) {
        var y: number = row_y(i)
        var sel: bool = i == cur
        if sel { draw_rect(vec2(22, y - 4), vec2(276, 30), [60, 46, 80, 255]) }
        var c: list = [210, 200, 180]
        if sel { c = [255, 236, 150] }
        draw_text(SLIDERS[i][1], vec2(BAR_X, y), c)
        var pct: string = str(floor(vols[i] * 100 + 0.5)) + "%"
        draw_text(pct, vec2(BAR_X + BAR_W - text_size(pct).x, y), c)
        # the slider: a groove, filled to the volume, and a knob
        var gy: number = y + 14
        draw_rect(vec2(BAR_X, gy), vec2(BAR_W, 6), [20, 14, 28, 255])
        draw_rect(vec2(BAR_X, gy), vec2(floor(BAR_W * vols[i]), 6), [120, 200, 90, 255])
        draw_rect(vec2(BAR_X, gy), vec2(BAR_W, 6), [140, 120, 90, 255], false)
        var kx: number = BAR_X + floor(BAR_W * vols[i])
        draw_rect(vec2(kx - 3, gy - 3), vec2(7, 12), [250, 236, 190, 255])
        draw_rect(vec2(kx - 3, gy - 3), vec2(7, 12), [90, 60, 30, 255], false)
        if sel {
            draw_text("<", vec2(BAR_X - 14, gy - 1), c)
            draw_text(">", vec2(BAR_X + BAR_W + 8, gy - 1), c)
        }
    }
    var names: list = ["RESET TO THE USUAL", "BACK"]
    for k in 2 {
        var i: int = len(SLIDERS) + k
        var y2: number = row_y(i)
        var c2: list = [210, 200, 180]
        if i == cur {
            c2 = [255, 236, 150]
            draw_text(">", vec2(BAR_X - 14 + floor(t * 4) % 2, y2), c2)
        }
        draw_text(names[k], vec2(BAR_X, y2), c2)
    }
    var help: string = "LEFT/RIGHT, drag: change"
    draw_text(help, vec2(160 - text_size(help).x / 2, 206), [200, 190, 170])
}
