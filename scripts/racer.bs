@strict @3d
# racer.bs - Grandpa Gristle's ghost, in Peppermill's graveyard (the Risen era). Talk to him
# and he races off along his old round (`route`, offsets from where he starts); keep within
# reach of him all the way and at the end he gives up his treasure, the Licorice Lash.

var prompt: string = "Talk"
var reach: number = 2.4
var game: entity
var sprig: entity
var home: vec3
var route: list = [vec3(0, 0, 4), vec3(-10, 0, 6.2), vec3(-22, 0, 9.2), vec3(-32, 0, 11.2), vec3(-44, 0, 7.2), vec3(-46, 0, -4.8), vec3(-40, 0, -12.8), vec3(-26, 0, -12.8), vec3(-14, 0, -8.8), vec3(-10, 0, 3.2)]
var leg: int = -1
var t: number = 0
var lost_t: number = 0
var at: vec3                       # (for the play-test bots)

func start() -> void {
    game = find("Game")
    sprig = find("Sprig")
    home = self.position
}

func focus_point() -> vec3 { return self.position + vec3(0, 1.1, 0) }
func can_use(p: vec3) -> bool { return leg < 0 }

func interact(who: entity) -> void {
    if game.has_item("lash") {
        game.talk("ghost_after", "")
        return
    }
    game.talk("ghost_race", "race_go")
}

func go() -> void {
    leg = 0
    lost_t = 0
    play_sound("sfx/screech.wav", 0.5, 1.6)
}

func ground(p: vec3) -> number {
    var hit: any = raycast(p + vec3(0, 6, 0), p + vec3(0, -6, 0), self)
    if hit == nil { return p.y }
    return hit[1].y
}

func update(dt: number) -> void {
    t += dt
    if leg < 0 {
        self.y = home.y + 0.2 + sin(t * 120) * 0.15
        var to0: vec3 = sprig.position - self.position
        if length(to0) < 6 { self.rotation = vec3(0, atan2(-to0.x, -to0.z), 0) }
        play_animation(self, "idle", 1, true)
        return
    }
    if game.state != "play" { return }
    var goal: vec3 = home + route[leg]
    var d: vec3 = goal - self.position
    d.y = 0
    var close: number = distance(vec3(sprig.x, 0, sprig.z), vec3(self.x, 0, self.z))
    var speed: number = 4.6
    if close > 5 { speed = 3.4 }                      # (he waits a little for slowcoaches...)
    if length(d) < 0.3 {
        leg += 1
        if leg >= len(route) {
            leg = -1
            home = self.position
            game.talk("ghost_won", "lash")
            return
        }
    } else {
        var step: vec3 = normalize(d) * min(length(d), speed * dt)
        self.position = vec3(self.x + step.x, 0, self.z + step.z)
        self.rotation = vec3(0, atan2(-d.x, -d.z), 0)
    }
    self.y = ground(self.position) + 0.2 + sin(t * 300) * 0.1
    at = self.position
    play_animation(self, "run", 1.2, true)
    if close > 9 { lost_t += dt } else { lost_t = 0 }
    if lost_t > 1.5 {                                 # ...but not for long
        leg = -1
        self.position = home
        game.talk("ghost_lost", "")
    }
}
