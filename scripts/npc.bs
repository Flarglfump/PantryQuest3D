@strict @3d
# npc.bs - someone to talk to. Turns to face Sprig when he comes near, and says the talk
# that fits the story so far (talk_for()). `who` picks their lines; `needs` / `until` are
# story flags they wait for or leave after.

var who: string = "fennel"
var needs: string = ""
var until: string = ""
var prompt: string = "Talk"
var reach: number = 2.0
var game: entity
var sprig: entity
var home_yaw: number = 0
var yaw: number = 0
var talking: number = 0
var auto: bool = false               # talks by itself, once, when Sprig comes near (the owl)
var leaves: bool = false             # flies off after that
var flying: number = -1
var dancing: number = -1

func start() -> void {
    game = find("Game")
    sprig = find("Sprig")
    home_yaw = self.rotation.y
    yaw = home_yaw
    if not present() or (leaves and game.flag("talked:" + who)) { hide() }
}

func present() -> bool {
    if needs != "" and not game.flag(needs) { return false }
    if until != "" and game.flag(until) { return false }
    return true
}

func hide() -> void {
    self.Mesh.visible = false
    if has(self, "Collider3D") {
        self.Collider3D.size = vec3(0.001, 0.001, 0.001)
        self.Collider3D.radius = 0.001
    }
    add_tag(self, "hidden")
    remove_tag(self, "interact")
    remove_tag(self, "focusable")
}

# Someone played a song: Big Biscotti can't help dancing to Fennel's tune.
func song_played(name: string) -> void {
    if who == "biscotti" and name == "fennel" and distance(sprig.position, self.position) < 8 and not game.has_item("bracelet") {
        dancing = 0
    }
}

func fly_away() -> void {
    flying = 0
    play_sound("sfx/hop.wav", 0.6, 0.6)
}

func flags_changed() -> void {
    if not present() and not has_tag(self, "hidden") { hide() }
}

func focus_point() -> vec3 { return self.position + vec3(0, 1.0, 0) }
func can_use(p: vec3) -> bool { return not has_tag(self, "hidden") }

func update(dt: number) -> void {
    if flying >= 0 {
        flying += dt
        self.position = self.position + vec3(0, 3 * dt, -4 * dt)
        play_animation(self, "fly", 1, true)
        if flying > 3 { hide() }
        return
    }
    if has_tag(self, "hidden") { return }
    if dancing >= 0 {
        dancing += dt
        play_animation(self, "dance", 1, true)
        if dancing > 3 {
            dancing = -1
            game.talk("biscotti_dance", "bracelet")
        }
        return
    }
    if auto and game.state == "play" and distance(sprig.position, self.position) < 5 and not game.flag("talked:" + who) {
        game.set_flag("talked:" + who)
        interact(sprig)
        return
    }
    talking = max(0, talking - dt)
    var want: number = home_yaw
    var to: vec3 = sprig.position - self.position
    to.y = 0
    if length(to) < 4 { want = atan2(-to.x, -to.z) }
    var d: number = ((want - yaw + 540) % 360) - 180
    yaw += clamp(d, -360 * dt, 360 * dt)
    self.rotation = vec3(0, yaw, 0)
    if game.state == "talk" and talking > 0 {
        play_animation(self, "talk", 1, true)
        talking = 0.2
    } else {
        play_animation(self, "idle", 1, true)
    }
}

func interact(who_by: entity) -> void {
    talking = 0.5
    var id: string = talk_for()
    var then: string = ""
    if who == "chive" and id == "chive_move" { then = "chive_moved" }
    if who == "sage" { then = "shop" }
    if who == "basil" { then = "basil_shop" }
    if who == "owl" and leaves { then = "owl_leaves" }
    if who == "saffron" or who == "kimchi" { then = "saffron_done" }
    if id == "mtguard_letter" { then = "mountain_open" }
    if id == "biscotti_ember" { then = "ember_power" }
    if who == "diver" and id == "diver" { then = "dive_go" }
    if id == "carb_letter" { then = "carb_moved" }
    if id == "carb_1" { game.set_flag("talked_carb") }
    if id == "fizzy_ember" { then = "ember_wisdom" }
    if id == "cinder" { then = "prelude" }
    if id == "cinder_minuet" { then = "minuet" }
    if id == "cinder_bolero" { then = "bolero" }
    if who == "little_biscotti" and not game.has_item("apron") { then = "apron" }
    if id == "biscotti_keeper" and not game.flag("keeper_spice") { then = "med_spice" }
    if id == "fennel_keeper" and not game.flag("keeper_bitter") { then = "med_bitter" }
    if who == "fennel" and id == "fennel_bridge" { then = "pipe" }
    if id == "fennel_1" { game.set_flag("talked_fennel") }
    game.talk(id, then)
}

func talk_for() -> string {
    if who == "fennel" {
        if game.flag("crock_done") and not game.has_item("pipe") { return "fennel_bridge" }
        if not game.flag("talked_fennel") { return "fennel_1" }
        return "fennel_2"
    }
    if who == "chive" {
        if game.flag("crock_done") { return "chive_sorry" }
        if game.flag("chive_moved") { return "chive_after" }
        var spoon: bool = game.has_item("spoon")
        var lid: bool = game.has_item("potlid")
        if spoon and lid { return "chive_move" }
        if spoon or lid { return "chive_half" }
        return "chive_block"
    }
    if who == "sage" { return "sage_shop" }
    if who == "basil" { return "basil_shop" }
    if who == "owl" { return "owl_fields" }
    if who == "saffron" or who == "kimchi" { return "saffron_meet" }
    if who == "pip" {
        if game.flag("met_saffron") { return "pip_2" }
        return "pip_1"
    }
    if who == "mtguard" {
        if game.flag("mountain_open") { return "mtguard_open" }
        if game.has_item("letter") { return "mtguard_letter" }
        return "mtguard_no"
    }
    if who == "biscotti" {
        if game.flag("hardcaves_done") and not game.has_item("ember_power") { return "biscotti_ember" }
        if game.has_item("ember_power") { return "biscotti_after" }
        if game.has_item("bracelet") { return "biscotti_2" }
        return "biscotti_1"
    }
    if who == "hardtack" {
        if game.has_item("bracelet") { return "hardtack_2" }
        return "hardtack_1"
    }
    if who == "carbonarius" {
        if game.flag("gulp_done") { return "carb_thanks" }
        if game.flag("carb_moved") { return "carb_moved" }
        if game.has_item("letter_fizzy") { return "carb_letter" }
        if game.flag("talked_carb") { return "carb_2" }
        return "carb_1"
    }
    if who == "mozz" { return "mozz_2" }
    if who == "cinder" {
        if game.flag("keeper_spice") and game.area == "fondue" {
            if game.has_item("song_bolero") { return "cinder_after" }
            return "cinder_bolero"
        }
        if game.flag("keeper_bitter") and game.area == "thicket" {
            if game.has_item("song_minuet") { return "cinder_after" }
            return "cinder_minuet"
        }
        if game.has_item("song_prelude") { return "cinder_after" }
        return "cinder"
    }
    if who == "fizzy" {
        if game.has_item("ember_wisdom") { return "fizzy_after" }
        return "fizzy_ember"
    }
    if who == "guard" {
        if game.flag("met_saffron") { return "guard_2" }
        return "guard_1"
    }
    return who
}
