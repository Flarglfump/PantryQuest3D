@strict
# game.bs - the Game entity in every area: the journey's state (hearts, beans, items, story
# flags), area changes, talks, item fanfares, saving. The state lives in the global "save"
# so it carries across load_scene() and the overlay scenes (dialogue, pause menu) can read
# and change it; commit() writes it back after every change.
#
#   save = [flags, items, hp, max_hp, beans, peas, slots, counters, area, spawn, playtime, era]
#   hp / max_hp are in quarter hearts. slots: the three item buttons' items ("" for none).
#   counters: [[name, number], ...] for small keys and the like.

var area: string = ""                  # this area's id (set in the scene: Script vars)
var area_name: string = ""             # shown as the area is entered
var music: string = ""
var dungeon: string = ""               # a dungeon's id for its keys, map and compass ("" outside)
var kill_y: number = -20               # falling below this: back to the last safe spot
var hot: bool = false                  # too hot to bear for long without the Oven Apron
var heat: number = 40                  # (seconds left before the heat hurts)

var flags: list[string] = []
var items: list[string] = []
var hp: int = 12
var max_hp: int = 12
var beans: int = 0
var peas: int = 0
var slots: list[string] = ["", "", ""]
var counters: list = []
var spawn: string = "start"
var playtime: number = 0
var era: string = "fresh"

var state: string = "play"             # play, talk, fade, gameover
var sprig: entity
var story: entity
var after: string = ""                 # what to do when the talk that's showing ends
var fade: number = 1                   # 0 clear .. 1 black
var fade_to: number = 0
var next_area: string = ""
var next_spawn: string = ""
var banner_t: number = 0
var draw_layer: int = 90
var bound: bool = false
var greeted: bool = false

func start() -> void {
    load_state()
    sprig = find("Sprig")
    story = find("Story")
    if not has_global("bound") {
        bind_controls()
        set_global("bound", true)
    }
    var at: entity = find("spawn_" + spawn)
    if at == nil { at = find("spawn_start") }
    if at != nil and sprig != nil {
        sprig.position = at.position
        sprig.rotation = at.rotation
        sprig.placed()
    }
    if music != "" { play_music(music, 0.7, 1.0) }
    banner_t = 3.5
    fade = 1
    fade_to = 0
    commit()
}

# ---- controls (actions last the whole game) ----
func bind_controls() -> void {
    unbind("up"); bind("up", "w", "pad:left_y-")
    unbind("down"); bind("down", "s", "pad:left_y+")
    unbind("left"); bind("left", "a", "pad:left_x-")
    unbind("right"); bind("right", "d", "pad:left_x+")
    unbind("action"); bind("action", "space", "pad:a")
    unbind("attack"); bind("attack", "j", "pad:x")
    unbind("focus"); bind("focus", "shift", "l", "pad:lt", "pad:lb")
    unbind("shield"); bind("shield", "k", "pad:rt", "pad:rb")
    unbind("item1"); bind("item1", "u", "pad:y")
    unbind("item2"); bind("item2", "i", "pad:b")
    unbind("item3"); bind("item3", "o", "pad:up")
    unbind("flicker"); bind("flicker", "tab", "pad:back")
    unbind("pause"); bind("pause", "enter", "escape", "pad:start")
    unbind("cam_left"); bind("cam_left", "left", "pad:right_x-")
    unbind("cam_right"); bind("cam_right", "right", "pad:right_x+")
    unbind("cam_center"); bind("cam_center", "down")
    # menus
    unbind("m_up"); bind("m_up", "up", "w", "pad:up", "pad:left_y-")
    unbind("m_down"); bind("m_down", "down", "s", "pad:down", "pad:left_y+")
    unbind("m_left"); bind("m_left", "left", "a", "pad:left", "pad:left_x-")
    unbind("m_right"); bind("m_right", "right", "d", "pad:right", "pad:left_x+")
    unbind("m_ok"); bind("m_ok", "enter", "space", "j", "pad:a")
    unbind("m_back"); bind("m_back", "escape", "backspace", "pad:b")
    unbind("m_page_l"); bind("m_page_l", "q", "pad:lb")
    unbind("m_page_r"); bind("m_page_r", "e", "pad:rb")
}

# ---- the state ----
func load_state() -> void {
    var s: list = global("save", [])
    if len(s) < 12 { return }
    flags = s[0]
    items = s[1]
    hp = s[2]
    max_hp = s[3]
    beans = s[4]
    peas = s[5]
    slots = s[6]
    counters = s[7]
    spawn = s[9]
    playtime = s[10]
    era = s[11]
}

func commit() -> void {
    set_global("save", [flags, items, hp, max_hp, beans, peas, slots, counters, area, spawn, playtime, era])
}

func flag(name: string) -> bool { return contains(flags, name) }
func set_flag(name: string) -> void {
    if not contains(flags, name) {
        push(flags, name)
        commit()
        broadcast("flags_changed")
    }
}
func clear_flag(name: string) -> void {
    var i: int = 0
    while i < len(flags) {
        if flags[i] == name {
            remove(flags, i)
            commit()
            broadcast("flags_changed")
            return
        }
        i += 1
    }
}

func has_item(name: string) -> bool { return contains(items, name) }

func count(name: string) -> int {
    for c in counters {
        if c[0] == name { return c[1] }
    }
    return 0
}
func add_count(name: string, n: int) -> void {
    for c in counters {
        if c[0] == name {
            c[1] = c[1] + n
            commit()
            return
        }
    }
    push(counters, [name, n])
    commit()
}

func max_peas() -> int {
    if has_item("peabag40") { return 40 }
    return 30
}
func max_beans() -> int {
    if has_item("purse200") { return 200 }
    return 99
}

# Adds an item. Some items do more: the pea shooter comes with peas and goes on a button.
func add_item(name: string) -> void {
    if name == "heartpie" {
        max_hp += 4
        hp = max_hp
    } elif name == "slice" {
        add_count("slices", 1)
        if count("slices") % 4 == 0 {
            max_hp += 4
            hp = max_hp
        }
    } elif name == "key" {
        add_count("keys_" + dungeon, 1)
    } elif name == "bean20" {
        add_beans(20)
    } elif name == "bean50" {
        add_beans(50)
    } elif not contains(items, name) {
        push(items, name)
    }
    if name == "shooter" {
        peas = max_peas()
        put_on_button(name)
    }
    if name == "bombs" {
        add_count("bombs", 20 - count("bombs"))
        put_on_button(name)
    }
    if name == "boomerang" or name == "jar1" or name == "lash" or name == "hammer" or name == "boots" or name == "hover" or name == "lens" { put_on_button(name) }
    if name == "longlash" { put_on_button("lash") }
    if name == "bow" {
        add_count("arrows", 30 - count("arrows"))
        put_on_button(name)
    }
    if name == "pipe" {
        if not contains(items, "song_fennel") { push(items, "song_fennel") }
        put_on_button(name)
    }
    commit()
}

func put_on_button(name: string) -> void {
    if contains(slots, name) { return }
    for i in 3 {
        if slots[i] == "" {
            slots[i] = name
            return
        }
    }
}

func add_beans(n: int) -> void {
    beans = clamp(beans + n, 0, max_beans())
    commit()
}

func heal(quarters: int) -> void {
    hp = min(max_hp, hp + quarters)
    commit()
}

# Hurts Sprig (sprig.bs has decided it wasn't blocked). True when that was the end of him.
func damage(quarters: int) -> bool {
    hp = max(0, hp - quarters)
    commit()
    return hp <= 0
}

func collect(kind: string) -> void {
    if kind == "heartpie" or kind == "slice" {
        give(kind, "")
    } elif kind == "heart" {
        heal(4)
        play_sound("sfx/heart.wav", 0.7)
    } elif kind == "bean1" {
        add_beans(1)
        play_sound("sfx/bean.wav", 0.6)
    } elif kind == "bean5" {
        add_beans(5)
        play_sound("sfx/bean.wav", 0.6, 1.2)
    } elif kind == "bean20" {
        add_beans(20)
        play_sound("sfx/bean.wav", 0.6, 1.4)
    } elif kind == "peas" {
        peas = min(max_peas(), peas + 5)
        commit()
        play_sound("sfx/bean.wav", 0.5, 0.8)
    } elif kind == "key" {
        add_count("keys_" + dungeon, 1)
        play_sound("sfx/secret.wav", 0.7)
    } elif kind == "arrows" {
        add_count("arrows", min(5, 30 - count("arrows")))
        play_sound("sfx/bean.wav", 0.5, 0.9)
    } elif kind == "popcorn" {
        add_count("bombs", min(5, 20 - count("bombs")))
        play_sound("sfx/bean.wav", 0.5, 0.7)
    }
}

# Drop tables: what grass, pots and beaten enemies leave behind (only what Sprig can use).
func roll_drop(at: vec3, chance: number) -> void {
    if random() > chance { return }
    var r: number = random()
    var kind: string = "bean1"
    if hp < max_hp and r < 0.3 {
        kind = "heart"
    } elif era == "fresh" and has_item("shooter") and peas < max_peas() and r < 0.5 {
        kind = "peas"
    } elif has_item("bombs") and count("bombs") < 20 and r < 0.62 {
        kind = "popcorn"
    } elif era == "risen" and has_item("bow") and count("arrows") < 30 and r < 0.72 {
        kind = "arrows"
    } elif r > 0.93 {
        kind = "bean5"
    }
    var p: entity = spawn("prefabs/pickup_" + kind + ".scene", at + vec3(0, 0.3, 0))
    p.dropped = true
}

# ---- talking ----
# Shows the talk `id` (story.bs has the words). `then` names what happens after it
# (story.bs's after()), with the choice the player made.
func talk(id: string, then: string) -> void {
    var pages: list = story.talk(id)
    show_pages(pages, then)
}

func show_pages(pages: list, then: string) -> void {
    if state != "play" { return }
    set_global("talk", pages)
    set_global("talk_choice", -1)
    after = then
    state = "talk"
    push_scene("dialogue.scene", true, false)
}

# An item fanfare: Sprig holds it up, and the box says what it is.
func give(item: string, then: string) -> void {
    add_item(item)
    play_sound("sfx/fanfare.wav", 0.8)
    sprig.hold_up()
    show_pages([["", story.item_text(item), [], item]], then)
}

func on_resume() -> void {
    if state == "talk" {
        load_state()
        state = "play"
        var then: string = after
        after = ""
        sprig.talk_ended()
        if then != "" { story.after(then, global("talk_choice", -1)) }
    } elif state == "pipe" {
        state = "play"
        var song: string = global("song_played", "")
        if song != "" { broadcast("song_played", song) }
        if song == "prelude" and dungeon == "" {          # warp songs: back to the Temple of the First Hearth...
            play_sound("sfx/warp.wav", 0.8)
            go("temple", "start")
        }
        if song == "minuet" and dungeon == "" {           # ...to the Glade in the Thicket...
            play_sound("sfx/warp.wav", 0.8)
            go("thicket", "glade")
        }
        if song == "bolero" and dungeon == "" {           # ...to Mount Fondue's crater...
            play_sound("sfx/warp.wav", 0.8)
            go("fondue", "forge")
        }
        if song == "nocturne" and dungeon == "" and area != "peppermill" {     # ...to Peppermill's graveyard...
            play_sound("sfx/warp.wav", 0.8)
            go("peppermill", "graveyard")
        }
        if song == "requiem" and dungeon == "" {          # ...to the Salt Idol (either era)...
            play_sound("sfx/warp.wav", 0.8)
            go("idol", "requiem")
        }
        if song == "serenade" and dungeon == "" {         # ...and to Lake Brine's island
            play_sound("sfx/warp.wav", 0.8)
            go("lake", "island")
        }
    } elif state == "paused" {
        load_state()
        state = "play"
        if global("quit_to_title", false) {
            set_global("quit_to_title", false)
            load_scene("title.scene")
        }
    } elif state == "gameover" {
        load_state()
        state = "fade"
        var c: int = global("gameover_choice", 0)
        if c == 1 {
            save_journey()
            load_scene("title.scene")
        } else {
            hp = max(hp, 12)
            spawn = "start"
            commit()
            load_scene(scene_for(area))
        }
    }
}

func play_pipe() -> void {
    if state != "play" { return }
    state = "pipe"
    push_scene("pipe.scene", true, false)
}

func pause() -> void {
    if state != "play" { return }
    commit()
    set_global("area_name", area_name)
    set_global("dungeon", dungeon)
    set_global("area", area)
    state = "paused"
    play_sound("sfx/menu.wav", 0.6)
    push_scene("pause.scene", true, false)
}

func game_over() -> void {
    state = "gameover"
    stop_music(1.0)
    push_scene("gameover.scene", true, false)
}

# Continue after a game over: back to this area's entrance (a dungeon's too).
func restart_area() -> void {
    hp = max(hp, 12)
    commit()
    go(area, "start")
}

# ---- changing area ----
func go(to: string, at: string) -> void {
    if next_area != "" { return }
    next_area = to
    next_spawn = at
    fade_to = 1
    state = "fade"
}

# The scene for an area: some areas have a Risen-era version (areas/<id>_risen.scene).
const RISEN_AREAS: list = ["town", "fields", "peppermill", "thicket", "hardtack", "fondue", "fizzdomain", "fountain", "lake", "dairy"]
func scene_for(a: string) -> string {
    if era == "risen" and contains(RISEN_AREAS, a) { return "areas/" + a + "_risen.scene" }
    return "areas/" + a + ".scene"
}

func save_journey() -> bool {
    commit()
    var slot: int = global("slot", 0)
    var s: list = global("save", [])
    return save_data("slot" + slot, s)
}

func update(dt: number) -> void {
    if state == "play" or state == "fade" { playtime += dt }
    if hot and state == "play" and not has_item("apron") {
        heat -= dt
        if heat <= 0 {
            heat = 8
            if sprig != nil { sprig.hurt(4, sprig.position, "unblockable") }
        }
    }
    if state == "play" { banner_t = max(0, banner_t - dt) }
    if fade < fade_to { fade = min(fade_to, fade + dt * 2.5) }
    if fade > fade_to { fade = max(fade_to, fade - dt * 2) }
    if next_area != "" and fade >= 1 {
        spawn = next_spawn
        commit()
        var to: string = next_area
        next_area = ""
        load_scene(scene_for(to))
        return
    }
    if not greeted and fade < 0.1 and state == "play" {
        greeted = true
        story.area_started(area)
    }
    if state == "play" and action_pressed("pause") { pause() }
}

func draw() -> void {
    if fade > 0 { draw_rect(vec2(0, 0), vec2(320, 240), [0, 0, 0, floor(fade * 255)]) }
    if banner_t > 0 and area_name != "" and fade < 0.5 and state == "play" {
        var a: number = min(1, banner_t) * min(1, (3.5 - banner_t) * 2)
        var sc: number = 2
        if text_size(area_name, 2).x > 290 { sc = 1 }
        var w: number = text_size(area_name, sc).x
        draw_rect(vec2(160 - w / 2 - 10, 56), vec2(w + 20, 26), [0, 0, 0, floor(a * 130)])
        draw_text(area_name, vec2(160 - w / 2 + 1, 69 - 4 * sc), [40, 30, 10, floor(a * 255)], sc)
        draw_text(area_name, vec2(160 - w / 2, 68 - 4 * sc), [255, 236, 170, floor(a * 255)], sc)
    }
}
