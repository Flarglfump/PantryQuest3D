@strict @3d
# camera.bs - follows Sprig like the old adventure cameras: it hangs behind him on a rope,
# so it trails round as he runs and turns. ← / → (or the right stick) swing it round;
# Focus (or ↓) puts it straight behind him. While Flicker has something focused it looks
# past Sprig at it. It pulls in when a wall would come between it and Sprig.
# With the mouse captured (game.bs), moving it swings the camera round and tilts it up or down.

var sprig: entity
var dist: number = 4.6
var height: number = 1.7
var look_h: number = 0.8
var follow_y: number = 0
var pos: vec3
var recenter: number = 0           # seconds of swinging back behind him
var shake_t: number = 0
var tilt: number = 0               # the mouse: the camera raised (+) or lowered (-), metres
var aiming: bool = false
const MOUSE_TURN: number = 0.45    # degrees per game pixel of mouse motion
const MOUSE_TILT: number = 0.02    # metres per game pixel
const STICK_TURN: number = 160     # degrees a second, the right stick all the way over
const STICK_TILT: number = 2.6     # metres a second

func start() -> void {
    sprig = find("Sprig")
    var game: entity = find("Game")
    if game != nil and game.era == "risen" {      # a taller Sprig: stand further back
        dist = 5.4
        height = 2.1
        look_h = 1.1
    }
    snap_behind()
}

func behind_point() -> vec3 {
    var f: vec3 = sprig.forward_of(sprig.facing)
    return sprig.position - f * dist
}

func snap_behind() -> void {
    if sprig == nil { return }
    follow_y = sprig.y
    pos = behind_point()
    pos.y = follow_y + height
    place(pos)
}

func update(dt: number) -> void {
    if sprig == nil { return }
    if not sprig.alive { return }
    if speaker_shot(dt) { return }
    if sprig.st == "aim" {
        # aiming: just over his right shoulder, looking along the shot
        var d: vec3 = sprig.aim_dir()
        var f: vec3 = sprig.forward_of(sprig.aim_yaw)
        var right := vec3(-f.z, 0, f.x)
        var eye: vec3 = sprig.position + vec3(0, 1.25, 0) - f * 1.3 + right * 0.4 - d * 0.2
        follow_y = sprig.y
        pos = lerp(pos, eye, min(1, dt * 14))
        aiming = true
        var hit: any = raycast(sprig.position + vec3(0, 1.0, 0), pos, sprig)        # (not through a wall behind him)
        if hit != nil { pos = hit[1] + (sprig.position + vec3(0, 1.0, 0) - hit[1]) * 0.15 }
        self.position = pos
        look_at(self, pos + d * 10)
        return
    }
    if aiming {                                    # (back behind him, from where the aim left off)
        aiming = false
        pos = behind_point()
        pos.y = follow_y + height
    }
    # height: follow Sprig's feet smoothly (hops and steps don't jolt the view)
    var k: number = min(1, dt * 5)
    if sprig.st == "climb" { k = min(1, dt * 8) }
    follow_y = lerp(follow_y, sprig.y, k)
    var me := vec3(sprig.x, follow_y, sprig.z)
    var flat: vec3 = pos - me
    flat.y = 0
    if length(flat) < 0.1 { flat = sprig.forward_of(sprig.facing) * -1 }

    if action_pressed("cam_center") or action_pressed("focus") { recenter = 0.25 }

    var t: entity = sprig.target
    if t != nil and not t.alive { t = nil }
    # swinging round and tilting: the mouse (while it's captured), the right stick, ← →
    var swing: number = action_axis("cam_left", "cam_right") * 110 * dt
    var rs: vec2 = stick("right")
    if abs(rs.x) < 0.15 { rs.x = 0 }
    if abs(rs.y) < 0.15 { rs.y = 0 }
    swing += rs.x * STICK_TURN * dt
    tilt = clamp(tilt + rs.y * STICK_TILT * dt, -1.1, 2.4)
    var mm: vec2 = mouse_motion()
    if mouse_locked() {
        tilt = clamp(tilt + mm.y * MOUSE_TILT, -1.1, 2.4)
        swing += mm.x * MOUSE_TURN
    }
    if swing != 0 and t == nil and sprig.st != "climb" and not sprig.focusing and recenter <= 0 {
        # swing the camera itself round Sprig, so the view keeps up with the hand
        var a2: number = atan2(flat.x, flat.z) - swing
        var r: number = length(flat)
        flat = vec3(sin(a2), 0, cos(a2)) * r
        pos = vec3(me.x + flat.x, pos.y, me.z + flat.z)
    }
    if t != nil {
        # behind Sprig, on the line from what's focused through him
        var away: vec3 = me - t.global_position
        away.y = 0
        if length(away) > 0.1 { flat = lerp(normalize(flat), normalize(away), min(1, dt * 6)) }
    } elif sprig.st == "climb" {
        var back2: vec3 = sprig.forward_of(sprig.facing) * -1
        flat = lerp(normalize(flat), back2, min(1, dt * 4))
    } elif sprig.focusing or recenter > 0 {
        recenter = max(0, recenter - dt)
        if recenter > 0 { tilt = lerp(tilt, 0, min(1, dt * 12)) }
        var back: vec3 = sprig.forward_of(sprig.facing) * -1
        flat = lerp(normalize(flat), back, min(1, dt * 12))
    }
    flat = normalize(flat) * dist * (1 - max(0, tilt) * 0.1)     # (looking down from higher up: a little closer)
    var want: vec3 = me + flat + vec3(0, height + tilt, 0)
    if t != nil { want.y += 0.4 }
    pos = lerp(pos, want, min(1, dt * 10))
    place(pos)
}

# ---- in a talk: looking at whoever's speaking, over Sprig's shoulder ----
const ALIASES: list = [["hootenanny", "owl"], ["mother starter", "mother starter"]]
var talk_pos: vec3
var talk_look: vec3
var talking: bool = false

func lower_text(t: string) -> string {
    var lo: string = "abcdefghijklmnopqrstuvwxyz"
    var hi: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    var out: string = ""
    for k in len(t) {
        var c: string = t[k]
        for j in 26 {
            if hi[j] == c { c = lo[j] }
        }
        out = out + c
    }
    return out
}

func has_text(big: string, small: string) -> bool {
    if small == "" or len(small) > len(big) { return false }
    for i in len(big) - len(small) + 1 {
        if substr(big, i, len(small)) == small { return true }
    }
    return false
}

# The speaker's entity, if one's about: an NPC (or Mother Starter) whose name, or who, is in
# the name the text box shows ("NANNY KIMCHI": Kimchi).
func speaker_entity(name: string) -> entity {
    var said: string = lower_text(name)
    for al in ALIASES {
        if has_text(said, al[0]) { said = said + " " + al[1] }
    }
    var best: entity = nil
    var best_d: number = 30
    for e in find_tagged("npc") {
        if not e.alive { continue }
        var n: string = lower_text(e.name)
        if not has_text(said, n) { continue }
        var d: number = distance(e.position, sprig.position)
        if d < best_d {
            best_d = d
            best = e
        }
    }
    return best
}

# Under the text box the area waits, but the camera still turns to whoever's speaking.
func paused_update(dt: number) -> void {
    if sprig != nil and sprig.alive { speaker_shot(dt) }
}

func speaker_shot(dt: number) -> bool {
    var game: entity = find("Game")
    var who: string = global("talk_speaker", "")
    if game == nil or game.state != "talk" or who == "" {
        if talking {                                   # (back behind him, from there)
            talking = false
            pos = self.position
        }
        return false
    }
    var e: entity = speaker_entity(who)
    if e == nil {
        talking = false
        return false
    }
    var head: vec3 = e.position + vec3(0, 1.1, 0)
    head = e.focus_point()                    # (npc.bs, starter.bs: where to look)
    var me := vec3(sprig.x, sprig.y, sprig.z)
    var to: vec3 = head - me
    to.y = 0
    if length(to) < 0.3 { to = sprig.forward_of(sprig.facing) }
    var f: vec3 = normalize(to)
    var right := vec3(-f.z, 0, f.x)
    # over his shoulder (behind him, to one side, a little above), the speaker framed past him
    var want: vec3 = me - f * 2.4 + right * 1.1 + vec3(0, 1.75, 0)
    var hit: any = raycast(me + vec3(0, 1.2, 0), want, sprig)
    if hit != nil and not has_tag(hit[0], "seethrough") { want = hit[1] + (me + vec3(0, 1.2, 0) - hit[1]) * 0.2 }
    var look: vec3 = lerp(me + vec3(0, 1.0, 0), head, 0.75)
    if not talking {
        talking = true
        talk_pos = self.position
        talk_look = look
    }
    talk_pos = lerp(talk_pos, want, min(1, dt * 5))
    talk_look = lerp(talk_look, look, min(1, dt * 6))
    self.position = talk_pos
    look_at(self, talk_look)
    return true
}

func place(p: vec3) -> void {
    var focus := vec3(sprig.x, follow_y + look_h, sprig.z)
    # pull in if something is in the way
    var hit: any = raycast(focus, p, sprig)
    var at: vec3 = p
    if hit != nil and not has_tag(hit[0], "seethrough") {
        var d: vec3 = p - focus
        var l: number = length(d)
        var hd: number = distance(focus, hit[1])
        at = focus + d * (max(0.4, hd - 0.3) / l)
    }
    self.position = at
    var look: vec3 = focus
    var t: entity = sprig.target
    if t != nil and t.alive { look = lerp(focus, t.focus_point(), 0.4) }
    look_at(self, look)
}
