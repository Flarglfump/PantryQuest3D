@strict
# title.bs - the title screen, over a slow flight round Sprouthollow. Three journeys: an
# empty one starts a new game in Sprig's tree-house; a saved one carries on from where it
# was saved. Delete (or Y) erases the chosen journey, after asking. Under them, CONTROLS.
# The mouse works too: point and click (a right click on a journey erases it).

var draw_layer: int = 80
var cur: int = 0
var t: number = 0
var slots: list = []
var confirm: bool = false
var leaving: number = -1
var bound: bool = false
var last_mouse: vec2 = vec2(-1, -1)

func start() -> void {
    lock_mouse(false)
    unbind("m_up"); bind("m_up", "up", "w", "pad:up", "pad:left_y-")
    unbind("m_down"); bind("m_down", "down", "s", "pad:down", "pad:left_y+")
    unbind("m_ok"); bind("m_ok", "enter", "space", "j", "pad:a", "pad:start")
    unbind("m_back"); bind("m_back", "escape", "backspace", "pad:b")
    unbind("m_erase"); bind("m_erase", "delete", "pad:y")
    for i in 3 { push(slots, load_data("slot" + i)) }
    play_music("music/title.wav", 0.7, 1.0)
}

func update(dt: number) -> void {
    t += dt
    if leaving >= 0 {
        leaving += dt
        if leaving > 0.8 { begin() }
        return
    }
    if t < 0.5 { return }
    var mp: vec2 = mouse_position()
    var moved: bool = distance(mp, last_mouse) > 0.5
    last_mouse = mp
    var row: int = row_at(mp)
    var click: bool = mouse_pressed(0) and row >= 0
    if confirm {
        if action_pressed("m_ok") or (mouse_pressed(0) and inside(mp, vec2(60, 200), vec2(200, 22))) {
            delete_data("slot" + cur)
            slots[cur] = nil
            confirm = false
            play_sound("sfx/smash.wav", 0.5)
        } elif action_pressed("m_back") or action_pressed("m_up") or action_pressed("m_down") or mouse_pressed(0) or mouse_pressed(1) {
            confirm = false
        }
        return
    }
    if row >= 0 and (moved or click) and row != cur {
        cur = row
        play_sound("sfx/cursor.wav", 0.4)
    }
    if action_pressed("m_up") {
        cur = (cur + 3) % 4
        play_sound("sfx/cursor.wav", 0.4)
    }
    if action_pressed("m_down") {
        cur = (cur + 1) % 4
        play_sound("sfx/cursor.wav", 0.4)
    }
    if (action_pressed("m_erase") or (mouse_pressed(1) and row >= 0 and row < 3 and row == cur)) and cur < 3 and slots[cur] != nil {
        confirm = true
        play_sound("sfx/cursor.wav", 0.4)
    }
    if (action_pressed("m_ok") or click) and cur == 3 {
        play_sound("sfx/select.wav", 0.6)
        push_scene("controls.scene", true, false)
        return
    }
    if action_pressed("m_ok") or click {
        play_sound("sfx/select.wav", 0.7)
        leaving = 0
        stop_music(0.8)
    }
}

func inside(p: vec2, at: vec2, size: vec2) -> bool {
    return p.x >= at.x and p.y >= at.y and p.x < at.x + size.x and p.y < at.y + size.y
}

# Which row the mouse is over: a journey (0-2), CONTROLS (3), or -1.
func row_at(p: vec2) -> int {
    for i in 3 {
        if inside(p, vec2(70, journey_y(i)), vec2(180, 22)) { return i }
    }
    if inside(p, vec2(110, 196), vec2(100, 14)) { return 3 }
    return -1
}

func journey_y(i: int) -> number { return 120 + i * 25 }

func begin() -> void {
    set_global("slot", cur)
    var s: any = slots[cur]
    if s == nil {
        set_global("save", [[], [], 12, 12, 0, 0, ["", "", ""], [], "sprouthollow", "bed", 0, "fresh"])
        load_scene("areas/sprouthollow.scene")
        return
    }
    set_global("save", s)
    var area: string = s[8]
    if area == "crock" { s[9] = "start" } elif area == "sprouthollow" and s[9] == "bed" { s[9] = "bed" } else { s[9] = "start" }
    set_global("save", s)
    if s[11] == "risen" and (area == "town" or area == "fields" or area == "peppermill" or area == "thicket" or area == "hardtack" or area == "fondue" or area == "fizzdomain" or area == "fountain" or area == "lake" or area == "dairy") {
        load_scene("areas/" + area + "_risen.scene")
        return
    }
    load_scene("areas/" + area + ".scene")
}

func draw() -> void {
    var a: number = min(1, t)
    # the title
    var title: string = "PANTRY QUEST"
    var w: number = text_size(title, 3).x
    draw_text(title, vec2(160 - w / 2 + 2, 30), [60, 30, 10, floor(a * 255)], 3)
    draw_text(title, vec2(160 - w / 2, 28), [255, 226, 140, floor(a * 255)], 3)
    var sub: string = "3D"
    var w2: number = text_size(sub, 4).x
    var bob: number = sin(t * 120) * 2
    draw_text(sub, vec2(160 - w2 / 2 + 2, 58 + bob), [60, 20, 10, floor(a * 255)], 4)
    draw_text(sub, vec2(160 - w2 / 2, 56 + bob), [120, 220, 100, floor(a * 255)], 4)
    var tag: string = "The Ember of the First Hearth"
    draw_rect(vec2(160 - text_size(tag).x / 2 - 6, 97), vec2(text_size(tag).x + 12, 13), [20, 16, 30, floor(a * 150)])
    draw_text(tag, vec2(160 - text_size(tag).x / 2, 100), [240, 230, 200, floor(a * 220)])
    # the three journeys
    for i in 3 {
        var y: number = journey_y(i)
        var sel: bool = i == cur
        var bg: list = [20, 16, 30, 190]
        if sel { bg = [50, 40, 70, 220] }
        draw_rect(vec2(70, y), vec2(180, 22), bg)
        if sel { draw_rect(vec2(70, y), vec2(180, 22), [255, 220, 120, 255], false) }
        var s: any = slots[i]
        var col: list = [220, 210, 190]
        if sel { col = [255, 236, 150] }
        if s == nil {
            draw_text("JOURNEY " + (i + 1) + "   - new -", vec2(80, y + 7), col)
        } else {
            draw_text("JOURNEY " + (i + 1), vec2(80, y + 3), col)
            var hearts: int = floor(s[3] / 4)
            for h in min(hearts, 10) { draw_image("art/icons/heart4.png", vec2(84 + h * 9, y + 15)) }
            var secs: int = floor(s[10])
            draw_text(str(floor(secs / 3600)) + "h" + (floor(secs / 60) % 60) + "m", vec2(200, y + 3), col)
        }
    }
    # CONTROLS
    var csel: bool = cur == 3
    var cbg: list = [20, 16, 30, 190]
    if csel { cbg = [50, 40, 70, 220] }
    draw_rect(vec2(110, 196), vec2(100, 14), cbg)
    if csel { draw_rect(vec2(110, 196), vec2(100, 14), [255, 220, 120, 255], false) }
    var ccol: list = [220, 210, 190]
    if csel { ccol = [255, 236, 150] }
    draw_text("CONTROLS", vec2(160 - text_size("CONTROLS").x / 2, 199), ccol)
    if confirm {
        draw_rect(vec2(60, 200), vec2(200, 22), [80, 10, 10, 230])
        draw_text("Erase journey " + (cur + 1) + "? ENTER: yes", vec2(68, 207), [255, 255, 255])
    } else {
        var help: string = "ENTER/click: choose   DEL: erase"
        if last_input() == "gamepad" or last_input() == "touch" { help = "(A): choose    (Y): erase" }
        draw_text(help, vec2(160 - text_size(help).x / 2, 218), [200, 190, 170, floor(a * 200)])
    }
    draw_text("2026", vec2(290, 230), [120, 110, 100])
    if leaving >= 0 { draw_rect(vec2(0, 0), vec2(320, 240), [0, 0, 0, floor(min(1, leaving / 0.8) * 255)]) }
}
