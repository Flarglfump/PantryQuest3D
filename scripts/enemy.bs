@strict @3d
# enemy.bs - the common part of every enemy (health, being hit, flashing, knock-back, dying
# with a puff and a drop) and the brains of the small ones:
#   fuzzball - a mould puff that hops about and lunges at Sprig
#   larva    - a mite larva that crawls after him
#   scrub    - hides in its leaves, pops up and spits nuts (shield them straight back!)
#   dummy    - a training dummy: it wobbles, and never falls
# `group` names a set of enemies: when the last of one dies, the flag "clear:<group>" is set.

var brain: string = "fuzzball"
var hp: int = 2
var damage: int = 2                     # quarter hearts, on touching Sprig
var always: bool = false             # (a Stalebie that's up by day too: the Risen town)
var group: string = ""
var order: int = 0                      # (scrub brothers: which one this is)
var trio: bool = false
var game: entity
var sprig: entity
var vel: vec3
var st: string = "idle"
var st_t: number = 0
var flash: number = 0
var stun: number = 0
var yaw: number = 0
var home: vec3
var wander_to: vec3
var dead: bool = false
var spit_t: number = 1.5
var wobble: number = 0
var popped: bool = false
var struck: bool = false               # (a brother already struck stays down)

func start() -> void {
    game = find("Game")
    sprig = find("Sprig")
    home = self.position
    wander_to = home
    yaw = self.rotation.y
    if trio { add_tag(self, "trio") }
    if group != "" { add_tag(self, "grp_" + group) }
    if brain == "scrub" {
        st = "hidden"
        play_animation(self, "hide", 1, true)
    }
    if brain == "stalebie" { go_under() }
    if group != "" and game.flag("clear:" + group) { destroy(self) }
}

func focus_point() -> vec3 {
    if brain == "scrub" { return self.position + vec3(0, 0.45, 0) }
    if brain == "dummy" { return self.position + vec3(0, 1.0, 0) }
    if brain == "stalebie" { return self.position + vec3(0, 1.1, 0) }
    if brain == "roller" { return self.position + vec3(0, 0.7, 0) }
    return self.position + vec3(0, 0.35, 0)
}

func fwd() -> vec3 { return vec3(-sin(yaw), 0, -cos(yaw)) }

func face(p: vec3, rate: number, dt: number) -> void {
    var to: vec3 = p - self.position
    to.y = 0
    if length(to) < 0.01 { return }
    var want: number = atan2(-to.x, -to.z)
    var d: number = ((want - yaw + 540) % 360) - 180
    yaw += clamp(d, -rate * dt, rate * dt)
}

func hit(amount: int, how: string, from: vec3) -> void {
    if dead { return }
    if brain == "scrub" {
        if st == "hidden" and how != "nut" { return }
        if how == "nut" or trio {
            beaten()
            return
        }
    }
    if brain == "roller" and how != "bomb" {
        play_sound("sfx/block.wav", 0.6)
        return
    }
    if brain == "dummy" {
        wobble = 1
        play_sound("sfx/thunk.wav", 0.6)
        return
    }
    if how == "boomerang" and brain != "jelly" {
        stun = 3                             # the boomerang stuns; it doesn't hurt
        flash = 0.2
        play_sound("sfx/hit.wav", 0.5, 1.4)
        return
    }
    if brain == "jelly" and (how == "boomerang" or how == "pea") {
        stun = 3                             # stunned, it stops crackling
        flash = 0.2
        play_sound("sfx/hit.wav", 0.5, 1.4)
        return
    }
    if brain == "jelly" and stun <= 0 and how != "bomb" {
        sprig.hurt(2, self.position, "unblockable")     # (striking it charged: a shock)
        play_sound("sfx/zap.wav", 0.7)
        return
    }
    if stun <= 0 and how == "pea" and brain == "fuzzball" {
        stun = 2.5                           # a pea stuns; it doesn't hurt much
    }
    hp -= amount
    flash = 0.25
    var away: vec3 = self.position - from
    away.y = 0
    if length(away) > 0.01 { vel = normalize(away) * 5 + vec3(0, 2.5, 0) }
    st = "hurt"
    st_t = 0
    play_sound("sfx/hit.wav", 0.7, 0.9 + random() * 0.2)
    play_animation(self, "hurt", 1, false)
    if hp <= 0 { die() }
}

func die() -> void {
    dead = true
    add_tag(self, "hidden")
    remove_tag(self, "focusable")
    spawn("prefabs/poof.scene", self.position + vec3(0, 0.4, 0))
    play_sound("sfx/defeat.wav", 0.7)
    game.roll_drop(self.position, 0.7)
    if group != "" {
        var left: int = 0
        for e in find_tagged("grp_" + group) {
            if e != self and e.alive and not has_tag(e, "hidden") { left += 1 }
        }
        if left == 0 { game.set_flag("clear:" + group) }
    }
    destroy(self)
}

# A scrub hit by its own nut (or, for the brothers, by anything): it gives up.
func beaten() -> void {
    play_sound("sfx/hit.wav", 0.7)
    flash = 0.4
    if trio {
        st = "hidden"
        struck = true
        popped = false
        play_animation(self, "hide", 1, true)
        broadcast("scrub_struck", order)
        return
    }
    dead = true
    add_tag(self, "hidden")
    remove_tag(self, "focusable")
    game.talk("scrub_beaten", "")
    spawn("prefabs/poof.scene", self.position + vec3(0, 0.4, 0))
    game.roll_drop(self.position, 1)
    destroy(self)
}

# (the brothers' puzzle wants them all back up after a wrong order)
func trio_reset() -> void {
    struck = false
    st_t = 0
}

func update(dt: number) -> void {
    if dead or game.state != "play" { return }
    st_t += dt
    flash = max(0, flash - dt)
    stun = max(0, stun - dt)
    var to: vec3 = sprig.position - self.position
    to.y = 0
    var d: number = length(to)
    var move := vec3(0, 0, 0)
    if brain == "dummy" {
        wobble = max(0, wobble - dt * 2)
        self.rotation = vec3(sin(st_t * 1500) * 12 * wobble, yaw, 0)
        return
    }
    if st == "hurt" {
        move = vec3(vel.x, 0, vel.z)
        vel = vel * max(0, 1 - dt * 5)
        if st_t > 0.35 { st = "idle" }
    } elif stun > 0 {
        play_animation(self, "hurt", 0.3, true)
    } elif brain == "fuzzball" {
        move = fuzzball(dt, to, d)
    } elif brain == "larva" {
        if d < 9 {
            face(sprig.position, 240, dt)
            move = fwd() * 1.6
            play_animation(self, "walk", 1, true)
        } else {
            play_animation(self, "idle", 1, true)
        }
    } elif brain == "scrub" {
        scrub(dt, to, d)
    } elif brain == "stalebie" {
        move = stalebie(dt, to, d)
    } elif brain == "crustling" {
        move = fuzzball(dt, to, d) * 0.8
    } elif brain == "roller" {
        move = roller(dt, to, d)
    } elif brain == "jelly" {
        move = jelly(dt, to, d)
    }
    if brain == "stalebie" and (st == "under" or st == "rising" or st == "sinking") {
        self.rotation = vec3(0, yaw, 0)
        return
    }
    if brain != "scrub" {
        if length(move) > 0.1 and st != "hurt" and not ground_ahead(move) { move = vec3(0, 0, 0) }   # (no walking off ledges)
        vel.y -= 20 * dt
        var v := vec3(move.x, vel.y, move.z)
        v = move_and_slide(self, v)
        vel.y = v.y
        if is_on_floor(self) and vel.y < 0 { vel.y = -1 }
        if self.y < game.kill_y { die() }
    }
    self.rotation = vec3(0, yaw, 0)
    if flash > 0 and floor(flash * 30) % 2 == 0 {
        self.Mesh.color = "#ff8080ff"
    } elif brain == "jelly" and stun <= 0 and floor(st_t * 10) % 3 == 0 {
        self.Mesh.color = "#ffff80ff"
    } else {
        self.Mesh.color = "#ffffffff"
    }
    # touching Sprig hurts him (not while stunned, or for a scrub)
    if brain != "scrub" and brain != "stalebie" and stun <= 0 and st != "hurt" and d < 0.75 and abs(sprig.y - self.y) < 1.2 {
        var r: string = sprig.hurt(damage, self.position, "touch")
        if r == "blocked" or r == "hit" {
            vel = normalize(to) * -4 + vec3(0, 2, 0)
            st = "hurt"
            st_t = 0.1
        }
    }
}

func ground_ahead(move: vec3) -> bool {
    var from: vec3 = self.position + normalize(move) * 0.6 + vec3(0, 0.3, 0)
    var hit: any = raycast(from, from + vec3(0, -1.4, 0), self)
    return hit != nil
}

func is_night() -> bool {
    if always { return true }
    var c: number = global("clock", 0.3)
    return c < 0.22 or c > 0.8
}

func go_under() -> void {
    st = "under"
    self.position = vec3(home.x, home.y - 1.8, home.z)
    add_tag(self, "hidden")
}

func stalebie(dt: number, to: vec3, d: number) -> vec3 {
    if st == "under" {
        if is_night() and d < 11 and st_t > 2 {
            st = "rising"
            st_t = 0
            self.position = vec3(self.x, home.y - 1.8, self.z)
            play_sound("sfx/rumble.wav", 0.5, 1.5)
        }
        return vec3(0, 0, 0)
    }
    if st == "rising" {
        self.y = lerp(home.y - 1.8, home.y, min(1, st_t / 1.2))
        face(sprig.position, 200, dt)
        play_animation(self, "hold", 1, true)
        if st_t >= 1.2 {
            st = "idle"
            st_t = 0
            remove_tag(self, "hidden")
        }
        return vec3(0, 0, 0)
    }
    if st == "sinking" {
        self.y = lerp(home.y, home.y - 1.8, min(1, st_t / 1.2))
        if st_t >= 1.2 {
            home = vec3(self.x, home.y, self.z)
            go_under()
            st_t = 0
        }
        return vec3(0, 0, 0)
    }
    if not is_night() or d > 16 {
        st = "sinking"
        st_t = 0
        add_tag(self, "hidden")
        return vec3(0, 0, 0)
    }
    if st == "swipe" {
        play_animation(self, "slash", 0.7, false)
        if st_t > 0.3 and st_t - dt <= 0.3 and d < 1.7 { sprig.hurt(damage, self.position, "touch") }
        if st_t > 0.9 {
            st = "idle"
            st_t = 0
        }
        return vec3(0, 0, 0)
    }
    face(sprig.position, 160, dt)
    if d < 1.4 and st_t > 0.4 {
        st = "swipe"
        st_t = 0
        play_sound("sfx/swing.wav", 0.6, 0.6)
        return vec3(0, 0, 0)
    }
    play_animation(self, "walk", 0.8, true)
    return fwd() * 1.5
}

# A rolling Hardtack: curls up and rolls straight at Sprig, bouncing off walls. Swords
# just bounce off it; a bomb knocks it out.
var roll_dir: vec3
func roller(dt: number, to: vec3, d: number) -> vec3 {
    if st == "idle" {
        play_animation(self, "idle", 1, true)
        if d < 9 and st_t > 1.0 {
            st = "roll"
            st_t = 0
            roll_dir = normalize(to)
            play_sound("sfx/roll.wav", 0.7, 0.6)
        }
        return vec3(0, 0, 0)
    }
    if st == "roll" {
        play_animation(self, "roll", 1, true)
        yaw += 720 * dt
        if is_on_wall(self) and st_t > 0.2 {
            roll_dir = roll_dir * -1
            shake_camera(1, 0.1)
        }
        if st_t > 3.0 {
            st = "idle"
            st_t = 0
        }
        return roll_dir * 5.5
    }
    return vec3(0, 0, 0)
}

# A shock jelly: drifts after Sprig, crackling. A blade on it gives him a shock - stun it
# with the boomerang first, then it's soft.
func jelly(dt: number, to: vec3, d: number) -> vec3 {
    face(sprig.position, 120, dt)
    play_animation(self, "hop", 0.6, true)
    if d < 8 { return fwd() * 1.1 }
    return vec3(0, 0, 0)
}

func fuzzball(dt: number, to: vec3, d: number) -> vec3 {
    if st == "idle" or st == "wander" {
        if d < 7 {
            st = "chase"
            st_t = 0
        } else {
            if distance(self.position, wander_to) < 0.5 or st_t > 4 {
                wander_to = home + vec3(random(-2.5, 2.5), 0, random(-2.5, 2.5))
                st_t = 0
            }
            face(wander_to, 180, dt)
            play_animation(self, "hop", 1, true)
            return fwd() * 0.9
        }
    }
    if st == "chase" {
        face(sprig.position, 300, dt)
        play_animation(self, "hop", 1.4, true)
        if d > 10 { st = "wander" }
        if d < 2.6 and st_t > 0.8 {
            st = "windup"
            st_t = 0
        }
        return fwd() * 1.8
    }
    if st == "windup" {
        face(sprig.position, 400, dt)
        play_animation(self, "idle", 3, true)
        if st_t > 0.45 {
            st = "lunge"
            st_t = 0
            vel.y = 3.5
            play_animation(self, "lunge", 1, false)
            play_sound("sfx/lunge.wav", 0.5)
        }
        return vec3(0, 0, 0)
    }
    if st == "lunge" {
        if st_t > 0.5 {
            st = "chase"
            st_t = 0
        }
        return fwd() * 6.5
    }
    return vec3(0, 0, 0)
}

# (the brothers take turns: only the one nearest Sprig comes up)
func nearest_brother() -> bool {
    var mine: number = distance(self.position, sprig.position)
    for e in find_tagged("trio") {
        if e.struck { continue }
        var theirs: number = distance(e.position, sprig.position)
        if e != self and e.alive and (theirs < mine - 0.05 or (abs(theirs - mine) <= 0.05 and e.order < order)) { return false }
    }
    return true
}

func scrub(dt: number, to: vec3, d: number) -> void {
    face(sprig.position, 360, dt)
    if st == "hidden" {
        var reach: number = 9
        if trio { reach = 4.8 }                       # (the brothers wait till he comes close)
        if d < reach and d > 2.4 and st_t > 1.2 and not struck and (not trio or nearest_brother()) {
            st = "up"
            st_t = 0
            popped = true
            play_animation(self, "idle", 1, true)
            play_sound("sfx/pop.wav", 0.5)
            spit_t = 0.9
        }
    } elif st == "up" {
        spit_t -= dt
        if spit_t <= 0 {
            spit_t = 2.2
            play_animation(self, "spit", 1, false)
            var n: entity = spawn("prefabs/nut.scene", self.position + vec3(0, 0.45, 0) + fwd() * 0.45)
            n.dir = normalize(sprig.position + vec3(0, 0.5, 0) - (self.position + vec3(0, 0.45, 0)))
            n.owner = self
            play_sound("sfx/spit.wav", 0.6)
        }
        if d < 2.0 or d > 11 or (trio and (d > 5.5 or not nearest_brother())) {
            st = "hidden"
            st_t = 0
            popped = false
            play_animation(self, "hide", 1, true)
        }
    }
    if st == "hidden" { add_tag(self, "hidden") } else { remove_tag(self, "hidden") }
}
